@METHOD@
int main() {
    // Exercise thresholds, queue capacities, building shortcuts, aliasing and float edge cases
    const float powers[]={0.0f,0.009999f,0.01f,0.010001f,-1.0f,NAN,INFINITY};
    const float speeds[]={0.0f,0.001599f,0.0016f,0.001601f,-1.0f,NAN,INFINITY};
    const float coordinates[]={0.0f,-0.0f,59.999f,60.0f,60.001f,-60.0f,300.0f,FLT_MAX,NAN,INFINITY};
    for(unsigned seed=0;seed<8192;++seed) {
        seedValue=seed;active=(seed&1)?&other:&AudioManager;memset(active,0,sizeof(*active));
        AudioCollisionManager_Init(&active->m_sCollisionManager);
        active->m_bIsInitialised=seed%11!=0;active->m_bIsPaused=seed%13==0;
        active->m_nCollisionEntity=seed%17==0?-1:5;
        for(unsigned i=0;i<seed%14;++i) {
            auto &q=active->m_sCollisionManager.m_sQueue;q.m_pEntity1=&entities[0];q.m_pEntity2=&entities[1];
            q.m_nBaseVolume=7;q.m_fDistance=(float)((i*37+seed)%3600);
            AudioCollisionManager_AddCollisionToRequestedQueue(&active->m_sCollisionManager);
        }
        for(unsigned i=0;i<2;++i) {
            entities[i].id=i;entities[i].building=(seed>>(i+1))&1;
            entities[i].position=CVector(coordinates[(seed/8+i)%10],coordinates[(seed/80+i*3)%10],coordinates[(seed/800+i*5)%10]);
        }
        CEntity *a=&entities[0],*b=&entities[(seed>>3)&1];
        float power=powers[(seed/7)%7],speed=speeds[seed%7];
        if(!active->m_bIsInitialised || active->m_bIsPaused || active->m_nCollisionEntity<0 || (speed<0.0016f && power<0.01f)) a=b=NULL;
        @CALL@
        observe();++cases;
    }
    // Require all game query boundaries to be exercised
    if(!buildings || !positions || !cameras) return 2;
    printf("%u cases %u callbacks %llu\n",cases,callbacks,(unsigned long long)digest);
}
