static inline RwMatrix *RwFrameGetMatrix(RwFrame *frame)
{
    // Borrow the actual fixture SDK matrix at the original primitive boundary
    return &frame->matrix;
}
static inline RwV3d *RwMatrixGetPos(RwMatrix *matrix)
{
    // Return the live SDK position rather than a copied vector view
    return &matrix->pos;
}
static inline void RwMatrixSetIdentity(RwMatrix *matrix)
{
    // Preserve the SDK identity primitive while keeping unrelated padding initialized
    matrix->right={1,0,0};matrix->up={0,1,0};matrix->at={0,0,1};matrix->pos={0,0,0};matrix->flags=1;
}
static inline void RwMatrixUpdate(RwMatrix *matrix)
{
    // Observe the final SDK matrix update without performing frame policy
    matrix->flags+=16;
}
