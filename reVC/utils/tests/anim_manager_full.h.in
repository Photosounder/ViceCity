enum {rpCLUMP=2,STREAM_OFFSET_ANIM=1000};
struct RwObject {unsigned type;};
struct CBaseModelInfo {
    char name[32];RwObject *object;RpClump *instance;
    const char *GetModelName(){
        // Borrow fixture metadata through the original native model primitive
        return name;
    }
    RwObject *GetRwObject(){
        // Borrow fixture SDK object metadata without group selection logic
        return object;
    }
    RwObject *CreateInstance();
};
class CModelInfo {public:static CBaseModelInfo *GetModelInfo(int32);};
class CStreaming {public:static void RemoveModel(int32);static void RemoveAnim(int32 id){
    // Retain the original inline animation-to-streaming offset operation
    RemoveModel(id+STREAM_OFFSET_ANIM);
}};
