    return {p->x,p->y,p->z};
}
static void AudioGeometry_TranslateVector(const CVector *p,CVector *out) {
    // Drive the existing C transform through the original scalar copy adapter
    AudioSoundPosition plain={p->x,p->y,p->z},result;
    AudioGeometry_Translate(&plain,&result);
