static void value(uint32_t v) {
    // Hash scalar observations in backend callback order
    digest=(digest^v)*1099511628211ULL;
}
static void observe(void) {
    // Observe all zero-padded owner and controlled backend bytes at every boundary
    const unsigned char *bytes=(const unsigned char *)active;
    for(unsigned i=0;i<sizeof(*active);++i) value(bytes[i]);
    bytes=(const unsigned char *)channels;
    for(unsigned i=0;i<sizeof(channels);++i) value(bytes[i]);
}
static void event(unsigned token) {
    // Retain observable callback ordering before backend state changes
    ++callbacks;value(token);observe();
}
static Channel &channel(unsigned token,cSampleManager *manager,uint32_t id) {
    // Validate each actual backend argument and observe the selected channel
    assert(id<NUM_CHANNELS);value(manager==&SampleManager);value(id);event(token);
    return channels[id];
}
static void floating(float v) {
    // Observe exact scalar argument bits without changing their precision
    uint32_t bits;memcpy(&bits,&v,sizeof(bits));value(bits);
}
