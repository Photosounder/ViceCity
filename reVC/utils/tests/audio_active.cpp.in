static void prepare(unsigned seed) {
    // Seed bounded records, both queues, rotated channels and every startup eligibility gate
    seedValue=seed;active=&owners[seed&1];memset(active,0,sizeof(*active));memset(channels,0,sizeof(channels));
    active->m_nActiveSamples=seed%4==0?1:seed%4==1?2:seed%4==2?4:8;
    active->m_nActiveQueue=(seed>>1)&1;
    active->m_nRequestedCount[active->m_nActiveQueue]=seed%(active->m_nActiveSamples+1);
    active->m_nChannelOffset=(seed>>2)%active->m_nActiveSamples;
    active->m_nTimeSpent=40;active->m_fSpeedOfSound=343.0f/40;
    active->m_FrameCounter=seed;active->m_bIsPaused=(seed>>3)&1;
    active->m_bDoubleVolume=(seed>>4)&1;
    const uint8_t multipliers[]={0,63,127,200};active->m_nGlobalSfxVolumeMultiplier=multipliers[(seed>>5)%4];
    active->m_bIsMissionAudioPhoneCall[0]=(seed>>6)&1;
    active->m_bIsMissionAudioPhoneCall[1]=(seed>>7)&1;
    for(unsigned i=0;i<active->m_nActiveSamples;++i) {
        active->m_aRequestedOrderList[active->m_nActiveQueue][i]=active->m_nActiveSamples-1-i;
        tSound &requested=active->m_aRequestedQueue[active->m_nActiveQueue][i];
        requested.m_nEntityIndex=i+1;requested.m_nCounter=10+i;
        requested.m_nSampleIndex=(seed+i)%13==0?NO_SAMPLE:1+i;
        requested.m_bIs2D=(seed+i)&1;requested.m_bStatic=(seed+i)%4==0;
        requested.m_nLoopCount=(seed+i)%3;
        const uint32_t frequencies[]={0,39,100,10000,22050,48000};requested.m_nFrequency=frequencies[(seed+i)%6];
        requested.m_nVolume=(seed+i*17)%128;requested.m_fDistance=20.0f+i*5;
        requested.m_fSpeedMultiplier=(seed+i)%3==0?0.0f:1.0f;
        requested.m_MaxDistance=100;requested.m_vecPos={(float)i-3,(float)i+2,(float)i-1};
        requested.m_nPan=(seed+i)%128;
        requested.m_bIsPlayingFinished=(seed+i)%11==0;requested.m_bIsBeingPlayed=1;
        requested.m_nFramesToPlay=(seed+i)%3;requested.m_nVolumeChange=3;
#ifndef GTA_PS2
        requested.m_nLoopStart=123+i;requested.m_nLoopEnd=-1;
#endif
#ifdef EXTERNAL_3D_SOUND
        requested.m_nEmittingVolume=(seed+i*13)%128;
#endif
#if !defined(GTA_PS2) || defined(AUDIO_REVERB)
        requested.m_bReverb=(seed+i)%3;
#endif
#ifdef AUDIO_REFLECTIONS
        if((seed+i)%5==0) requested.m_nCounter=300+i;
        requested.m_nReflectionDelay=(seed+i)%3;
#endif
        active->m_asAudioEntities[i+1].m_bIsUsed=(seed+i)%5!=0;
        tSound &playing=active->m_asActiveSamples[i];playing=requested;
        playing.m_nFrequency=16000+i*1000;playing.m_fDistance=25.0f+i*3;
        playing.m_nVolume=(seed+i*7)%128;
#ifdef EXTERNAL_3D_SOUND
        playing.m_nEmittingVolume=(seed+i*11)%128;
#endif
        if((seed+i)%3==0) playing.m_nSampleIndex=NO_SAMPLE;
        else if((seed+i)%3==1) playing.m_nCounter+=1000;
        channels[i].used=(seed+i)%3==0?0:(seed+i)%3==1?1:255;
        channels[i].frequency=12345;channels[i].volume=63;
    }
}
int main(void) {
    // Compare direct calls, repeated channel processing and the actual C declaration
    for(unsigned seed=0;seed<512;++seed) {
        prepare(seed);@PROCESS@;observe();++cases;
        @PROCESS@;observe();++cases;
        prepare(seed);@CALLER@;observe();++cases;
    }
    printf("%u cases %u callbacks : %llu\n",cases,callbacks,(unsigned long long)digest);
    return 0;
}
