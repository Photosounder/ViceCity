@METHODS@
static void prepare(unsigned seed,unsigned kind) {
    // Exercise every pattern position, timer caps and all siren index exceptions
    seedValue=seed;active=&owners[seed&1];memset(active,0,sizeof(*active));memset(&params,0,sizeof(params));memset(vehicles,0,sizeof(vehicles));memset(aVehicleSettings,0,sizeof(aVehicleSettings));
    const int32_t statuses[]={STATUS_PLAYER,STATUS_SIMPLE,STATUS_ABANDONED,STATUS_WRECKED};const int32_t alarms[]={0,1,-1,-2};
    for(unsigned i=0;i<2;++i){CVehicle &v=vehicles[i];v.model=(seed/3+i)%3==0?MI_MRWHOOP:MI_LANDSTAL;v.status=statuses[(seed/5+i)%4];v.alarmState=alarms[(seed/7+i)%4];v.m_nCarHornTimer=1+(seed+i*17)%44;v.m_nCarHornPattern={uint32_t((seed/44+i)%8),16};v.m_bSirenOrAlarm={uint32_t((seed/11+i)%2),17};v.bIsDrowning={uint32_t((seed/13+i)%2),18};v.uses=(seed/17+i)%2;if(seed%19==0)v.m_nCarHornTimer=0;if(seed%23==0)v.m_nCarHornTimer=45;if(seed%29==0)v.m_nCarHornTimer=0xFFFFFFFF;}
    for(unsigned i=0;i<MAX_CARS;++i){aVehicleSettings[i].m_nHornSample={SFX_CAR_HORN_JEEP+(int32_t)(i%3),70};aVehicleSettings[i].m_nHornFrequency={10000+(int32_t)i*100,71};aVehicleSettings[i].m_nSirenOrAlarmSample={(uint32_t)SFX_POLICE_SIREN_SLOW,72};aVehicleSettings[i].m_nSirenOrAlarmFrequency={12000+(int32_t)i*50,73};}
    const uint32_t indices[]={FIRETRUK,MRWHOOP,FBIRANCH,VICECHEE,LANDSTAL,POLICE};const float distances[]={-1.0f,0.0f,100.0f,1599.0f,1600.0f,1601.0f,12099.0f,12100.0f,12101.0f,NAN,INFINITY};
    params.m_pVehicle=&vehicles[0];params.m_nIndex=indices[(seed/31)%6];params.m_fDistance=distances[(seed/37)%11];params.m_bDistanceCalculated=(seed/41)%3;active->m_sQueueSample.m_fDistance=(seed/43)%(kind==0?41:111);active->m_sQueueSample.m_vecPos={1,2,3};active->m_sQueueSample.m_nEntityIndex=(int32_t)(seed%31)-15;active->m_sQueueSample.m_nSampleIndex=999;active->m_sQueueSample.m_nFrequency=12345;active->m_sQueueSample.m_nCounter=777;active->m_FrameCounter=seed;active->m_nActiveSamples=8;
    currentTime=seed%47==0?0xFFFFFF00:seed%53==0?0:seed%10000;
    if(!(params.m_fDistance<(kind==0?1600.0f:12100.0f)))params.m_pVehicle=NULL;
}
int main() {
#ifdef _WIN32
    // Keep sanitizer failures quiet
    SetErrorMode(3);
#endif
    // Compare both complete generators with repeated calls and alternating owners
    for(unsigned seed=0;seed<4096;++seed)for(unsigned kind=0;kind<2;++kind){prepare(seed,kind);for(unsigned call=0;call<2;++call){value(@RUN@);observe();++cases;}}
    // Require pattern emission, siren table selection, clock updates and fast-siren backend queries
    if(!hornSamples||!sirenSamples||!clockReads||!fastSamples||!usesReads)return 2;
#ifndef GTA_PS2
    if(!offsetReads)return 3;
#endif
    printf("%u cases %u callbacks %llu\n",cases,callbacks,(unsigned long long)digest);
}
