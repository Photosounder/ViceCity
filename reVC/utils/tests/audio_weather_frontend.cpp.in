    for(unsigned e=0;e<2;++e){tAudioEntity *entity=&active->m_asAudioEntities[e?otherId:currentId];entity->m_AudioEvents=(variantValue+e)%5;for(unsigned i=0;i<NUM_AUDIOENTITY_EVENTS;++i){entity->m_awAudioEvent[i]=(int16_t)((seed+i*17+e*31)%256);entity->m_afVolume[i]=volumes[(variantValue+i)%8];}entity->m_awAudioEvent[1]=SOUND_PICKUP_WEAPON;entity->m_awAudioEvent[2]=SOUND_PART_MISSION_COMPLETE;}
    if(variantValue%3==0)active->m_asAudioEntities[currentId].m_awAudioEvent[0]=SOUND_LIGHTNING;
    // Seed rain short-circuit combinations and defined weather volume boundaries
    static const float rains[]={-1,0,0.001f,0.5f,1,2,10.2f,NAN};static const float winds[]={0,0.1f,1,1.25f,1.5f,2,NAN};static const float trees[]={0,40,74.999f,75,75.001f,999999.9f,NAN};static const float ceilings[]={0,19.999f,20,20.001f,NAN};
    CWeather::Rain.tag=1;CWeather::Rain.v=rains[variantValue%8];CWeather::Wind.tag=4;CWeather::Wind.v=winds[variantValue%7];CObject::fDistToNearestTree.tag=5;CObject::fDistToNearestTree.v=trees[variantValue%7];TheCamera.SoundDistUp.tag=6;TheCamera.SoundDistUp.v=ceilings[variantValue%5];TheCamera.position.x=(float)variantValue;
    cameraNoRain=variantValue&1;playerNoRain=(variantValue>>1)&1;modifierX=(variantValue%4==0)?NAN:(variantValue%4-1.5f)*0.1f;modifierY=(variantValue%3-1.0f)*0.1f;
}
int main() {
