    for(unsigned seed=0;seed<8192;++seed){prepare(seed);++soundVisits[seed%256];@RUN@;observe();++cases;@RUN@;observe();++cases;prepare(seed);mutations=0;@RUN@;observe();++cases;}
    // Require every sound byte, shared-counter wrap, both rain-zone results and real tree resets
