    variantValue=seed/256;mutations=1;currentId=(seed>>1)%NUM_AUDIOENTITIES;otherId=(currentId+1)%NUM_AUDIOENTITIES;memset(owners,0,sizeof(owners));memset(&TheCamera,0,sizeof(TheCamera));memset(&CWeather::Rain,0,sizeof(CWeather::Rain));memset(&CWeather::Wind,0,sizeof(CWeather::Wind));memset(&CObject::fDistToNearestTree,0,sizeof(CObject::fDistToNearestTree));active=&owners[variantValue&1];
    active->m_nActiveSamples=6;active->m_nActiveQueue=(seed>>1)&1;active->m_nRequestedCount[active->m_nActiveQueue]=seed%7;
    for(unsigned i=0;i<6;++i){active->m_aRequestedOrderList[active->m_nActiveQueue][i]=i;active->m_aRequestedQueue[active->m_nActiveQueue][i].m_nFinalPriority=100+i*900;}
