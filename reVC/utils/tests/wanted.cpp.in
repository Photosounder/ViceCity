    ++checks;if(!value){fprintf(stderr,"Wanted check failed at %llu state %llu mode %u\n",(unsigned long long)checks,(unsigned long long)states,mode);abort();}
}
static int CopId(CCopPed *value)
{
    // Preserve canonical pursuit-slot identities across native callbacks and stable compaction
    if(!value)return 0;for(int i=0;i<10;i++)if(value==&cops[i])return i+1;Check(false);return 999;
}
