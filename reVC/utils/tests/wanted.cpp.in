}
void Observe(unsigned point,int identity)
{
    // Observe lazy reads and writes before exercising a selected original statement boundary
    ++observations;Number(point);Number(identity);if(!armed||triggered)return;
    if(mode==1&&point==10){triggered=true;state.m_fCrimeSensitivity=2.75f;nativePosition.x=81;state.m_aCrimes[0].m_vecPosn.x=91;}
    else if(mode==2&&point==11){triggered=true;state.m_nMinChaos=71;state.m_nWantedLevel=4;}
    else if(mode==3&&point==20){triggered=true;nativePosition=CVector(61,62,63);state.m_aCrimes[0].m_vecPosn=Position(71,72,73);}
    else if(mode==4&&point==21){triggered=true;AudioManager.m_FrameCounter=19;for(unsigned i=0;i<NUM_CRIME_TYPES;i++)gMinTimeToNextReport[i]=20;}
    else if(mode==5&&point==22){triggered=true;state.m_nChaos=1300;state.m_nWantedLevel=2;}
    else if(mode==6&&point==30){triggered=true;state.m_pCops[0]=&cops[9];state.m_CurrentCops=8;}
    else if(mode==7&&point==31){triggered=true;state.m_pCops[0]=NULL;state.m_pCops[8]=&cops[8];state.m_CurrentCops=9;}
    else if(mode==8&&point==11){triggered=true;drop=200;}
    else if(mode==9&&point==40){triggered=true;pedFlags[11]=POOLFLAG_ISFREE;peds[10].model.value=0;}
    else if(mode==10&&point==54){triggered=true;vehicles[identity-200].status.value=STATUS_WRECKED;}
    else if(mode==11&&point==20){triggered=true;AudioManager.m_bIsInitialised=false;}
    else if(mode==12&&point==60){triggered=true;state.m_nMinChaos=90;}
}
