#include "owners.h"
#include <inttypes.h>
static uint64_t digest=UINT64_C(1469598103934665603),checks,states,observations;
static uint32_t now;static float listen[NUM_RADIOS];static bool japanese,mp3;static unsigned mode;static bool armed,triggered;static unsigned assertions;
struct Translation {char key[48];uint16_t value[64];};static Translation translations[256];static unsigned translationCount;
CPlayerInfo CWorld::Players[2];uint8 CWorld::PlayerInFocus;bool CPad::bHasPlayerCheated,CGame::nastyGame;CMenuManager FrontEndMenuManager;
char gString2[512];uint16_t gUString[256],gUString2[256];
extern "C" {CText TheText;float MusicSavedData_FavoriteRadioStationList[NUM_RADIOS];}
static void Number(uint64_t value)
{
    // Compare ordered observations without recording process-specific addresses
    for(unsigned i=0;i<8;i++){digest^=(uint8_t)value;digest*=UINT64_C(1099511628211);value>>=8;}
}
static void Floating(float value)
{
    // Preserve exact canonical float representations including signed zero
    uint32_t bits;memcpy(&bits,&value,4);Number(bits);
}
static void Check(bool value)
{
    // Stop a quiet comparison at its first independent invariant failure
    ++checks;if(!value){fprintf(stderr,"Stats check failed at %llu state %llu mode %u\n",(unsigned long long)checks,(unsigned long long)states,mode);abort();}
}
static void Bytes(const void *data,size_t length)
{
    // Compare complete initialized save payloads, guards and shared scratch storage
    const uint8_t *p=(const uint8_t*)data;Number(length);for(size_t i=0;i<length;i++){digest^=p[i];digest*=UINT64_C(1099511628211);}
}
static void TextBytes(const uint16_t *value)
{
    // Observe complete visible UTF-16 output without depending on untranslated pointer addresses
    for(unsigned i=0;;i++){Check(i<256);Number(value[i]);if(!value[i])break;}
}
static void Observe(unsigned point)
{
    // Preserve effectful provider order and mutate only at real external formatting/audio boundaries
    ++observations;Number(point);if(!armed||triggered)return;
    if(mode==1&&point==10){triggered=true;GLOBAL(DaysPassed)=999;GLOBAL(CarsExploded)=888;}
    else if(mode==2&&point==20){triggered=true;GLOBAL(CarsExploded)=777;CWorld::PlayerInFocus=1;}
    else if(mode==3&&point==30){triggered=true;GLOBAL(NumPropertyOwned)=0;GLOBAL(HighestChaseValue)=1800;}
}
extern "C" const uint32_t *Timer_GetTimeInMilliseconds()
{
    // Return the same live clock alias for both time rows and the persistent police-spending cache
    return &now;
}
extern "C" float *DMAudio_GetListenTimeArray()
{
    // Observe the single live listen-array capture at its original init/save point
    Observe(10);return listen;
}
extern "C" uint8_t DMAudio_IsMP3RadioChannelAvailable()
{
    // Preserve repeated radio-availability queries during the complete least-listened scan
    Observe(11);return mp3?1:0;
}
bool CFont::IsJapanese()
{
    // Retain the original pure native language query without changing its scalar type
    return japanese;
}
void CFont::FilterOutTokensFromString(uint16_t *text)
{
    // Observe the native filter boundary and apply a deterministic token removal to the same shared buffer
    Observe(30);if(text[0]=='~'&&text[1]=='x'&&text[2]=='~'){unsigned i=0;do{text[i]=text[i+3];}while(text[i++]);}
}
void UnicodeStrcpy(uint16_t *target,const uint16_t *source)
{
    // Use the complete original primitive loop and preserve destination aliasing
    while((*target++=*source++)!='\0');
}
void AsciiToUnicode(const char *source,uint16_t *target)
{
    // Use the complete original unsigned-byte conversion loop on shared scratch storage
    while((*target++=(unsigned char)*source++)!='\0');
}
extern "C" char *UnicodeToAscii(uint16_t *source)
{
    // Supply the same stable C text dependency for the inline out-of formatting token
    static char converted[256];unsigned i=0;do{Check(i<255);converted[i]=(char)source[i];}while(source[i++]);return converted;
}
extern "C" uint16_t *Text_Get(CText *text,const char *key)
{
    // Preserve translation key, stable result identity and callbacks before later string copies
    Check(text==&TheText);Observe(20);for(const char *p=key;*p;p++)Number((unsigned char)*p);Number(0);
    for(unsigned i=0;i<translationCount;i++)if(strcmp(translations[i].key,key)==0)return translations[i].value;
    Check(translationCount<256&&strlen(key)<48);Translation &entry=translations[translationCount++];strcpy(entry.key,key);entry.value[0]='~';entry.value[1]='x';entry.value[2]='~';unsigned i=0;do{entry.value[i+3]=(unsigned char)key[i];}while(key[i++]);return entry.value;
}
extern "C" void TestStats_Assert(const char*)
{
    // Observe a failed original contract check without creating a native dialog
    ++assertions;Observe(40);
}
extern "C" void re3_assert(const char *expression,const char*,unsigned int,const char*)
{
    // Preserve contract failures while allowing source filename and function names to reflect the C conversion
    TestStats_Assert(expression);
}
#include "observations.h"
#include "expected-save.h"
static void Reset(int seed=1)
{
    // Seed every named value and buffer while retaining the original function-static row-cache lifetime
    armed=false;triggered=false;mode=0;assertions=0;SeedCanonical(seed);now=1234567+(uint32_t)seed*123;CWorld::PlayerInFocus=0;CPad::bHasPlayerCheated=false;CGame::nastyGame=true;FrontEndMenuManager.m_PrefsLanguage=TEXT_LANGUAGE_AMERICAN;japanese=false;mp3=true;
    CWorld::Players[0].m_nMoney=50000;CWorld::Players[0].m_nVisibleMoney=10000001;CWorld::Players[0].m_nCollectedPackages=17;CWorld::Players[0].m_nTotalPackages=100;
    CWorld::Players[1].m_nMoney=75000;CWorld::Players[1].m_nVisibleMoney=5;CWorld::Players[1].m_nCollectedPackages=9;CWorld::Players[1].m_nTotalPackages=0;
    for(unsigned i=0;i<NUM_RADIOS;i++){listen[i]=(float)(i+seed)*1.25f;MusicSavedData_FavoriteRadioStationList[i]=(float)(NUM_RADIOS-i);}
    memset(gString2,0x31,sizeof(gString2));for(unsigned i=0;i<256;i++){gUString[i]=0x7777;gUString2[i]=0x6666;}
}
static void Snapshot()
{
    // Observe all 91 canonical objects, external mutations, shared buffers and radio values after each operation
    ++states;Number(states);CanonicalSnapshot();Bytes(gString2,sizeof(gString2));Bytes(gUString,sizeof(gUString));Bytes(gUString2,sizeof(gUString2));
    for(unsigned i=0;i<NUM_RADIOS;i++)Floating(MusicSavedData_FavoriteRadioStationList[i]);Number(CWorld::PlayerInFocus);Number(triggered);Number(assertions);
    // Emit compact optional checkpoints for diagnosing whole-operation divergences
    if(getenv("STATS_TRACE"))fprintf(stderr,"%llu %llu %016llx\n",(unsigned long long)states,(unsigned long long)observations,(unsigned long long)digest);
}
static const char *KeyOf(uint16_t *value)
{
    // Validate that rating and chase operations return the original stable translated object
    for(unsigned i=0;i<translationCount;i++)if(value==translations[i].value)return translations[i].key;Check(false);return "";
}
static void MutationCases()
{
    // Exercise complete initialization, every counter updater and all indexed min/max alternatives
    Reset();Run_Stats_Init();Snapshot();
    const int values[]={-1,0,1,59,60,100,999,3600};
    for(unsigned n=0;n<8;n++){
        Reset((int)n);for(int i=0;i<COUNT(TOTAL_FASTEST_TIMES);i++){Run_Stats_RegisterFastestTime(i,values[n]);Run_Stats_RegisterFastestTime(i,values[7-n]);}for(int i=0;i<COUNT(TOTAL_HIGHEST_SCORES);i++)Run_Stats_RegisterHighestScore(i,values[n]);for(int i=0;i<COUNT(TOTAL_BEST_POSITIONS);i++)Run_Stats_RegisterBestPosition(i,values[n]);Snapshot();
        Run_Stats_AnotherLifeSavedWithAmbulance();Run_Stats_AnotherCriminalCaught();Run_Stats_RegisterLevelAmbulanceMission(values[n]);Run_Stats_RegisterLevelVigilanteMission(values[n]);Run_Stats_RegisterLevelFireMission(values[n]);Run_Stats_AnotherFireExtinguished();Run_Stats_AnotherKillFrenzyPassed();Run_Stats_SetTotalNumberKillFrenzies(values[n]);Run_Stats_SetTotalNumberMissions(values[n]);Snapshot();
        Run_Stats_MoneySpentOnWeapons(values[n]);Run_Stats_MoneySpentOnProperty(values[n]);Run_Stats_MoneySpentOnAutoPainting(values[n]);Run_Stats_MoneySpentOnFashion(values[n]);Run_Stats_NumOfVisitsFromLoanSharks(values[n]);Run_Stats_NumOfStoresKnockedOff(values[n]);Run_Stats_NumOfMovieStunts(values[n]);Run_Stats_NumOfAssassinations(values[n]);Run_Stats_NumOfPizzasDelivered(values[n]);Run_Stats_NumOfGarbagePickups(values[n]);Run_Stats_NumOfIceCreamSold(values[n]);Run_Stats_AddNumBloodRingKills(values[n]);Run_Stats_LongestTimeInBloodRing(values[n]);Snapshot();
        Run_Stats_CheckPointReachedSuccessfully();Snapshot();Run_Stats_CheckPointReachedUnsuccessfully();Snapshot();for(int i=0;i<COUNT(TOTAL_PROPERTIES);i++){Run_Stats_AddPropertyAsOwned(i);Run_Stats_AddPropertyAsOwned(i);}Snapshot();
    }
    // Confirm the original strict fastest-time sentinel and property duplicate behavior independently
    Reset();GLOBAL(FastestTimes)[0]=0;Run_Stats_RegisterFastestTime(0,60);Run_Stats_RegisterFastestTime(0,90);Check(GLOBAL(FastestTimes)[0]==60);GLOBAL(PropertyOwned)[0]=false;GLOBAL(NumPropertyOwned)=0;Run_Stats_AddPropertyAsOwned(0);Run_Stats_AddPropertyAsOwned(0);Check(GLOBAL(NumPropertyOwned)==1);Snapshot();
}
static void SaveCases()
{
    // Check every serialized byte, unaligned destinations, checkpoint side effects and delayed audio mutation
    for(unsigned seed=0;seed<64;seed++)for(unsigned offset=0;offset<4;offset++){
        Reset((int)seed);uint8_t expected[595],actual[608];uint32_t size=0;memset(actual,0xA7,sizeof(actual));
        int oldKills=GLOBAL(KillsSinceLastCheckpoint),oldLegitimate=GLOBAL(TotalLegitimateKills);float oldRadio[NUM_RADIOS];memcpy(oldRadio,MusicSavedData_FavoriteRadioStationList,sizeof(oldRadio));
        GLOBAL(TotalLegitimateKills)+=GLOBAL(KillsSinceLastCheckpoint);GLOBAL(KillsSinceLastCheckpoint)=0;memcpy(MusicSavedData_FavoriteRadioStationList,listen,sizeof(listen));ExpectedSave(expected);
        GLOBAL(TotalLegitimateKills)=oldLegitimate;GLOBAL(KillsSinceLastCheckpoint)=oldKills;memcpy(MusicSavedData_FavoriteRadioStationList,oldRadio,sizeof(oldRadio));mode=(seed&1)?1:0;armed=true;
        Run_Stats_SaveStats(actual+offset,&size);Check(size==595&&memcmp(expected,actual+offset,595)==0);for(unsigned i=0;i<offset;i++)Check(actual[i]==0xA7);for(unsigned i=offset+595;i<sizeof(actual);i++)Check(actual[i]==0xA7);Bytes(actual,sizeof(actual));Snapshot();
        SeedCanonical(700);Run_Stats_LoadStats(actual+offset,size);Snapshot();
    }
    // Preserve a legal signed/unsigned alias for the caller's size output before field serialization
    Reset();uint8_t saved[595];Run_Stats_SaveStats(saved,(uint32_t*)&GLOBAL(DaysPassed));Check(GLOBAL(DaysPassed)==595);Snapshot();
    // Keep the original load contract: a size mismatch is checked after reading the complete payload
    Run_Stats_LoadStats(saved,594);
#ifdef MASTER
    Check(assertions==0);
#else
    Check(assertions==1);
#endif
    Snapshot();
}
static void RatingCases()
{
