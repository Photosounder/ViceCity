    const int ratings[]={-10001,-10000,-6001,-6000,-5999,-4000,-3999,-2000,-1999,-500,-499,-1,0,19,20,49,50,74,75,99,100,119,120,149,150,199,200,239,240,269,270,299,300,334,335,369,370,399,400,449,450,499,500,549,550,599,600,609,610,649,650,699,700,849,850,999,1000,1004,1005,1149,1150,1299,1300,1499,1500,1699,1700,1999,2000,2099,2100,2299,2300,2499,2500,2749,2750,2999,3000,3499,3500,3999,4000,4999,5000,7499,7500,9999,10000,19999,20000,29999,30000,39999,40000,49999,50000,64999,65000,79999,80000,99999,100000,149999,150000,199999,200000,299999,300000,374999,375000,499999,500000,999999,1000000};
    for(unsigned i=0;i<sizeof(ratings)/sizeof(ratings[0]);i++)for(unsigned flags=0;flags<8;flags++){
        Reset();SeedCanonical(0);GLOBAL(FiresExtinguished)=GLOBAL(HighestLevelFireMission)=GLOBAL(HighestLevelAmbulanceMission)=GLOBAL(CriminalsCaught)=GLOBAL(LivesSavedWithAmbulance)=GLOBAL(HelisDestroyed)=0;GLOBAL(TotalLegitimateKills)=ratings[i];GLOBAL(TimesArrested)=(flags&1)?1:0;GLOBAL(TimesDied)=0;GLOBAL(CheatedCount)=0;GLOBAL(RoundsFiredByPlayer)=0;GLOBAL(TotalProgressInGame)=0;CWorld::Players[0].m_nMoney=0;CPad::bHasPlayerCheated=(flags&2)!=0;GLOBAL(FlightTime)=(flags&4)?11*60*60000:0;
        Number(Run_Stats_FindCriminalRatingNumber());const char *key=KeyOf(Run_Stats_FindCriminalRatingString());for(const char *p=key;*p;p++)Number(*p);Snapshot();
    }
    const float chase[]={-1,0,19.99f,20,49.99f,50,74.99f,75,99.99f,100,149.99f,150,199.99f,200,249.99f,250,299.99f,300,349.99f,350,399.99f,400,499.99f,500,599.99f,600,699.99f,700,799.99f,800,899.99f,900,999.99f,1000,1199.99f,1200,1399.99f,1400,1599.99f,1600,1799.99f,1800,NAN,INFINITY};
    for(unsigned i=0;i<sizeof(chase)/sizeof(chase[0]);i++){const char *key=KeyOf(Run_Stats_FindChaseString(chase[i]));for(const char *p=key;*p;p++)Number(*p);}
    // Compare percentage clamps and integer/float rating contributions without out-of-range conversions
    for(unsigned i=0;i<20;i++){Reset((int)i);GLOBAL(TotalProgressInGame)=(float)i;GLOBAL(ProgressMade)=(float)i*.75f;CGame::nastyGame=(i&1)!=0;Floating(Run_Stats_GetPercentageProgress());Number(Run_Stats_FindCriminalRatingNumber());Snapshot();}
}
static void FormattingCases()
{
    // Preserve null-text early returns and every single/paired display format across locale gates
    Reset();Bytes(gString2,sizeof(gString2));Run_Stats_BuildStatLine(NULL,(void*)1,0,NULL,0);Snapshot();
    for(int format=0;format<7;format++)for(unsigned paired=0;paired<2;paired++)for(unsigned jp=0;jp<2;jp++){
        Reset();japanese=jp!=0;int a=-17,b=29;float x=17.25f,y=29.5f;bool floating=format==1||format==3;mode=3;armed=true;
        Run_Stats_BuildStatLine("BASE",floating?(void*)&x:(void*)&a,format,paired?(floating?(void*)&y:(void*)&b):NULL,0);TextBytes(gUString);TextBytes(gUString2);Snapshot();
    }
    for(int minute=-1;minute<12;minute++){Reset();int hour=7;Run_Stats_BuildStatLine("TIME",&hour,0,&minute,1);TextBytes(gUString);TextBytes(gUString2);Snapshot();}
    Reset();int value=17;Run_Stats_BuildStatLine("BASE",&value,0,NULL,0);Check(gUString2[0]=='1'&&gUString2[1]=='7'&&gUString2[2]==0);Snapshot();
}
static void RowCases()
{
    // Compare every possible row and count query while retaining conditional rows and the persistent cache
    for(unsigned scenario=0;scenario<64;scenario++){
        Reset((int)scenario);GLOBAL(DaysPassed)=(int)(scenario/2);now=1000+scenario*10007;CGame::nastyGame=(scenario&1)!=0;CPad::bHasPlayerCheated=(scenario&2)!=0;mp3=(scenario&4)!=0;japanese=(scenario&8)!=0;FrontEndMenuManager.m_PrefsLanguage=(int)(scenario%9);
        GLOBAL(BestStuntJump)=(int)(scenario%10);GLOBAL(NumPropertyOwned)=0;for(int i=0;i<COUNT(TOTAL_PROPERTIES);i++){GLOBAL(PropertyOwned)[i]=((scenario>>(i%6))&1)!=0;if(GLOBAL(PropertyOwned)[i])++GLOBAL(NumPropertyOwned);}
        for(int i=0;i<COUNT(TOTAL_FASTEST_TIMES);i++)GLOBAL(FastestTimes)[i]=((scenario+i)%3)?0:(int)(scenario*7+i*61);for(int i=0;i<COUNT(TOTAL_HIGHEST_SCORES);i++)GLOBAL(HighestScores)[i]=((scenario+i)&1)?0:(int)scenario*13+i;GLOBAL(BestPositions)[0]=(scenario&16)?INT_MAX:2;
        GLOBAL(FlightTime)=(int)(scenario*7)*60000;GLOBAL(RoundsFiredByPlayer)=(scenario&16)?0:150;GLOBAL(BulletsThatHit)=71;GLOBAL(TotalProgressInGame)=100;GLOBAL(ProgressMade)=73;GLOBAL(HighestChaseValue)=(float)scenario*37;
        int count=Run_Stats_ConstructStatLine(99999);Check(count>=5&&count<256);Number(count);Snapshot();for(int row=-1;row<=count+1;row++){Number(Run_Stats_ConstructStatLine(row));Snapshot();}
        Run_Stats_Init();Number(Run_Stats_ConstructStatLine(99999));Snapshot();Run_Stats_PopulateFavoriteRadioStationList();Snapshot();
    }
}
int main()
{
    // Observe original static startup before any initializer or input seeding
    CanonicalSnapshot();Check(GLOBAL(DaysPassed)==0&&GLOBAL(PropertyOwned)[0]==false&&GLOBAL(FastestTimes)[0]==0);
    MutationCases();SaveCases();RatingCases();FormattingCases();RowCases();fprintf(stdout,"states=%llu checks=%llu observations=%llu hash=%016llx\n",(unsigned long long)states,(unsigned long long)checks,(unsigned long long)observations,(unsigned long long)digest);return 0;
}
