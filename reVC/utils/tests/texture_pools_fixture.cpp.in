static void requireAt(bool condition,unsigned line)
{
    // Fail quietly at the exact observation without creating any native dialogs
    ++checks;if(!condition){fprintf(stderr,"line=%u commands=%u checks=%u\n",line,commands,checks);abort();}
}
#define require(value) requireAt((value),__LINE__)
static void hashBytes(const void *memory,size_t count)
{
    // Compare only initialized bytes and stable resource identities
    const uint8_t *bytes=(const uint8_t*)memory;for(size_t i=0;i<count;++i){hashValue^=bytes[i];hashValue*=UINT64_C(1099511628211);}
}
static void event(unsigned operation,uint64_t a=0,uint64_t b=0)
{
    // Retain original allocation and COM operation order across native Windows pointer widths
    uint64_t values[]={operation,a,b};hashBytes(values,sizeof(values));++events;
}
static Texture *object(IDirect3DTexture8 *texture)
{
    // Recover controlled backing from the first actual C COM interface subobject
    return (Texture*)texture;
}
static unsigned identity(IDirect3DTexture8 *texture)
{
    // Normalize process-specific SDK pointers into stable test resource identities
    return texture?object(texture)->id:0;
}
static PoolState poolState(void *record)
{
    // Observe complete old or C record state through its independently compiled caller
    PoolState state;TestPoolState(record,&state);hashBytes(&state.Format,sizeof(state.Format));hashBytes(&state.size,sizeof(state.size));hashBytes(&state.levels,sizeof(state.levels));hashBytes(&state.texturesMax,sizeof(state.texturesMax));hashBytes(&state.texturesUsed,sizeof(state.texturesUsed));hashBytes(&state.texturesNum,sizeof(state.texturesNum));
    for(int i=0;i<state.texturesNum&&i<state.texturesMax;++i){unsigned id=identity(state.pTextures[i]);hashBytes(&id,sizeof(id));}return state;
}
static PaletteState paletteState(void *record)
{
    // Observe initialized palette entries while retaining original stale counts after shrinking
    PaletteState state;TestPaletteState(record,&state);hashBytes(&state.Max,sizeof(state.Max));hashBytes(&state.Num,sizeof(state.Num));for(int i=0;i<state.Num&&i<state.Max;++i)hashBytes(&state.Data[i],sizeof(int));return state;
}
static PoolResult run(unsigned operation,void *record=NULL,IDirect3DTexture8 *texture=NULL,int a=0,int b=0,int c=0,int d=0)
{
    // Dispatch complete algorithms through the independent old C++ or new C API consumer
    ++commands;PoolResult result;TestPools(operation,record,texture,a,b,c,d,&result);hashBytes(&result.value,sizeof(result.value));hashBytes(&numTexturePools,sizeof(numTexturePools));hashBytes(&MaxPaletteIndex,sizeof(MaxPaletteIndex));hashBytes(&bUsePaletteIndex,sizeof(bUsePaletteIndex));return result;
}
extern "C" void *TestAlloc(size_t size)
{
    // Record exact requested backing sizes without supplying allocation policy to the owner
    require(allocations<8192);void *memory=malloc(size?size:1);require(memory!=NULL);memset(memory,0xa5,size?size:1);storage[allocations++]={memory,size};event(1,size);return memory;
}
extern "C" void TestFree(void *memory)
{
    // Verify backing lifetime independently of the original and C allocator calls
    if(!memory){event(2);return;}unsigned i=0;while(i<allocations&&storage[i].pointer!=memory)++i;require(i<allocations);event(2,storage[i].size);storage[i].pointer=NULL;free(memory);++frees;
}
static void allocatorMetadata(const char *filename,const char *function,int line)
{
    // Verify the actual macro boundary supplies owner filenames, function identities and source locations
#ifdef ORIGINAL
    require(filename&&strstr(filename,"TexturePools.cpp")&&function&&line>0);
#else
    require(filename&&strstr(filename,"TexturePools.c")&&function&&line>0);
#endif
    const char *name=function;if(strncmp(name,"CTexturePool_",13)==0)name+=13;else if(strncmp(name,"CPaletteList_",13)==0)name+=13;
    const char *operations[]={"Create","Release","Resize","Alloc","Free"};unsigned operation=0;while(operation<5&&strcmp(name,operations[operation])!=0)++operation;require(operation<5);++citaCalls;event(40,operation);
}
extern "C" void *cita_win_malloc(size_t size,const char *filename,const char *function,int line)
{
    // Observe the real allocator ABI and preserve exact backing requests without replacing pool policy
    allocatorMetadata(filename,function,line);return TestAlloc(size);
}
extern "C" void cita_win_free(void *memory,const char *filename,const char *function,int line)
{
    // Observe the real allocator ABI for both nonnull and null original release paths
    allocatorMetadata(filename,function,line);TestFree(memory);
}
static ULONG STDMETHODCALLTYPE releaseTexture(IDirect3DTexture8 *texture)
{
    // Exercise the actual SDK Release vtable slot and original COM ownership transfers
    Texture *value=object(texture);require(value->refs>0);--value->refs;++releases;event(3,value->id,value->refs);return value->refs;
}
static DWORD STDMETHODCALLTYPE levelCount(IDirect3DTexture8 *texture)
{
    // Supply controlled SDK mip-level metadata through the actual COM signature
    event(4,identity(texture),object(texture)->levels);return object(texture)->levels;
}
static HRESULT STDMETHODCALLTYPE levelDescription(IDirect3DTexture8 *texture,UINT level,D3DSURFACE_DESC *desc)
{
    // Supply defined descriptor bytes even when testing the original ignored HRESULT path
    require(level==0);*desc=object(texture)->desc;event(5,identity(texture),failDescription);return failDescription?E_FAIL:D3D_OK;
}
static IDirect3DTexture8 *makeTexture(unsigned width,unsigned height,unsigned levels,D3DFORMAT format)
{
    // Create controlled COM backing without allocating GPU resources or implementing pooling decisions
    require(texturesCreated<8192);Texture *value=&textures[texturesCreated++];memset(value,0,sizeof(*value));value->base.lpVtbl=&textureVtable;value->id=texturesCreated;value->refs=1;value->levels=levels;value->desc.Width=width;value->desc.Height=height;value->desc.Format=format;event(6,value->id,width);return &value->base;
}
static HRESULT STDMETHODCALLTYPE createTexture(IDirect3DDevice8 *receiver,UINT width,UINT height,UINT levels,DWORD usage,D3DFORMAT format,D3DPOOL pool,IDirect3DTexture8 **output)
{
    // Verify direct C and original virtual calls use the same actual COM receiver and output address
    require(receiver==&device&&output==expectedOutput&&usage==0&&pool==D3DPOOL_MANAGED);++deviceCreates;event(7,width,height);event(8,levels,format);
    if(reenter){
        // Observe live global palette state through a nested public operation during an SDK call
        reenter=false;++reentries;run(OP_FindIndex);
    }
    *output=failCreate?NULL:makeTexture(width,height,levels,format);return failCreate?E_FAIL:D3D_OK;
}
