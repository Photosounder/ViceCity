    // Exercise valid live aliases into the ring without adding overlap assumptions to strncpy
    for(unsigned seed=0;seed<30;seed++){Reset(seed);Run_Debug_DebugAddText(GLOBAL(ms_aTextBuffer)[(seed+1)%15]+3);Snapshot();}
