template<class T> static void prepareVehicle(T &v,unsigned seed) {
    // Populate all vehicle fields with defined numeric inputs and initialized padding
    memset(&v,0,sizeof(v));const int models[]={MI_LANDSTAL,MI_PIZZABOY,MI_FAGGIO};v.model=models[(seed/3)%3];
    v.m_fGasPedal={(float)((seed/5)%5)*0.3f-0.1f,11};v.m_fBrakePedal={(float)((seed/7)%4)*0.4f-0.1f,12};v.m_nCurrentGear={(seed/11)%6,13};v.bIsHandbrakeOn={(seed/13)%2,14};v.bIsDrowning={(seed/17)%2,15};v.m_vecMoveSpeed.z={(float)((int)(seed%3)-1)*0.01f,16};
    v.m_nDriveWheelsOnGround={(seed/19)%3,17};v.m_nDriveWheelsOnGroundPrev={(seed/23)%3,18};v.m_fGasPedalAudio=(seed%5)*0.2f;v.m_fVelocityChangeForAudio={(seed/29)%2?0.0f:0.5f,19};
    for(unsigned w=0;w<sizeof(v.m_aWheelState)/sizeof(v.m_aWheelState[0]);++w)v.m_aWheelState[w]=(enum tWheelState)((seed/31+w)%4);
}
static void prepare(unsigned seed) {
    // Keep shared engine history across repeated calls while alternating the explicit owner
    seedValue=seed;active=&owners[seed&1];memset(active,0,sizeof(*active));memset(&params,0,sizeof(params));memset(&transmission,0,sizeof(transmission));memset(channels,0,sizeof(channels));
    bool bike=(seed/37)%2;for(unsigned i=0;i<2;++i) {prepareVehicle(cars[i],seed+i);prepareVehicle(bikes[i],seed+i);cars[i].bStuckInSand={(seed/41)%2,20};bikes[i].bExtraSpeed={(seed/43)%2,21};vehicles[i]=bike?(CVehicle *)&bikes[i]:(CVehicle *)&cars[i];}
    const char drives[]={'4','F','R','X'};transmission.nNumberOfGears={5,22};transmission.nDriveType={(unsigned)drives[(seed/47)%4],23};transmission.fMaxVelocity={100.0f,24};transmission.fMaxReverseVelocity={-100.0f,25};
    for(unsigned i=0;i<20;++i)aVehicleSettings[i].m_nBank=CAR_SFX_BANKS_OFFSET+i;
    const float velocities[]={-0.5f,-0.0011f,-0.001f,-0.0f,0.0f,0.001f,0.01f,0.5f,50.0f};const unsigned controls[]={0,1,149,150,219,220,255};
    accelerator=controls[(seed/53)%7];brake=(seed/59)%2?0:128;exiting=(seed/61)%3==0;replay=(seed/67)%3==0;
    params.m_VehicleType=seed%71==0?99:bike?VEHICLE_TYPE_BIKE:VEHICLE_TYPE_CAR;params.m_pVehicle=vehicles[0];params.m_pTransmission=&transmission;params.m_nIndex=(seed/73)%20;params.m_fVelocityChange=velocities[(seed/79)%9];
    active->m_bIsInitialised=seed%7!=0;active->m_bIsSurround=(seed/83)%2;active->m_bDynamicAcousticModelingStatus=(seed/89)%2;active->m_nActiveSamples=27;active->m_sQueueSample.m_fDistance=seed%51;active->m_sQueueSample.m_vecPos={1,2,3};
    for(unsigned c=0;c<64;++c)channels[c].used=(seed/97)%2;
    if(seed%101==0)currentTime=0xFFFFF000;
}
int main() {
#ifdef _WIN32
    // Keep sanitizer failures quiet
    SetErrorMode(3);
#endif
    // Exercise entry and exit notifications plus shared engine state across both owners
    for(unsigned seed=0;seed<2048;++seed) {prepare(seed);if(seed%5==0){@ENTER@;observe();}@LEFT@;observe();
        for(unsigned call=0;call<4;++call) {@RUN@;observe();++cases;accelerator=call%2?0:accelerator;}
    }
    // Require channel initialization, failure, playback, traction and geometry paths
    if(!initializations||!failures||!starts||!stops||!geometries||!unknowns)return 2;
    printf("%u cases %u callbacks %llu\n",cases,callbacks,(unsigned long long)digest);
}
