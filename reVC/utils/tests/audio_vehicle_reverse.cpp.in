    case 10: ++modelReads;if(seedValue&1024) params.m_pVehicle=&cars[1];break;
    case 20: ++engineReads;break;
    case 30: ++gasReads;break;
    case 40: ++gearReads;break;
    case 50: ++driveReads;if(seedValue&2048) params.m_pVehicle=&cars[0];break;
    case 51: ++previousReads;break;
    case 60: ++limitReads;if(seedValue&4096) params.m_pVehicle=&cars[1];break;
    }
}
