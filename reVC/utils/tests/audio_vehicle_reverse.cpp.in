static void bytes(const void *p,unsigned size) {
    // Observe complete initialized records without process-dependent pointer values
    const unsigned char *data=(const unsigned char *)p;
    for(unsigned i=0;i<size;i+=4) {uint32_t word;memcpy(&word,data+i,4);value(word);}
}
static void observe() {
    // Normalize vehicle and transmission identities while observing every owner and game record byte
    cVehicleParams copy=params;
    copy.m_pVehicle=(CVehicle *)(uintptr_t)(params.m_pVehicle==&cars[0]?1:params.m_pVehicle==&cars[1]?2:0);
    copy.m_pTransmission=(cTransmission *)(uintptr_t)(params.m_pTransmission==&transmissions[0]?1:params.m_pTransmission==&transmissions[1]?2:0);
    bytes(active,sizeof(*active));bytes(&copy,sizeof(copy));bytes(cars,sizeof(cars));bytes(transmissions,sizeof(transmissions));
}
static void event(unsigned token) {
    // Change live parameter selection after original captures without modifying unsequenced velocity operands
    ++callbacks;value(token);observe();
