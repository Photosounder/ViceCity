@METHOD@
static void prepare(unsigned seed) {
    // Seed range and model gates, reverse selection, drive-wheel states and bounded numeric inputs
    seedValue=seed;active=&owners[seed&1];memset(active,0,sizeof(*active));memset(&params,0,sizeof(params));memset(cars,0,sizeof(cars));memset(transmissions,0,sizeof(transmissions));
    active->m_nActiveSamples=6;active->m_nActiveQueue=(seed>>1)&1;active->m_bIsInitialised=(seed>>2)&1;active->m_bIsPaused=(seed>>3)&1;
    active->m_nRequestedCount[active->m_nActiveQueue]=seed%7;
    for(unsigned i=0;i<6;++i) {active->m_aRequestedOrderList[active->m_nActiveQueue][i]=i;active->m_aRequestedQueue[active->m_nActiveQueue][i].m_nFinalPriority=100+i*800;}
    const float distances[]={-1.0f,-0.0f,0.0f,35.99f,36.0f,100.0f,899.99f,900.0f,900.01f,INFINITY,NAN};
    const float gases[]={-1.0f,-0.01f,-0.0f,0.0f,0.01f,1.0f,NAN};
    const float velocities[]={-1.0f,-0.1f,-0.01f,-0.0f,0.0f,0.01f,0.1f,1.0f};
    const float limits[]={-0.1f,-1.0f,-10.0f,0.1f,1.0f,10.0f};
    const float audio[]={-1.0f,-0.1f,-0.0f,0.0f,0.001f,0.1f,1.0f,5.0f};
    const unsigned gears[]={0,1,5,255};
    for(unsigned i=0;i<2;++i) {
        cars[i].model=(seed/7+i)%5==0?MI_CADDY:MI_INFERNUS;
        cars[i].bEngineOn={uint32_t((seed/11+i)%2),20};cars[i].m_fGasPedal={gases[(seed/13+i)%7],30};cars[i].m_nCurrentGear={gears[(seed/17+i)%4],40};
        cars[i].m_nDriveWheelsOnGround={uint32_t((seed/19+i)%3),50};cars[i].m_nDriveWheelsOnGroundPrev={uint32_t((seed/23+i)%3),51};cars[i].m_fGasPedalAudio=audio[(seed/29+i)%8];
        transmissions[i].fMaxReverseVelocity={limits[(seed/31+i)%6],60};
    }
    params.m_pVehicle=&cars[0];params.m_pTransmission=&transmissions[0];params.m_VehicleType=0;params.m_nIndex=seed;
    params.m_fVelocityChange=velocities[(seed/37)%8];params.m_fDistance=distances[(seed/41)%11];params.m_bDistanceCalculated=(seed/451)%4==0?0:(seed/451)%4==1?1:255;
    active->m_sQueueSample.m_fDistance=(float)(seed%31);active->m_sQueueSample.m_nVolume=77;active->m_sQueueSample.m_nCounter=999;active->m_sQueueSample.m_nFrequency=54321;active->m_sQueueSample.m_vecPos={1,2,3};active->m_sQueueSample.m_nFramesToPlay=17;
    if(!(params.m_fDistance<900.0f)) params.m_pVehicle=NULL;
}
int main() {
#ifdef _WIN32
    // Keep sanitizer failures quiet instead of opening a Windows crash dialog
    SetErrorMode(3);
#endif
    // Compare repeated reverse requests and preserved in-range return values across both owners
    for(unsigned seed=0;seed<8192;++seed) {prepare(seed);value(@RUN@);observe();++cases;value(@RUN@);observe();++cases;}
    // Verify that airborne reverse audio does not dereference a missing transmission
    for(unsigned seed=0;seed<128;++seed) {
        prepare(seed);seedValue=0;params.m_fDistance=0.0f;params.m_pVehicle=&cars[0];params.m_pTransmission=NULL;
        cars[0].model=MI_INFERNUS;cars[0].bEngineOn.v=1;cars[0].m_fGasPedal.v=-1.0f;cars[0].m_nDriveWheelsOnGround.v=0;
        value(@RUN@);observe();++cases;
    }
    // Require both reverse eligibility and grounded/airborne field-read boundaries
    if(!modelReads || !engineReads || !gasReads || !gearReads || !driveReads || !previousReads || !limitReads) return 2;
#ifndef GTA_PS2
    if(!offsetReads) return 3;
#endif
#ifdef AUDIO_REFLECTIONS
    if(!requestReads) return 4;
#endif
    printf("%u cases %u callbacks %llu\n",cases,callbacks,(unsigned long long)digest);
}
