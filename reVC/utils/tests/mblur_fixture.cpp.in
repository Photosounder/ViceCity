    event(8,(uint32)width,(uint32)height);hashBytes(&depth,sizeof(depth));hashBytes(&flags,sizeof(flags));if(failCreate){--failCreate;++createFailures;return NULL;}require(creates<4096);RwRaster *value=&rasters[creates++];value->id=100+creates;value->width=width;value->height=height;value->depth=depth;value->flags=flags;value->alive=true;value->parent=NULL;return value;
