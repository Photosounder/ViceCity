    require(value==&camera);event(3,value->id);if(mutateRectangle){require(liveRectangle!=NULL);mutateRectangle=false;liveRectangle->w+=7;liveRectangle->h+=11;++liveMutations;}return value->frameBuffer;
}
float RwCameraGetNearClipPlane(RwCamera *value)
{
    // Read live near-clip metadata at every original setter argument site
    require(value==&camera);event(4,value->id);return value->nearClip;
}
int32 RwRasterGetWidth(RwRaster *value)
{
    // Retain each original width query through its actual SDK primitive
    require(value&&value->alive);event(5,value->id);return value->width;
}
int32 RwRasterGetHeight(RwRaster *value)
{
