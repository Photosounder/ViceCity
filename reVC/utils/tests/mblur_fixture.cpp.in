    require(raster&&raster->alive&&parent&&parent->alive);event(10,raster->id,parent->id);hashBytes(rect,sizeof(*rect));if(failSubRaster){--failSubRaster;++subFailures;return NULL;}raster->width=rect->w;raster->height=rect->h;raster->depth=parent->depth;raster->parent=parent;return raster;
