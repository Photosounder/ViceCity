        for(int type=0;type<8;++type){rect={190+type*11,140,240+type*11,190};args.type=type;run(OP_Add,&args);}rect={190,140,240,190};args.x1=180;args.y1=130;args.x2=250;args.y2=200;require(run(OP_Inside,&args)==1);args.x1=400;args.y1=400;args.x2=450;args.y2=450;require(run(OP_Inside,&args)==0);
