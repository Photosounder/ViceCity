static void requireAt(bool value,unsigned line)
{
    // Stop at the exact failed observation without opening native dialogs
    ++checks;if(!value){fprintf(stderr,"line=%u commands=%u checks=%u events=%u\n",line,commands,checks,events);abort();}
}
#define require(value) requireAt((value),__LINE__)
static void hashBytes(const void *memory,size_t count)
{
    // Observe initialized values without comparing process-specific pointer addresses
    const uint8_t *bytes=(const uint8_t*)memory;for(size_t i=0;i<count;++i){hashValue^=bytes[i];hashValue*=UINT64_C(1099511628211);}
}
static void event(unsigned operation,uint32_t a=0,uint32_t b=0)
{
    // Retain external operation order and normalized SDK resource identities
    uint32_t values[]={operation,a,b};hashBytes(values,sizeof(values));++events;
}
static unsigned identity(RwRaster *raster)
{
    // Preserve nullable SDK resource identities in all original state transitions
    return raster?raster->id:0;
}
static TestBlurState state(void)
{
    // Observe every shared variable through the separately compiled public caller
    TestBlurState result;TestBlurGetState(&result);unsigned id=identity((RwRaster*)result.front);hashBytes(&id,sizeof(id));hashBytes(&result.justInitialised,sizeof(result.justInitialised));hashBytes(&result.scaled,sizeof(result.scaled));hashBytes(&result.on,sizeof(result.on));hashBytes(&result.drunkness,sizeof(result.drunkness));hashBytes(&result.count,sizeof(result.count));hashBytes(&Timer_timeScale,sizeof(Timer_timeScale));return result;
}
static int32_t run(unsigned operation,TestBlurArgs *args)
{
    // Enter the entire original or C operation without reproducing its rendering decisions
#if defined(GTA_PS2) && !defined(EXTENDED_COLOURFILTER)
    // Mark the controlled successful fresh-open case before calling either producer so its missing return is never read
    if(operation==OP_Open){TestBlurState current;TestBlurGetState(&current);args->discardOpenResult=current.front==NULL&&failCreate==0&&failSubRaster==0;}
#endif
    ++commands;int32_t result=TestBlur(operation,args);hashBytes(&result,sizeof(result));state();if(args->rectangle)hashBytes(args->rectangle,sizeof(RwRect));return result;
}
static TestBlurArgs argumentsFor(RwRect *rect)
{
    // Supply native rectangle subobjects to the independent pure C consumer without casting record types
    TestBlurArgs args={};args.camera=&camera;args.raster=&sourceRaster;args.vertices=publicVertices;args.rectangle=rect;
    if(rect){
        // Exercise the actual native borrow helper on the converted SDK-client side
#ifdef ORIGINAL
        args.x=&rect->x;args.y=&rect->y;args.w=&rect->w;args.h=&rect->h;
#else
        MBlurRectRef ref=MBlur_NativeRect(rect);args.x=ref.x;args.y=ref.y;args.w=ref.w;args.h=ref.h;
#endif
    }
    args.red=137;args.green=257;args.blue=511;args.alpha=225;args.blur=173;args.blurAlpha=197;args.z=0.75f;return args;
}
static void observeVertices(RwIm2DVertex *vertices,int32_t count)
{
    // Observe exactly the initialized SDK fields consumed by the rendering primitive
    for(int i=0;i<count;++i)hashBytes(&vertices[i],sizeof(RwIm2DVertex));
}
static void message(unsigned kind,const char *format,va_list args)
{
    // Compare fully formatted diagnostics including the original debug prefix and fixed failure messages
    char buffer[512];int size=vsnprintf(buffer,sizeof(buffer),format,args);require(size>=0&&(size_t)size<sizeof(buffer));event(kind,(uint32_t)size);hashBytes(buffer,size);
}
extern "C" int TestBlurPrintf(const char *format,...)
{
    // Capture original stdout diagnostics without displaying graphics or polluting result records
    va_list args;va_start(args,format);message(1,format,args);va_end(args);++prints;return 0;
}
extern "C" void re3_debug(const char *format,...)
{
    // Retain the real external debug logging ABI and the original formatting behavior
    va_list args;va_start(args,format);message(2,format,args);va_end(args);
}
