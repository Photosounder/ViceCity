    seed(name,vehicle);unsigned initialTimers=timerInits,initialPagers=pagerInits;Run_UserDisplay_Init();assert(name.m_pZone==NULL&&name.m_pZone2==NULL&&name.m_nAdditionalTimer==0&&vehicle.m_pCurrentVehicle==NULL&&timerInits==initialTimers+1&&pagerInits==initialPagers+1&&traceCount==2&&trace[0]==7&&trace[1]==8);snapshot();
    for(int mode=1;mode<=12;mode++){
