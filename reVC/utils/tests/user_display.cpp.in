        if(mode==4){Run_CurrentVehicle_Display(&vehicle);assert(vehicle.m_pCurrentVehicle==&vehicles[2]&&CHud::m_VehicleName==labels[8]);}
        if(mode==5){Run_PlaceName_Process(&name);assert(name.m_nAdditionalTimer==77);}
        if(mode==6){Run_PlaceName_Display(&name);assert(name.m_pZone==&zones[3]&&CHud::m_pZoneName==labels[0]);}
        if(mode==7){Run_PlaceName_Process(&name);assert(expectedPosition.x==100.0f&&vehicles[0].position.x==-9.0f);}
        if(mode==8){name.m_pZone=&zones[2];Run_PlaceName_Process(&name);assert(name.m_pZone==navigation&&name.m_nAdditionalTimer==4);}
        if(mode==9){Run_UserDisplay_Process();assert(vehicle.m_pCurrentVehicle==&vehicles[1]&&CHud::m_VehicleName==labels[9]);}
        if(mode==10){Run_UserDisplay_Init();assert(name.m_nAdditionalTimer==31&&vehicle.m_pCurrentVehicle==NULL);}
