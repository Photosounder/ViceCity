static void bytes(const void *pointer,size_t size)
{
    // Hash stable scalar and record bytes without native pointer addresses
    const uint8_t *p=(const uint8_t *)pointer;for(size_t i=0;i<size;i++){hashValue^=p[i];hashValue*=UINT64_C(1099511628211);}
}
static void number(uint32_t value)
{
    // Keep integer observations at the same width across native architectures
    bytes(&value,4);
}
static uint32_t zoneId(const CZone *value)
{
    // Preserve exact canonical zone identity without hashing an address
    if(!value)return 0;for(int i=0;i<4;i++)if(value==&zones[i])return 1+i;abort();
}
static uint32_t vehicleId(const CVehicle *value)
{
    // Compare native vehicle base pointers including the derived shortcut taxi
    if(!value)return 0;for(int i=0;i<3;i++)if(value==&vehicles[i])return 1+i;if(value==(const CVehicle *)&taxi)return 4;abort();
}
static uint32_t labelId(const uint16_t *value)
