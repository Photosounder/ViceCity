        snapshot();
    }
    seed(name,vehicle);Run_CurrentVehicle_Display(&vehicle);labels[8][0]=0x1234;assert(CHud::m_VehicleName==labels[8]&&CHud::m_VehicleName[0]==0x1234);snapshot();
    seed(name,vehicle);
    for(int iteration=0;iteration<6000;iteration++){
        // Compare all nine complete operations in interleaved defined states with explicitly sequenced random inputs
        callbackMode=0;queryIndex=0;playing=(random32()%5)==0;int n=(int)(random32()%5)-1,d=(int)(random32()%5)-1;navigation=n<0?NULL:&zones[n];fallback=d<0?NULL:&zones[d];
