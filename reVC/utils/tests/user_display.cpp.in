    for(size_t i=0;i<sizeof(name);i++)assert(((const uint8_t *)&name)[i]==0);
    for(size_t i=0;i<sizeof(vehicle);i++)assert(((const uint8_t *)&vehicle)[i]==0);
    seed(name,vehicle);CPlaceName expectedName;memcpy(&expectedName,&name,sizeof(name));expectedName.m_pZone=NULL;expectedName.m_pZone2=NULL;expectedName.m_nAdditionalTimer=0;
    Run_PlaceName_Init(&name);assert(memcmp(&name,&expectedName,sizeof(name))==0);Run_CurrentVehicle_Init(&vehicle);assert(vehicle.m_pCurrentVehicle==NULL);snapshot();
    for(int oldNav=-1;oldNav<3;oldNav++)for(int oldDefault=-1;oldDefault<3;oldDefault++)for(int nextNav=-1;nextNav<3;nextNav++)for(int nextDefault=-1;nextDefault<3;nextDefault++)for(int timer:{-3,0,1,249,250,32767}){
        // Explore every old/new null and nonnull membership relation with zero, positive and signed retained counters
#ifndef FIX_BUGS
        if(nextNav<0&&nextDefault<0)continue;
#endif
        seed(name,vehicle);name.m_pZone=oldNav<0?NULL:&zones[oldNav];name.m_pZone2=oldDefault<0?NULL:&zones[oldDefault];name.m_nAdditionalTimer=(int16_t)timer;
        navigation=nextNav<0?NULL:&zones[nextNav];fallback=nextDefault<0?NULL:&zones[nextDefault];unsigned p=positions,q=zoneQueries,d=zoneDisplays;
        Run_PlaceName_Process(&name);assert(positions==p+1&&zoneQueries==q+2&&zoneDisplays==d+1);
        assert(name.m_nAdditionalTimer>=-4&&name.m_nAdditionalTimer<=32767);
        if(nextNav>=0)assert(name.m_pZone==&zones[nextNav]);else assert(name.m_pZone==NULL);
        if(nextNav<0&&nextDefault>=0)assert(name.m_pZone2==&zones[nextDefault]);
        if(nextNav==oldNav&&nextDefault==oldDefault&&(nextNav>=0||nextDefault>=0))assert(name.m_nAdditionalTimer==(timer?timer-1:0));
        snapshot();
    }
    for(int first=-1;first<4;first++)for(int second=-1;second<4;second++){
        // Select the primary zone first, retain fallback priority and preserve record fields during direct display
#ifndef FIX_BUGS
        if(first<0&&second<0)continue;
#endif
        seed(name,vehicle);name.m_pZone=first<0?NULL:&zones[first];name.m_pZone2=second<0?NULL:&zones[second];memcpy(&expectedName,&name,sizeof(name));unsigned t=translations;
        Run_PlaceName_Display(&name);assert(CHud::m_pZoneName==(first>=0?labels[first]:second>=0?labels[second]:NULL)&&translations==t+(first>=0||second>=0?1:0)&&memcmp(&name,&expectedName,sizeof(name))==0);snapshot();
    }
    seed(name,vehicle);Run_PlaceName_ProcessAfterFrontEndShutDown(&name);assert(CHud::m_pLastZoneName==NULL&&CHud::m_ZoneState==0&&name.m_nAdditionalTimer==250&&name.m_pZone==&zones[0]&&name.m_pZone2==&zones[1]);snapshot();
    for(bool inVehicle:{false,true})for(int assigned=-1;assigned<4;assigned++){
        // Retain the complete native pedestrian predicate including a set flag without a vehicle pointer
        seed(name,vehicle);pedestrians[0].bInVehicle=inVehicle;pedestrians[0].m_pMyVehicle=assigned<0?NULL:assigned==3?(CVehicle *)&taxi:&vehicles[assigned];
        unsigned calls=vehicleChecks;Run_CurrentVehicle_Process(&vehicle);CVehicle *selected=inVehicle?pedestrians[0].m_pMyVehicle:NULL;
        assert(vehicleChecks==calls+1&&vehicle.m_pCurrentVehicle==selected&&CHud::m_VehicleName==(!selected||assigned==3?NULL:labels[8+assigned]));snapshot();
    }
    for(int selected=-1;selected<4;selected++)for(bool shortcut:{false,true}){
        // Preserve null handling, native derived taxi comparison and the captured model-name lookup
        seed(name,vehicle);vehicle.m_pCurrentVehicle=selected<0?NULL:selected==3?(CVehicle *)&taxi:&vehicles[selected];if(!shortcut)CGameLogic::pShortCutTaxi=NULL;
        unsigned m=models,t=textCalls;Run_CurrentVehicle_Display(&vehicle);bool lookup=selected>=0&&!(selected==3&&shortcut);
        assert(models==m+(lookup?1:0)&&textCalls==t+(lookup?1:0)&&CHud::m_VehicleName==(lookup?labels[8+selected]:NULL));snapshot();
    }
