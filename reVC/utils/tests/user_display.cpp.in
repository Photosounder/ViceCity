    return CUserDisplay::PlaceName;
#else
    return PlaceName_state;
#endif
}
static CCurrentVehicle &canonicalCurrent()
{
    // Borrow the actual constructor-initialized original or static C-owned vehicle record
#ifdef TEST_USER_DISPLAY_ORIGINAL
    return CUserDisplay::CurrentVehicle;
#else
    return CurrentVehicle_state;
#endif
}
static void observe()
{
    // Include both complete user records, their padding, all HUD pointers and subordinate C state
    number(zoneId(place->m_pZone));number(zoneId(place->m_pZone2));bytes((const uint8_t *)place+2*sizeof(void *),sizeof(*place)-2*sizeof(void *));
    number(vehicleId(current->m_pCurrentVehicle));number(labelId(CHud::m_pZoneName));number(labelId(CHud::m_pLastZoneName));number(labelId(CHud::m_VehicleName));number(CHud::m_ZoneState);
    number(OnscreenTimer_state.m_bDisabled);number(OnscreenTimer_state.m_bProcessed);number((uint16_t)Pager_state.m_nNumDisplayLetters);bytes(labels,sizeof(labels));
}
static void event(uint32_t tag)
{
    // Record native callback order and the exact controller state before that boundary
    number(tag);if(traceCount<128)trace[traceCount]=tag;traceCount++;observe();
}
static void snapshot()
{
    // Compare canonical state and native base-adjustment guards after each operation
    observe();states++;
    for(int i=0;i<3;i++)assert(vehicles[i].guard[0]==UINT64_C(0x1234567812345600)+(unsigned)i);
    for(int i=0;i<4;i++)assert(modelRecords[i].guard[0]==UINT64_C(0xaabbccddaabbcc00)+(unsigned)i);
    assert(taxi.taxiGuard[0]==UINT64_C(0x9933557799335577));
}
static void seed(CPlaceName &name,CCurrentVehicle &vehicle)
{
    // Seed valid live pointers and nonzero place-record padding without invoking a user-display operation
    place=&name;current=&vehicle;memset(place,0x5a,sizeof(*place));place->m_pZone=&zones[0];place->m_pZone2=&zones[1];place->m_nAdditionalTimer=17;current->m_pCurrentVehicle=&vehicles[0];
    callbackMode=0;playing=false;armed=false;traceCount=0;queryIndex=0;navigation=&zones[0];fallback=&zones[1];CWorld::PlayerInFocus=0;
    memset(labels,0,sizeof(labels));for(int i=0;i<16;i++){labels[i][0]=(uint16_t)('A'+i);labels[i][1]=(uint16_t)(0x4e00+i);}
    memset(zones,0,sizeof(zones));for(int i=0;i<4;i++){zones[i].name[0]='Z';zones[i].name[1]=(char)('0'+i);}
    for(int i=0;i<3;i++){
        // Retain distinct live native vehicle positions and model indices behind opaque C pointers
        vehicles[i].guard[0]=UINT64_C(0x1234567812345600)+(unsigned)i;vehicles[i].guard[1]=~vehicles[i].guard[0];vehicles[i].position=CVector(100.0f+i,200.0f+i,300.0f+i);vehicles[i].m_modelIndex=(int16)i;
    }
    taxi.taxiGuard[0]=UINT64_C(0x9933557799335577);taxi.m_modelIndex=3;taxi.position=CVector(901.0f,902.0f,903.0f);CGameLogic::pShortCutTaxi=&taxi;
    for(int i=0;i<4;i++){modelRecords[i].guard[0]=UINT64_C(0xaabbccddaabbcc00)+(unsigned)i;modelRecords[i].guard[1]=~modelRecords[i].guard[0];modelRecords[i].id=i;snprintf(modelRecords[i].m_gameName,10,"CAR%d",i);}
    for(int i=0;i<2;i++){pedestrians[i].bInVehicle=true;pedestrians[i].m_pMyVehicle=&vehicles[i];pedestrians[i].position=CVector(10.0f+i,20.0f+i,30.0f+i);}
    CWorld::Players[0].m_pPed=&pedestrians[0];TheCamera.position=CVector(801.0f,802.0f,803.0f);
    CHud::m_pZoneName=labels[3];CHud::m_pLastZoneName=labels[2];CHud::m_VehicleName=labels[12];CHud::m_ZoneState=0xfedcba98;
    memset(&OnscreenTimer_state,0,sizeof(OnscreenTimer_state));OnscreenTimer_state.m_bDisabled=true;OnscreenTimer_state.m_bProcessed=true;memset(&Pager_state,0,sizeof(Pager_state));Pager_state.m_nNumDisplayLetters=19;
}
bool CPed::InVehicle(void)
{
    // Execute the complete original pedestrian predicate before any live-player mutation
    bool result=RealInVehicle();event(2);vehicleChecks++;
    if(callbackMode==1&&armed){CWorld::Players[0].m_pPed=&pedestrians[1];armed=false;callbacks++;}
    return result;
}
const CVector &CPlayerInfo::GetPos()
{
    // Run the entire original player-position operation and retain its borrowed native vector
    event(1);positions++;const CVector &result=RealGetPos();expectedPosition=result;queryIndex=0;return result;
}
extern "C" CZone *Zones_FindSmallestNavigationZoneForPosition(ZonesPosition position,bool first,bool second)
{
    // Observe both exact existing C zone calls with the single captured native player position
    assert(memcmp(&position.x,&expectedPosition.x,4)==0&&memcmp(&position.y,&expectedPosition.y,4)==0&&memcmp(&position.z,&expectedPosition.z,4)==0);
    assert(queryIndex<2&&first==(queryIndex==1)&&second==(queryIndex==0));event(queryIndex==0?3:4);bytes(&position,sizeof(position));zoneQueries++;
    CZone *result=queryIndex==0?navigation:fallback;
    if(callbackMode==7&&queryIndex==0){
        // Change the live native position between queries while retaining the original captured query coordinates
        vehicles[0].position=CVector(-9.0f,-8.0f,-7.0f);pedestrians[0].position=CVector(-6.0f,-5.0f,-4.0f);callbacks++;
    }
    if(callbackMode==8&&queryIndex==1){
        // Mutate prior membership after both lookup arguments were captured but before the transition decisions
        place->m_pZone=navigation;place->m_pZone2=fallback;place->m_nAdditionalTimer=5;callbacks++;
    }
    queryIndex++;return result;
}
extern "C" uint16_t *Zone_GetTranslatedName(CZone *zone)
{
    // Observe the selected canonical zone identity and return its original borrowed label
    assert(zone!=NULL);event(5);translations++;uint32_t id=zoneId(zone)-1;
    if(callbackMode==6){place->m_pZone=&zones[3];callbacks++;}
    return labels[id];
}
void CHud::SetZoneName(wchar *name)
{
    // Execute the complete original HUD pointer assignment at the original display boundary
    event(6);number(labelId(name));zoneDisplays++;RealSetZoneName(name);
    if(callbackMode==5){place->m_nAdditionalTimer=77;callbacks++;}
}
int16 CEntity::GetModelIndex(void)const
{
    // Capture the original native model index before changing the live current-vehicle slot
    int16 result=RealGetModelIndex();event(9);number((uint16_t)result);
    if(callbackMode==2){current->m_pCurrentVehicle=&vehicles[1];callbacks++;}
    return result;
}
CBaseModelInfo *CModelInfo::GetModelInfo(int32 model)
{
    // Preserve the typed base pointer adjustment used by the original model-info downcast
    assert(model>=0&&model<4);event(10);number(model);models++;
    if(callbackMode==3){memcpy(modelRecords[model].m_gameName,"CAR2",5);callbacks++;}
    return &modelRecords[model];
}
wchar *CText::Get(const char *name)
{
    // Resolve the original borrowed native game-name array after all model callbacks
    assert(strlen(name)<10);event(11);bytes(name,strlen(name)+1);textCalls++;
    int id=name[3]-'0';assert(strncmp(name,"CAR",3)==0&&id>=0&&id<4);
    if(callbackMode==4){current->m_pCurrentVehicle=&vehicles[2];callbacks++;}
    return labels[8+id];
}
void CHud::SetVehicleName(wchar *name)
{
    // Execute the whole original HUD vehicle-label pointer assignment
    event(12);number(labelId(name));vehicleDisplays++;RealSetVehicleName(name);
}
bool CReplay::IsPlayingBack()
{
    // Observe the original guarded root replay query before any subordinate update
    bool result=playing;event(13);replays++;
    if(callbackMode==11){place->m_nAdditionalTimer=91;CWorld::Players[0].m_pPed=&pedestrians[1];callbacks++;}
    return result;
}
extern "C" void OnscreenTimer_Init(COnscreenTimer *self)
{
    // Observe the unchanged subordinate C API between the place and vehicle initializations
    assert(self==&OnscreenTimer_state);event(7);timerInits++;
    if(callbackMode==10){place->m_nAdditionalTimer=31;current->m_pCurrentVehicle=&vehicles[2];callbacks++;}
}
extern "C" void Pager_Init(CPager *self)
{
    // Observe the unchanged subordinate C API before the final vehicle initialization
    assert(self==&Pager_state);event(8);pagerInits++;
}
extern "C" void OnscreenTimer_Process(COnscreenTimer *self)
{
    // Preserve the original update coordination boundary after place-name processing
    assert(self==&OnscreenTimer_state);event(7);timerUpdates++;
    if(callbackMode==9){CWorld::Players[0].m_pPed=&pedestrians[1];callbacks++;}
}
extern "C" void Pager_Process(CPager *self)
{
    // Preserve the original pager coordination boundary before the live vehicle query
    assert(self==&Pager_state);event(8);pagerUpdates++;
    if(callbackMode==12){playing=true;callbacks++;}
}
extern "C" void re3_assert(const char *expression,const char *file,unsigned int line,const char *function)
{
    // Report any violated native precondition without opening a Windows dialog
    fprintf(stderr,"%s %s:%u %s\n",expression,file,line,function);abort();
}
static uint32_t randomState=0x18a81f31;
static uint32_t random32()
{
    // Generate identical explicitly sequenced state transitions for every compiler
    randomState^=randomState<<13;randomState^=randomState>>17;randomState^=randomState<<5;return randomState;
}
int main()
{
