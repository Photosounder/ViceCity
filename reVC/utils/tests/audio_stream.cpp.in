static CSortStereoBuffer SortStereoBuffer = {nullptr, 0};

struct { int m_nMusicMode = 0; } MusicManager;
extern "C" bool AudioStream_IsCutscene(void) {
    // Supply fixture music state through the production C host boundary
    return MusicManager.m_nMusicMode == 1;
}
enum { MUSICMODE_CUTSCENE = 1 };
AudioThread gAudioThread;
AudioMutex gAudioThreadQueueMutex;
AudioWakeSignal gAudioThreadCv;
bool gAudioThreadTerm = false;
AudioProcessQueue gStreamsToProcess = {nullptr, nullptr};
AudioCloseQueue gStreamsToClose = {nullptr, nullptr};
static std::atomic<bool> decoderLibraryAlive{false};
static std::atomic<unsigned> fixtureAllocations{0};
static void *fixture_malloc(size_t size)
{
    // Count explicit scheduling nodes and caller-owned decoder allocations
    void *memory = std::malloc(size);
    if(memory) fixtureAllocations++;
    return memory;
}
static void fixture_free(void *memory)
{
    // Detect missing or excess frees across worker and synchronous shutdown paths
    if(memory) {
        assert(fixtureAllocations.fetch_sub(1) > 0);
        std::free(memory);
    }
}
#define malloc fixture_malloc
#define free fixture_free
static int mpg123_init()
{
    // Keep the fixture decoder library alive across decoding and cleanup
    decoderLibraryAlive = true;
    return 0;
}
static void mpg123_exit()
{
    // Record the actual library shutdown point from production Terminate
    assert(AudioCloseQueue_IsEmpty(&gStreamsToClose));
    decoderLibraryAlive = false;
}
static std::deque<ALuint> device[2];
static ALint sourceState[2] = {AL_STOPPED, AL_STOPPED};
static bool processDevice = false;

extern "C" void AL_APIENTRY alSourceQueueBuffers(ALuint source, ALsizei count, const ALuint* buffers)
{
    // Enforce unique physical buffer ownership and the device capacity
    for(int i = 0; i < count; i++) {
        auto& queue = device[source - 1];
        for(ALuint existing : queue) assert(existing != buffers[i]);
        assert(queue.size() < AUDIO_BUFFER_PAIR_CAPACITY);
        queue.push_back(buffers[i]);
    }
}
extern "C" void AL_APIENTRY alSourceUnqueueBuffers(ALuint source, ALsizei count, ALuint* buffers)
{
    // Return device buffers in FIFO order
    for(int i = 0; i < count; i++) {
        auto& queue = device[source - 1];
        assert(!queue.empty());
        buffers[i] = queue.front();
        queue.pop_front();
    }
}
extern "C" void AL_APIENTRY alGetSourcei(ALuint source, ALenum property, ALint* value)
{
    // Expose only the device state consumed by production stream methods
    if(property == AL_SOURCE_STATE) *value = sourceState[source - 1];
    else if(property == AL_BUFFERS_QUEUED) *value = (ALint)device[source - 1].size();
    else if(property == AL_BUFFERS_PROCESSED) *value = processDevice ? (ALint)device[source - 1].size() : 0;
    else assert(false);
}
extern "C" void AL_APIENTRY alSourcePlay(ALuint source)
{
    // Record playback without opening an audio device
    sourceState[source - 1] = AL_PLAYING;
}
extern "C" void AL_APIENTRY alSourceStop(ALuint source)
{
    // Record stopping without opening an audio device
    sourceState[source - 1] = AL_STOPPED;
}
extern "C" void AL_APIENTRY alBufferData(ALuint, ALenum, const ALvoid*, ALsizei, ALsizei)
{
    // Accept PCM uploads without audio hardware
}
void CStream_SetPitch(CStream *stream, float)
{
    // Leave pitch outside the queue test
}
void CStream_SetPan(CStream *stream, uint8) {
    // Leave source panning outside the synchronization fixture
}
void CStream_SetVolume(CStream *stream, uint32) {
