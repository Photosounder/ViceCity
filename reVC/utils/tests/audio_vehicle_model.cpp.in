@METHODS@
static void prepare(unsigned seed) {
    // Seed both owners and all model/control paths while preserving function-static history between cases
    seedValue=seed;active=&owners[seed&1];memset(active,0,sizeof(*active));memset(&params,0,sizeof(params));memset(cars,0,sizeof(cars));memset(Pads,0,sizeof(Pads));
    active->m_nActiveSamples=6;active->m_nActiveQueue=(seed>>1)&1;active->m_bIsInitialised=(seed>>2)&1;active->m_bIsPaused=(seed>>3)&1;
    active->m_nRequestedCount[active->m_nActiveQueue]=seed%7;
    for(unsigned i=0;i<6;++i) {active->m_aRequestedOrderList[active->m_nActiveQueue][i]=i;active->m_aRequestedQueue[active->m_nActiveQueue][i].m_nFinalPriority=100+i*800;}
    const float pedals[]={-1.0f,-0.01f,-0.0f,0.0f,0.01f,0.5f,1.0f};
    const float speeds[]={-1.0f,-0.1f,-0.001f,-0.0f,0.0f,0.001f,0.1f,1.0f};
    const float distances[]={-1.0f,0.0f,48.99f,49.0f,100.0f,1224.99f,1225.0f,1225.01f,NAN,INFINITY};
    const int controls[]={-100,-1,0,1,127,128,254,255};
    const int axes[]={-128,-1,0,1,127,128};
    for(unsigned i=0;i<3;++i) {
        cars[i].m_modelIndex={int32_t((seed/11+i)%3==0?MI_RCBANDIT:MI_RCBARON),20};
        cars[i].m_fGasPedal={pedals[(seed/13+i)%7],25};cars[i].m_fBrakePedal={pedals[(seed/17+i)%7],26};
        cars[i].bIsDrowning={uint32_t((seed/19+i)%2),41};cars[i].m_nDriveWheelsOnGround={uint32_t((seed/23+i)%3),27};
        cars[i].up=CVector(0.25f,((float)((seed/29+i)%9)-4)*0.25f,-0.5f);
    }
    playerId=(seed/3)%4;CWorld::PlayerInFocus=(seed>>3)&1;CWorld::Players[0].m_pRemoteVehicle.id=(seed/5)%4;CWorld::Players[1].m_pRemoteVehicle.id=(seed/7)%4;
    Pads[0].accelerator=controls[(seed/31)%8];Pads[0].brake=controls[(seed/37)%8];Pads[0].gun=axes[(seed/41)%6];
    params.m_pVehicle=&cars[0];params.m_fDistance=distances[(seed/43)%10];params.m_bDistanceCalculated=(seed/430)%4==0?0:(seed/430)%4==1?1:255;params.m_fVelocityChange=speeds[(seed/47)%8];params.m_nIndex=seed;
    active->m_sQueueSample.m_fDistance=(float)(seed%36);active->m_sQueueSample.m_nVolume=77;active->m_sQueueSample.m_nCounter=999;active->m_sQueueSample.m_nFrequency=54321;active->m_sQueueSample.m_vecPos={1,2,3};active->m_sQueueSample.m_nFramesToPlay=17;
    if(!(params.m_fDistance<1225.0f)) params.m_pVehicle=NULL;
}
int main() {
#ifdef _WIN32
    // Keep sanitizer failures quiet instead of opening a Windows crash dialog
    SetErrorMode(3);
#endif
    // Compare both model generators across repeated calls and shared history on alternating owners
    for(unsigned seed=0;seed<8192;++seed) for(unsigned kind=0;kind<2;++kind) {
        prepare(seed);@RUN@;observe();++cases;@RUN@;observe();++cases;
    }
    // Require player and non-player model, pedal, orientation and drowning boundaries
    if(!playerReads || !remoteReads || !modelReads || !gasReads || !brakePedalReads || !driveReads || !upReads || !drowningReads || !padBrakes || !padAccelerates || !padGuns) return 2;
#ifndef GTA_PS2
    if(!offsetReads) return 3;
#endif
#ifdef AUDIO_REFLECTIONS
    if(!requestReads) return 4;
#endif
    printf("%u cases %u callbacks %llu\n",cases,callbacks,(unsigned long long)digest);
}
