static unsigned identity(const CVehicle *p) {
    // Normalize selected vehicle pointers across process addresses
    return p==&cars[0]?1:p==&cars[1]?2:p==&cars[2]?3:0;
}
static CVehicle *vehicle(unsigned id) {
    // Materialize controlled player or remote vehicle identities
    return id?&cars[(id-1)%3]:NULL;
