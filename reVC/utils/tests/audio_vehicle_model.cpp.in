static void observe() {
    // Preserve complete owner, parameter, vehicle and control observations with normalized pointers
    cVehicleParams copy=params;copy.m_pVehicle=(CVehicle *)(uintptr_t)identity(params.m_pVehicle);
    bytes(active,sizeof(*active));bytes(&copy,sizeof(copy));bytes(cars,sizeof(cars));bytes(Pads,sizeof(Pads));
    value(playerId);value(CWorld::PlayerInFocus);value(CWorld::Players[0].m_pRemoteVehicle.id);value(CWorld::Players[1].m_pRemoteVehicle.id);
}
static void event(unsigned token) {
    // Change later live vehicle and remote reads without introducing undefined numeric inputs
    ++callbacks;value(token);observe();
    switch(token) {
    case 10:++playerReads;if(seedValue&1024) CWorld::Players[CWorld::PlayerInFocus].m_pRemoteVehicle.id=2;break;
    case 11:++remoteReads;break;
    case 20:++modelReads;if(seedValue&2048) params.m_pVehicle=&cars[1];break;
