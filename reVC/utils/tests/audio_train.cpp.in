@MACROS@
extern "C" cSampleManager SampleManager;cSampleManager SampleManager;
static cAudioManager owners[2],*active;
static cVehicleParams params;static CVehicle cars[2];
static unsigned seedValue,cases,callbacks,requests,offsetReads,farLayers,nearLayers,rejections,stationary;
static uint64_t digest=1469598103934665603ULL;
extern "C" uint64_t TestAircraftHash(uint64_t,const void *,uint32_t);
extern "C" uint8_t TestTrainC(cAudioManager *,cVehicleParams *);
extern "C" void TestTrainRealSubmit(cAudioManager *);
static void value(uint32_t v) {
    // Record exact callback order and scalar results
    digest=(digest^v)*1099511628211ULL;
}
static void observe() {
    // Normalize game pointers and hash every initialized storage record
    cVehicleParams copy=params;copy.m_pVehicle=(CVehicle *)(uintptr_t)(params.m_pVehicle==&cars[0]?1:params.m_pVehicle==&cars[1]?2:0);
    digest=TestAircraftHash(digest,owners,sizeof(owners));digest=TestAircraftHash(digest,&copy,sizeof(copy));digest=TestAircraftHash(digest,cars,sizeof(cars));
}
static void event(unsigned token) {
    // Observe every callback before its externally visible mutation
    ++callbacks;value(token);observe();
}
