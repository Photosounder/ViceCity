@METHODS@
static void prepare(unsigned seed) {
    // Cover range, motion, speed, wagon and cached-distance boundaries with defined casts
    seedValue=seed;active=&owners[seed&1];memset(owners,0,sizeof(owners));memset(&params,0,sizeof(params));memset(cars,0,sizeof(cars));
    const float distances[]={-1,0,1,4899,4900,4901,89999,90000,90001,INFINITY,NAN};
    const float velocities[]={-INFINITY,-1,-0.0f,0,0.001f,0.1f,INFINITY,NAN};
    const float speeds[]={0,0.0001f,0.1f,0.203999f,0.204f,0.204001f,1,INFINITY};
    const float wagons[]={0,-0.0f,0.0001f,1,-1,NAN,INFINITY};
    const float cached[]={-1,-0.0f,0,14,69.999f,70,70.001f,100};
    params.m_fDistance=distances[seed%11];params.m_fVelocityChange=velocities[(seed/11)%8];params.m_bDistanceCalculated=1+(seed/13)%2;
    for(unsigned i=0;i<2;++i){cars[i].m_fSpeed={speeds[(seed/17+i)%8],21};cars[i].m_fWagonPosition={wagons[(seed/19+i)%7],22};}
    params.m_pVehicle=params.m_fDistance<90000&&params.m_fVelocityChange>0?&cars[0]:nullptr;
    active->m_sQueueSample.m_fDistance=cached[(seed/23)%8];active->m_sQueueSample.m_nCounter=777;active->m_sQueueSample.m_nSampleIndex=999;active->m_sQueueSample.m_nFrequency=12345;active->m_sQueueSample.m_nFramesToPlay=17;active->m_sQueueSample.m_nPan=53;
    active->m_nActiveSamples=1+(seed/29)%8;active->m_sQueueSample.m_nEntityIndex=(int32_t)(seed%31)-15;active->m_sQueueSample.m_vecPos={1,2,3};active->m_bDynamicAcousticModelingStatus=1;
#ifndef GTA_PS2
    // Seed desktop fields to detect partial writes and backend ordering
    active->m_sQueueSample.m_nLoopStart=123;active->m_sQueueSample.m_nLoopEnd=456;
#endif
    // Cover uncached distance calculation without entering undefined volume-cast domains
    if(seed%31==0&&params.m_fDistance>=0&&params.m_fDistance<4900)params.m_bDistanceCalculated=0;
}
int main() {
#ifdef _WIN32
    // Keep sanitizer traps from opening a Windows error dialog
    SetErrorMode(3);
#endif
    // Compare repeated operations on alternating owners and require both layers and return paths
    for(unsigned seed=0;seed<16384;++seed){prepare(seed);observe();uint8_t result=@RUN@;value(result);observe();++cases;if(!result)++rejections;else if(!(params.m_fVelocityChange>0))++stationary;}
    if(!farLayers||!nearLayers||!rejections||!stationary)return 2;
#ifndef GTA_PS2
    // Require desktop loop-offset queries
    if(!offsetReads)return 3;
#endif
    // Emit the deterministic comparison trace
    printf("%u cases %u callbacks %u requests %llu\n",cases,callbacks,requests,(unsigned long long)digest);
}
