}
extern "C" void AudioRequests_Submit(cAudioManager *manager) {
    // Exercise real request insertion before mutating the subsequent near-layer gate
    ++requests;if(manager->m_sQueueSample.m_nCounter==32)++farLayers;else if(manager->m_sQueueSample.m_nCounter==33)++nearLayers;event(40);
    TestTrainRealSubmit(manager);event(41);
    if(seedValue&512){params.m_fDistance=(seedValue&1024)?10000:100;manager->m_sQueueSample.m_fDistance=10;params.m_pVehicle=&cars[1];}
}
