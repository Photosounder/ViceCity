}
extern "C" uint32_t SampleManager_GetSampleBaseFrequency(cSampleManager *,uint32_t sample) {
    // Exercise live distance changes while preserving the captured train
    event(30);value(sample);
    if(seedValue&128){params.m_pVehicle=&cars[1];active->m_sQueueSample.m_fDistance=(seedValue/7)%71;}
    return sample*13+14000;
}
extern "C" uint32_t SampleManager_GetSampleLoopStartOffset(cSampleManager *,uint32_t sample) {
    // Change the live sample before the later end-offset argument
