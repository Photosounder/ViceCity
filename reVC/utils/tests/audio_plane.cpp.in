    other.m_FrameCounter=0;other.m_anRandomTable[0]=1;other.m_anRandomTable[1]=59;
}
int main() {
#ifdef _WIN32
    // Keep undefined-behavior traps from opening a Windows error dialog
    SetErrorMode(3);
#endif
    // Compare all original entry points over alternating owners and repeated operations
    for(unsigned seed=0;seed<32768;++seed){unsigned kind=seed%14;prepare(seed,kind);observe();int32_t result=@RUN@;value(result);observe();++cases;}
    // Require every sound layer and the existing Cessna forwarding path
    for(unsigned i=0;i<7;++i)if(i!=4&&!layers[i])return 2;
    if(!cesnaCalls||!requests)return 3;
#ifndef GTA_PS2
