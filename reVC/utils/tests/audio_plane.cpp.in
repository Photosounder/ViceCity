    for(unsigned i=0;i<2;++i){cars[i].m_nPlaneId=(seed/5+i)%3;cars[i].m_fSpeed={speeds[(seed/7+i)%9],21};}
    if(kind==3||kind==7)cars[0].m_fSpeed.v=speeds[2+(seed/7)%7];
    if(kind==4)PlanePathPosition[cars[0].m_nPlaneId]=1000+(seed%301);
    if(kind==6)PlanePathPosition[cars[0].m_nPlaneId]=3000-(seed%351);
    params.m_pVehicle=&cars[0];params.m_nIndex=seed%3==0?AIRTRAIN:seed%3==1?DEADDODO:LANDSTAL;
    const float distances[]={0,1,169,170,171,179,180,181,239,240,241,439,440,441};
    float distance=distances[(seed/11)%14];params.m_fDistance=distance*distance;params.m_bDistanceCalculated=(seed/13)%3;
    active->m_sQueueSample.m_fDistance=distances[(seed/17)%14];active->m_sQueueSample.m_nCounter=777;active->m_sQueueSample.m_nSampleIndex=999;active->m_sQueueSample.m_nFrequency=12345;active->m_sQueueSample.m_nFramesToPlay=17;active->m_sQueueSample.m_nPan=53;
    active->m_nActiveSamples=1+(seed/19)%8;active->m_sQueueSample.m_nEntityIndex=(int32_t)(seed%31)-15;active->m_sQueueSample.m_vecPos={1,2,3};active->m_bDynamicAcousticModelingStatus=1;
#ifndef GTA_PS2
    // Seed desktop fields to detect partial writes and backend ordering
    active->m_sQueueSample.m_nLoopStart=123;active->m_sQueueSample.m_nLoopEnd=456;
#endif
    // Distinguish offset scheduling on the global owner from the alternate owner
