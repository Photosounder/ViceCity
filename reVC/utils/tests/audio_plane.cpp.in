static void prepare(unsigned seed,unsigned kind) {
    // Cover all flight stages and exact boundaries while retaining shared offset history
    seedValue=seed;active=(seed&1)?&other:&AudioManager;
    memset(&AudioManager,0,sizeof(AudioManager));memset(&other,0,sizeof(other));memset(&params,0,sizeof(params));memset(cars,0,sizeof(cars));
