    return ((const CBoat *)v)->bPropellerInWater;
}
extern "C" uint8_t AudioBoatHost_InWater(const CVehicle *v) {
    // Query the live boat-in-water flag
    return ((const CBoat *)v)->bBoatInWater;
}
extern "C" CVehicle *AudioPoliceHost_PlayerVehicle() {
    // Select player or AI throttle while retaining the comparison's live parameter pointer
    event(21);return seedValue%3==0?NULL:&cars[(seedValue/3)%2];
}
static CVehicle *FindPlayerVehicle() {
    // Route the original player lookup through the same observer
    return AudioPoliceHost_PlayerVehicle();
}
static int16_t padQuery(unsigned token) {
    // Exercise conditional repeated queries with changing but valid controller values
    event(token);unsigned i=token-22;const int16_t values[]={0,1,63,127,128,254,255};return values[(seedValue/5+padReads[i]++*3+i)%7];
}
extern "C" int16_t AudioVehicleModelHost_Accelerate() {
    // Preserve the first pad query and any selected repeated query
    return Pads[0].GetAccelerate();
}
extern "C" int16_t AudioVehicleModelHost_Brake() {
    // Preserve the second pad query and any selected repeated query
    return Pads[0].GetBrake();
}
extern "C" uint32_t SampleManager_GetSampleLoopStartOffset(cSampleManager *,uint32_t sample) {
    // Change the live loop sample after the first backend query
    ++offsetReads;event(21);value(sample);if(seedValue&128){active->m_sQueueSample.m_nSampleIndex=SFX_BOAT_WATER_LOOP;params.m_pVehicle=&cars[1];cars[0].m_modelIndex.v=MI_REEFER;}return sample*3;
}
extern "C" int32_t SampleManager_GetSampleLoopEndOffset(cSampleManager *,uint32_t sample) {
    // Observe the live end-offset argument
    ++offsetReads;event(22);value(sample);return sample*5+100;
}
extern "C" uint8_t AudioRequestsHost_InRoom() {
    // Observe actual C request insertion after vehicle-condition sound setup
    ++requests;if(active->m_sQueueSample.m_nCounter==40)++engineRequests;if(active->m_sQueueSample.m_nCounter==38)++waterRequests;if(active->m_sQueueSample.m_nCounter==39)++idleRequests;event(26);return seedValue&1;
}
extern "C" uint8_t AudioRequestsHost_SlowMotion() {
    // Supply the unused reflection dependency
    return 0;
}
@METHODS@
static void prepare(unsigned seed,unsigned kind) {
    // Sweep all supported models, throttle ranges and exact water-speed boundaries without resetting shared history
    seedValue=seed;padReads[0]=padReads[1]=0;active=&owners[seed&1];memset(active,0,sizeof(*active));memset(&params,0,sizeof(params));memset(cars,0,sizeof(cars));
    const float pedals[]={-0.0f,0.0f,0.001f,0.05f,0.25f,0.5f,0.99f,1.0f};
    const int models[]={MI_RIO,MI_PREDATOR,MI_SQUALO,MI_SPEEDER,MI_COASTG,MI_DINGHY,MI_JETMAX,MI_REEFER,MI_TROPIC,MI_MARQUIS,MI_CADDY,-1};
    for(unsigned i=0;i<2;++i){cars[i].status={uint32_t((seed/3+i)%10),13};cars[i].m_modelIndex={models[(seed/7+i)%12],14};cars[i].m_fGasPedal={pedals[(seed/11+i)%8],12};cars[i].m_fBrakePedal={pedals[(seed/13+i)%8],15};cars[i].bPropellerInWater={uint32_t((seed/17+i)&1),16};cars[i].bBoatInWater={uint32_t((seed/19+i)&1),17};}
    const float distances[]={-1.0f,0.0f,100.0f,2499.0f,2500.0f,2501.0f,8099.0f,8100.0f,8101.0f,NAN,INFINITY};params.m_pVehicle=&cars[0];params.m_fDistance=distances[(seed/23)%11];params.m_bDistanceCalculated=(seed/29)%3;
    const float speeds[]={-INFINITY,-0.751f,-0.75f,-0.749f,-0.00051f,-0.0005f,-0.00049f,-0.0f,0.0f,0.00049f,0.0005f,0.00051f,0.749f,0.75f,0.751f,INFINITY,NAN};params.m_fVelocityChange=speeds[(seed/31)%17];
    active->m_nActiveSamples=1+(seed/37)%8;active->m_sQueueSample.m_fDistance=(seed/41)%(kind==0?91:51);active->m_sQueueSample.m_nEntityIndex=(int32_t)(seed%31)-15;active->m_sQueueSample.m_nCounter=777;active->m_sQueueSample.m_nSampleIndex=999;active->m_sQueueSample.m_nFrequency=12345;active->m_sQueueSample.m_nFramesToPlay=17;active->m_sQueueSample.m_vecPos={1,2,3};active->m_bDynamicAcousticModelingStatus=1;
#ifndef GTA_PS2
    // Seed desktop loop offsets before live backend queries
    active->m_sQueueSample.m_nLoopStart=123;active->m_sQueueSample.m_nLoopEnd=456;
#endif
    // Seed random storage to detect unintended state changes
    for(unsigned i=0;i<5;++i)active->m_anRandomTable[i]=(int32_t)(seed*(i+1)%10001)-5000;
    if(!(params.m_fDistance<(kind==0?8100.0f:2500.0f)))params.m_pVehicle=NULL;
}
int main() {
#ifdef _WIN32
    // Keep sanitizer failures quiet
    SetErrorMode(3);
#endif
    // Compare repeated complete generators and shared smoothing history on alternating owners
    for(unsigned seed=0;seed<4096;++seed)for(unsigned kind=0;kind<2;++kind){prepare(seed,kind);for(unsigned call=0;call<2;++call){value(@RUN@);observe();++cases;}}
    // Require backend sound selection and the preserved unsupported-vehicle diagnostic
    #ifdef AUDIO_REFLECTIONS
    // Require ordinary engine, water and reefer-idle request setup
    if(!engineRequests||!waterRequests||!idleRequests)return 2;
#endif
#ifndef GTA_PS2
    // Require both live loop-offset queries
    if(!offsetReads)return 3;
#endif
    printf("%u cases %u callbacks %llu\n",cases,callbacks,(unsigned long long)digest);
}
