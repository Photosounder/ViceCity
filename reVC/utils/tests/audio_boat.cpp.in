    // Keep floating game fields pure in the native MSVC fixture
    return v;
}};
struct ShortValue {int32_t v;unsigned token;operator int16_t() const {
    // Observe the original direct model-index read
    event(token);return (int16_t)v;
}};
class CVehicle {public:ByteValue status;FloatValue m_fGasPedal,m_fBrakePedal;ShortValue m_modelIndex;
    int32_t GetStatus() const {
        // Query the captured boat status
        return status;
    }
    int16_t GetModelIndex() const {
        // Read the captured boat model at both original query positions
        return m_modelIndex;
    }
};
class CBoat:public CVehicle {public:ByteValue bPropellerInWater,bBoatInWater;};
static int16_t padQuery(unsigned token);
class CPad {public:int16_t GetAccelerate() {
    // Observe the original accelerator query
    return padQuery(22);
}int16_t GetBrake() {
    // Observe the original brake query
    return padQuery(23);
}};
static CPad Pads[1];
struct cAudioManager {
@FIELDS@
    bool8 ProcessBoatEngine(cVehicleParams &);bool8 ProcessBoatMovingOverWater(cVehicleParams &);
};
@MACROS@
static cAudioManager owners[2],*active;static cVehicleParams params;static CBoat cars[2];
static unsigned seedValue,cases,callbacks,offsetReads,requests,padReads[2],engineRequests,waterRequests,idleRequests;
static uint64_t digest=1469598103934665603ULL;
extern "C" cSampleManager SampleManager;cSampleManager SampleManager;
extern "C" void AudioRequests_Submit(cAudioManager *);
extern "C" uint8_t TestBoatC(cAudioManager *,cVehicleParams *,unsigned);
static void value(uint32_t v) {
    // Hash results and exact callback order reproducibly
    digest=(digest^v)*1099511628211ULL;
}
static void bytes(const void *p,unsigned size) {
    // Observe initialized records without type punning
    const unsigned char *data=(const unsigned char *)p;
    for(unsigned i=0;i<size;i+=4){uint32_t word;memcpy(&word,data+i,4);value(word);}
}
static void observe() {
    // Include complete owner and vehicle storage while normalizing parameter pointers
    cVehicleParams copy=params;copy.m_pVehicle=(CVehicle *)(uintptr_t)(params.m_pVehicle==&cars[0]?1:params.m_pVehicle==&cars[1]?2:0);
    bytes(active,sizeof(*active));bytes(&copy,sizeof(copy));bytes(cars,sizeof(cars));
}
static void event(unsigned token) {
    // Preserve captured boat reads while changing later live parameters after status and propeller queries
    ++callbacks;value(token);observe();if((token==13||token==16)&&(seedValue&512))params.m_pVehicle=&cars[1];
}
extern "C" int32_t AudioVehicleEngineHost_Status(const CVehicle *v) {
    // Query the original captured status
    return v->GetStatus();
}
extern "C" int16_t AudioVehicleReverseHost_Model(const CVehicle *v) {
    // Query the original captured model
    return v->GetModelIndex();
}
