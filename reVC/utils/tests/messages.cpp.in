    unsigned i=0;while(input[i]){output[i]=(uint8_t)input[i];i++;}output[i]=0;
}
static void seedRecord(tMessage &message,int index,bool filled)
{
    // Give all consumed fields valid values while retaining nonzero original record padding
    memset(&message,0x5a,sizeof(message));message.m_pText=filled?textRows[1+index%2]:NULL;message.m_nFlag=(uint16_t)(123+index);message.m_nTime=50+(unsigned)index;
    message.m_nStartTime=100;for(int n=0;n<6;n++)message.m_nNumber[n]=index*7+n-3;message.m_pString=NULL;
}
static void seed(bool filled=false)
{
