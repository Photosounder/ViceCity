static void add(unsigned kind,uint16_t *text,uint32_t time,uint16_t flag,uint16_t *string)
{
    // Exercise every registration operation with all six original signed numeric arguments
    switch(kind){
    case 0:Run_Messages_AddMessage(text,time,flag);break;
    case 1:Run_Messages_AddMessageJumpQ(text,time,flag);break;
    case 2:Run_Messages_AddMessageSoon(text,time,flag);break;
    case 3:Run_Messages_AddBigMessage(text,time,(uint16_t)(flag%6));break;
    case 4:Run_Messages_AddBigMessageQ(text,time,(uint16_t)(flag%6));break;
    case 5:Run_Messages_AddMessageWithNumber(text,time,flag,12,-3,456,0,9999999,-12345678);break;
    case 6:Run_Messages_AddMessageJumpQWithNumber(text,time,flag,12,-3,456,0,9999999,-12345678);break;
    case 7:Run_Messages_AddMessageSoonWithNumber(text,time,flag,12,-3,456,0,9999999,-12345678);break;
    case 8:Run_Messages_AddBigMessageWithNumber(text,time,(uint16_t)(flag%6),12,-3,456,0,9999999,-12345678);break;
    case 9:Run_Messages_AddBigMessageWithNumberQ(text,time,(uint16_t)(flag%6),12,-3,456,0,9999999,-12345678);break;
    case 10:Run_Messages_AddMessageWithString(text,time,flag,string);break;
    case 11:Run_Messages_AddMessageJumpQWithString(text,time,flag,string);break;
    }
}
