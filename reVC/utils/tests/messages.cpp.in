        snapshot();
    }
    printf("states=%u checks=%u japanese=%u ascii=%u keys=%u big=%u small=%u defined=%u hudClears=%u pagerClears=%u callbacks=%u actions=%u hash=%016llx\n",states,checks,japaneseCalls,asciiCalls,keyCalls,bigCalls,smallCalls,definedCalls,hudClears,pagerClears,callbacks,(unsigned)MAX_CONTROLLERACTIONS,(unsigned long long)hashValue);
}
