    memset(textRows,0,sizeof(textRows));const char *strings[]={"","Alpha","Beta","<~1~>|~1~|~1~|~1~|~1~|~1~|~1~","~k~~ACT0~!","pre~a~post","clear-me","clear-me","~1~","~k~~ACT0~","","prefix","A","AB","GHOST","Title"};
