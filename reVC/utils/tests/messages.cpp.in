        assert(length(buffer)<128&&buffer[length(buffer)+1]==0x6e);if(text==3&&locale==0)assert(buffer[0]=='<'&&buffer[1]=='1'&&buffer[2]=='2');bytes(buffer,sizeof(buffer));snapshot();
    }
