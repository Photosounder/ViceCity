    seed();for(int i=0;i<8;i++)Run_Messages_AddMessage(i%3?textRows[6]:textRows[2],100,0);Run_Messages_ClearThisPrint(textRows[7]);assert(briefs()[0].m_pText==textRows[2]&&briefs()[1].m_pText==textRows[2]&&briefs()[2].m_pText==textRows[2]&&!briefs()[3].m_pText);snapshot();
