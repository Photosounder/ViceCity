    for(int i=0;i<6;i++)for(int j=0;j<4;j++)seedRecord(bigs()[i].m_Stack[j],i*4+j,filled);
    memset(previous(),0x6b,sizeof(tPreviousBrief)*5);for(int i=0;i<5;i++){previous()[i].m_pText=filled?textRows[1+i%2]:NULL;previous()[i].m_pString=filled?textRows[0]:NULL;for(int n=0;n<6;n++)previous()[i].m_nNumber[n]=i*11+n;}
    memset(title(),0x37,16);Timer_timeMs=1234;CFont::LanguageSet=0;callbackMode=0;armed=true;clearOrder=0;
    memset(ControlsManager.m_aActionNames,0,sizeof(ControlsManager.m_aActionNames));memset(keyRows,0,sizeof(keyRows));
    ascii(ControlsManager.m_aActionNames[0],"ACT0");ascii(ControlsManager.m_aActionNames[1],"ACT");ascii(ControlsManager.m_aActionNames[2],"ACT2");ascii(keyRows[0],"K0");ascii(keyRows[1],"K1");ascii(keyRows[2],"K2");
