static void record(const tMessage &message)
{
    // Include every scalar and original padding byte while normalizing both borrowed pointers
    number(textId(message.m_pText));number(textId(message.m_pString));
    bytes((const uint8_t *)&message+sizeof(message.m_pText),offsetof(tMessage,m_pString)-sizeof(message.m_pText));
}
static void observe()
{
    // Observe complete canonical queues/history/title and all consumed native output/input storage
    for(int i=0;i<8;i++)record(briefs()[i]);
    for(int i=0;i<6;i++)for(int j=0;j<4;j++)record(bigs()[i].m_Stack[j]);
    for(int i=0;i<5;i++){number(textId(previous()[i].m_pText));bytes(previous()[i].m_nNumber,24);number(textId(previous()[i].m_pString));}
    bytes(title(),16);number(Timer_timeMs);bytes(CHud::m_BigMessage,sizeof(CHud::m_BigMessage));bytes(CHud::m_Message,sizeof(CHud::m_Message));bytes(LastBigMessage,sizeof(LastBigMessage));
