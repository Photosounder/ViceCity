bool CFont::IsJapanese()
{
    // Observe each original pure locale read without inventing side effects in unordered character operands
    japaneseCalls++;number(1);number(LanguageSet);return LanguageSet==FONT_LANGSET_JAPANESE;
}
void AsciiToUnicode(const char *source,wchar *output)
{
    // Execute the complete original bounded numeric conversion before any eager-work callback
    number(2);bytes(source,strlen(source)+1);observe();asciiCalls++;RealAsciiToUnicode(source,output);wide(output);
    if(callbackMode==4&&armed){briefs()[0].m_pText=textRows[1];Timer_timeMs=777;armed=false;callbacks++;}
}
void CControllerConfigManager::GetWideStringOfCommandKeys(uint16 action,wchar *output,uint16 size)
{
    // Resolve the captured action using deterministic native input-owner storage
    assert(action<MAX_CONTROLLERACTIONS&&size==256);number(3);number(action);number(size);observe();keyCalls++;
    unsigned i=0;while(i+1<size&&keyRows[action][i]){output[i]=keyRows[action][i];i++;}output[i]=0;
    if(callbackMode==5&&armed){briefs()[0].m_pText=textRows[2];Timer_timeMs=888;armed=false;callbacks++;}
    if(callbackMode==7&&armed){ascii(m_aActionNames[2],"NEW");ascii(keyRows[2],"N2");armed=false;callbacks++;}
}
void DefinedState()
{
    // Observe the original graphics-state boundary without opening a graphics device
    number(4);observe();definedCalls++;
    if(callbackMode==1&&armed){bigs()[0].m_Stack[0].m_pText=textRows[2];briefs()[0].m_pText=textRows[1];armed=false;callbacks++;}
}
void CHud::SetBigMessage(wchar *message,uint16 style)
{
    // Execute the whole native HUD gating/copy operation with the original style and initialized payload
    assert(style<6&&length(message)<128);number(5);number(style);wide(message);observe();bigCalls++;RealSetBigMessage(message,style);
    if(callbackMode==2&&style==0&&armed){bigs()[1].m_Stack[0].m_pText=textRows[2];armed=false;callbacks++;}
    if(callbackMode==6&&style==5&&armed){briefs()[0].m_pText=textRows[2];armed=false;callbacks++;}
}
void CHud::SetMessage(wchar *message)
{
    // Execute the complete native brief HUD copy without changing message ownership
    assert(length(message)<256);number(6);wide(message);observe();smallCalls++;RealSetMessage(message);
}
void CHud::GetRidOfAllHudMessages()
{
    // Observe the original HUD reset boundary after all three canonical pointer-table clears
    number(7);observe();hudClears++;assert(clearOrder==0);clearOrder=1;
    for(int i=0;i<8;i++)assert(!briefs()[i].m_pText&&!briefs()[i].m_pString);
    for(int i=0;i<5;i++)assert(!previous()[i].m_pText&&!previous()[i].m_pString);
    if(callbackMode==3&&armed){briefs()[0].m_pText=textRows[1];armed=false;callbacks++;}
}
extern "C" void Pager_ClearMessages(CPager *self)
{
