    ++snapshots;for(int i=0;i<TXDSTORESIZE;++i){TxdDef *entry=get(i);if(entry){RwTexDictionary *dictionary=(RwTexDictionary*)entry->texDict;unsigned values[]={(unsigned)i,(unsigned)entry->refCount,dictionary?dictionary->id:0};hashBytes(values,sizeof(values));hashBytes(entry->name,strlen(entry->name)+1);}}event(15,current?current->id:0);
}
