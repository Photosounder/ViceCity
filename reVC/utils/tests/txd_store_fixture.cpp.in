    require(created<8191);RwTexDictionary *dictionary=&dictionaries[++created];dictionary->id=created;event(3,created);return dictionary;
}
void RwTexDictionaryDestroy(RwTexDictionary *dictionary)
{
    // Record SDK destruction at the exact point chosen by the actual owner
    require(dictionary&&dictionary->id);++dictionary->destroys;event(4,dictionary->id);
}
RwTexDictionary *RwTexDictionaryGetCurrent(void)
{
    // Return the SDK's live current dictionary through the original primitive
    event(5,current?current->id:0);return current;
}
void RwTexDictionarySetCurrent(RwTexDictionary *dictionary)
{
