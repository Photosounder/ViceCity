static void require(bool condition)
{
    // Stop at the exact corpus case if an original native precondition or independent expectation fails
    if(!condition){fprintf(stderr,"Weather assertion case %d states %u calls %u\n",caseNumber,states,calls);abort();}
}
static void word(uint32_t value)
{
    // Observe canonical values in a fixed byte order independent of addresses and padding
    for(unsigned i=0;i<4;i++){hashValue^=(value>>(8*i))&255;hashValue*=1099511628211ULL;}
}
static void floating(float value)
{
    // Preserve exact native float bits without a representation cast
    uint32_t bits;memcpy(&bits,&value,4);word(bits);
}
static void vector(const CVector &value)
{
    // Observe all components passed to actual native vector arguments
    floating(value.x);floating(value.y);floating(value.z);
}
static void packet(WeatherVector value)
{
    // Observe plain C coordinate packets using the same component order
    floating(value.x);floating(value.y);floating(value.z);
}
static void canonical()
{
    // Read every canonical scalar and complete persistent table through named-field adapters
    WeatherTestState value;TestWeather_Read(&value);
    @SCALAR_OBSERVATIONS@
    for(const auto &streak:value.streaks){packet(streak.position);packet(streak.direction);word(streak.timer);}
    for(int i=0;i<64;i++){word(uint16_t(value.types[i]));word(uint16_t(value.hurricanes[i]));}
    for(float wind:value.wind)floating(wind);
}
static void geometry()
{
    // Observe the entire actual typed vertex/index buffer including retained inactive entries
    word(TempBufferVerticesStored);word(TempBufferIndicesStored);word(RenderBuffer_VerticesToBeStored);word(RenderBuffer_IndicesToBeStored);
    for(int i=0;i<TEMPBUFFERVERTSIZE;i++){auto &v=TempBufferRenderVertices[i];floating(v.getX());floating(v.getY());floating(v.getZ());RwRGBA color=v.getColor();word(color.red);word(color.green);word(color.blue);word(color.alpha);floating(v.getU());floating(v.getV());}
    for(uint16_t index:TempBufferRenderIndexList)word(index);
}
static void snapshot(unsigned tag)
{
    // Compare full operation results and persistent state without observing private object padding
    ++states;word(tag);canonical();geometry();word(randomState);word(randomDraws);
    if(getenv("WEATHER_TRACE"))printf("%u %d %u %016llx\n",states,caseNumber,tag,(unsigned long long)hashValue);
}
static void event(unsigned tag)
{
    // Retain externally visible native call order while keeping camera field reads ordinary reads
    ++calls;word(tag);
}
