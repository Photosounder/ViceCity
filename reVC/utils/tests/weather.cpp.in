extern "C" int myrand(){
    // Supply deterministic raw draws to the complete actual C random-range helpers
    ++randomDraws;randomState=randomState*1664525u+1013904223u;
    if(randomMode==1)return 0;if(randomMode==2)return 255;if(randomMode==3)return 65000;
    if(randomMode==4)return (randomDraws&1)?0:65535;return int(randomState>>16);
}
extern "C" void mysrand(unsigned seed){
    // Preserve the actual random provider's seed conversion
    randomState=seed;
}
extern "C" int32_t DMAudio_CreateEntity(eAudioType type,void *identity){
    // Observe creation of the original weather audio owner and its sentinel identity
    ++creations;event(2);word(type);require(type==AUDIOTYPE_WEATHER && identity==(void*)1);return audioHandle;
}
extern "C" void DMAudio_SetEntityStatus(int32_t handle,uint8_t status){
    // Retain the original success-only audio activation
    event(3);word(handle);word(status);require(handle>=0 && status==1);
}
extern "C" void DMAudio_PlayOneShot(int32_t handle,uint16_t sound,float volume){
    // Observe complete lightning audio arguments at the original scheduled boundary
    event(4);word(handle);word(sound);floating(volume);require(sound==SOUND_LIGHTNING);
}
float CWorld::FindGroundZFor3DCoord(float x,float y,float z,bool *found){
    // Observe the exact captured target/camera position and explicit native output flag
    ++grounds;event(5);floating(x);floating(y);floating(z);*found=groundFound;return 3.25f;
}
bool CWorld::ProcessVerticalLine(const CVector &position,float limit,CColPoint &point,CEntity *&entity,bool buildings,bool vehicles,bool peds,bool objects,bool dummies,bool seeThrough,CStoredCollPoly *poly){
    // Check every original splash collision-filter argument and initialize hit data only on success
    ++verticals;event(6);vector(position);floating(limit);require(limit==-40 && buildings && !vehicles && !peds && !objects && dummies && !seeThrough && !poly);
    if(verticalFound){point.point=CVector(position.x,position.y,4.5f);entity=&target;}return verticalFound;
}
static void particle(tParticleType type,const CVector &position,const CVector &direction,CEntity *entity,float size,int32 rotationSpeed,int32 rotation,int32 frame,int32 lifespan,const RwRGBA *color){
    // Observe all original overload/default arguments and exercise later live camera/weather reads
    ++particles;event(color?8:7);word(type);vector(position);vector(direction);require(!entity);floating(size);word(rotationSpeed);word(rotation);word(frame);word(lifespan);
    if(color){word(color->red);word(color->green);word(color->blue);word(color->alpha);}
    if(hook==1){TheCamera.position.x+=0.125f;TheCamera.Orientation+=0.00390625f;}
    if(hook==2){WeatherTestState value;TestWeather_Read(&value);value.Rain=(particles&1)?0.5f:1.0f;TestWeather_Write(&value);}
}
CParticle *CParticle::AddParticle(tParticleType type,const CVector &position,const CVector &direction,CEntity *entity,float size,int32 rotationSpeed,int32 rotation,int32 frame,int32 lifespan){
    // Retain the complete native uncolored overload with its default argument values
    particle(type,position,direction,entity,size,rotationSpeed,rotation,frame,lifespan,nullptr);return nullptr;
}
CParticle *CParticle::AddParticle(tParticleType type,const CVector &position,const CVector &direction,CEntity *entity,float size,const RwRGBA &color,int32 rotationSpeed,int32 rotation,int32 frame,int32 lifespan){
    // Retain the complete native colored overload and borrowed color value
    particle(type,position,direction,entity,size,rotationSpeed,rotation,frame,lifespan,&color);return nullptr;
}
void CParticle::RemovePSystem(tParticleType type){
    // Observe removal before the original early roof return
    ++removals;event(9);word(type);require(type==PARTICLE_RAINDROP_2D);
}
