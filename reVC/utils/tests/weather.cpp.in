RwRaster *RwTextureGetRaster(const RwTexture *texture){
    // Preserve the original texture-to-raster operation with normalized pointer identity
    event(12);require((const void*)texture==textureIdentity);return reinterpret_cast<RwRaster*>(rasterIdentity);
}
RwBool RwRenderStateSet(RwRenderState state,void *value){
    // Observe every original render-state write and preserve the exact raster identity
    event(13);word(state);if(state==rwRENDERSTATETEXTURERASTER){require(value==rasterIdentity);word(101);}else word(uint32_t(uintptr_t(value)));return 1;
}
void RwIm3DVertexSetPos(RwIm3DVertex *vertex,RwReal x,RwReal y,RwReal z){
    // Write the actual typed vertex coordinates without assuming its platform stride
    vertex->setX(x);vertex->setY(y);vertex->setZ(z);
}
void RwIm3DVertexSetRGBA(RwIm3DVertex *vertex,RwUInt8 red,RwUInt8 green,RwUInt8 blue,RwUInt8 alpha){
    // Retain the original native integer narrowing and color storage
    vertex->setColor(red,green,blue,alpha);
}
void RwIm3DVertexSetU(RwIm3DVertex *vertex,RwReal value){
    // Write the original actual native U coordinate
    vertex->setU(value);
}
void RwIm3DVertexSetV(RwIm3DVertex *vertex,RwReal value){
    // Write the original actual native V coordinate
    vertex->setV(value);
}
void *RwIm3DTransform(RwIm3DVertex *vertices,RwUInt32 count,RwMatrix *matrix,RwUInt32 flags){
    // Observe complete generated geometry and preserve live counts after a native transform callback
    ++transforms;event(14);require(vertices==TempBufferRenderVertices && !matrix && flags==1 && count<=175);word(count);geometry();
    if(hook==3){TempBufferIndicesStored=3;TempBufferRenderIndexList[0]=4;vertices[2].setZ(17.25f);}return transformOK?vertices:nullptr;
}
RwBool RwIm3DRenderIndexedPrimitive(RwPrimitiveType primitive,RwImVertexIndex *indices,RwInt32 count){
    // Observe the post-transform live index count and unchanged original triangle winding
    ++renders;event(15);require(primitive==rwPRIMTYPETRILIST && indices==TempBufferRenderIndexList);word(count);geometry();return 1;
}
RwBool RwIm3DEnd(){
    // Observe completion only for successful native transforms
    ++ends;event(16);return 1;
}
static void resetOwners(){
    // Set only external inputs while retaining all original hidden fractional counters and timers
    TheCamera.position=CVector(10,20,8);TheCamera.forward=CVector(0,1,0);TheCamera.right=CVector(1,0,0);TheCamera.up=CVector(0,0,1);TheCamera.m_RealPreviousCameraPosition=CVector(9,18,7);
    TheCamera.Orientation=0.25f;TheCamera.m_CameraAverageSpeed=0.5f;TheCamera.pTargetEntity=&target;TheCamera.ActiveCam=0;TheCamera.Cams[0].Mode=CAMERA_MODE_FOLLOWPED;
    target.position=CVector(11,22,6);player.position=CVector(1,2,3);speed=CVector(0.125f,-0.25f,0);
    playback=interior=cutscene=playerAir=hasVehicle=roof=forwardView=lrbView=shock=false;playerPresent=true;groundFound=verticalFound=transformOK=framePresent=matrixPresent=true;hook=0;randomMode=0;fog=0;sun=CVector(0,0,1);
    CustomPipes::bRenderingEnvMap=false;CustomPipes::EnvMapCam=cameraIdentity;Timer_timeStep=1;Timer_codePause=Timer_userPause=false;Clock_hours=12;Clock_minutes=30;Clock_seconds=0;SpecialFX_bSnapShotActive=false;
    RsGlobal.width=1280;RsGlobal.height=720;CStats::NoMoreHurricanes=false;
    CullZones_cameraFlags=CullZones_playerFlags=0;
    environment.pos.x=30;environment.pos.y=-40;environment.pos.z=17;environment.right.x=0;environment.right.y=3;environment.right.z=0;environment.up.x=0;environment.up.y=0;environment.up.z=5;
}
int main(){
    // Initialize real typed geometry and compare the original static weather state before any operation
    for(int i=0;i<TEMPBUFFERVERTSIZE;i++){auto &vertex=TempBufferRenderVertices[i];vertex.setX(float(i));vertex.setY(-float(i));vertex.setZ(float(i%7));vertex.setColor(uint8(i),uint8(i+1),uint8(i+2),255);vertex.setU(float(i%3));vertex.setV(float(i%5));}
    for(int i=0;i<TEMPBUFFERINDEXSIZE;i++)TempBufferRenderIndexList[i]=uint16(60000+i);
    for(int i=0;i<1024;i++){CParticle::m_SinTable[i]=float(i%31-15)/16;CParticle::m_CosTable[i]=float(i%37-18)/32;}
    resetOwners();snapshot(100);WeatherTestState original;TestWeather_Read(&original);
    for(int handle:{-1,0,17}){
        // Verify initialization preserves every unrelated canonical scalar and persistent rain record
        ++caseNumber;audioHandle=handle;WeatherTestState state=original;state.Rain=0.75f;state.Wind=1.5f;state.streaks[0]={{1,2,3},{0,0,-12},71};TestWeather_Write(&state);RunWeather_Init();snapshot(101);
    }
    for(int oldType=0;oldType<6;oldType++)for(int newType=0;newType<6;newType++)for(int clockCase=0;clockCase<4;clockCase++)for(int stepCase=0;stepCase<3;stepCase++){
        // Cover interpolation, replay/debug gates, lightning, every wind table pair and fractional updates
        ++caseNumber;resetOwners();Timer_timeMs=1000u+caseNumber*17u;Timer_timeStep=stepCase==0?0.0f:stepCase==1?0.5f:2.5f;
        Clock_hours=uint8_t((clockCase*6+5)%24);Clock_minutes=uint8_t(clockCase*15);Clock_seconds=uint16_t(clockCase*13);playback=bool(clockCase&1);shock=bool(stepCase&1);interior=bool(clockCase&2);cutscene=bool((caseNumber/3)&1);playerAir=bool(caseNumber&1);sun.z=(caseNumber%5)*0.05f;randomMode=caseNumber%5;CStats::NoMoreHurricanes=bool(caseNumber&2);
        WeatherTestState state=original;state.SoundHandle=9;state.OldWeatherType=int16_t(oldType);state.NewWeatherType=int16_t(newType);state.ForcedWeatherType=(caseNumber&1)?WEATHER_RANDOM:WEATHER_HURRICANE;state.WeatherTypeInList=63;state.InterpolationValue=0.95f;state.LightningBurst=bool(caseNumber&1);state.LightningFlash=bool(caseNumber&2);state.LightningStart=1;state.LightningFlashLastChange=1;state.WhenToPlayLightningSound=1;state.LightningDuration=7;TestWeather_Write(&state);
        ++updates;RunWeather_Update();snapshot(102);
    }
    for(int photo=0;photo<2;photo++)for(float interpolation:{0.0f,0.25f,0.49f,0.5f}){
        // Require daylight rainbow coverage and exact suppression of glare randomness during snapshots
        ++caseNumber;resetOwners();playback=interior=cutscene=true;SpecialFX_bSnapShotActive=bool(photo);Timer_timeStep=0;Clock_hours=12;sun.z=0.2f;
        WeatherTestState state=original;state.OldWeatherType=WEATHER_CLOUDY;state.NewWeatherType=WEATHER_EXTRA_SUNNY;state.InterpolationValue=interpolation;TestWeather_Write(&state);unsigned draws=randomDraws;
        ++updates;RunWeather_Update();TestWeather_Read(&state);require(state.Rainbow==(interpolation<0.5f?1.0f-4.0f*fabsf(interpolation-0.25f)/4.0f:0.0f));require(randomDraws-draws==unsigned(interpolation>0 && !photo));snapshot(112);
    }
    for(int mode=0;mode<8;mode++)for(int stepCase=0;stepCase<3;stepCase++){
        // Check no-rain/roof returns before fractional-counter advancement and ongoing steam after rain
        ++caseNumber;resetOwners();Timer_timeMs+=1000;Timer_timeStep=stepCase==0?0:stepCase==1?0.5f:2.0f;Clock_hours=mode<4?12:23;hook=mode;CullZones_cameraFlags=mode==4?ATTRZONE_NORAIN:0;CullZones_playerFlags=mode==5?ATTRZONE_NORAIN:0;hasVehicle=roof=lrbView=bool(mode&1);groundFound=bool(mode&2);verticalFound=bool(mode&1);randomMode=mode%5;
        WeatherTestState state;TestWeather_Read(&state);state.Rain=0.75f;state.Wind=1.5f;TestWeather_Write(&state);++rainCalls;RunWeather_AddRain();snapshot(103);
        TestWeather_Read(&state);state.Rain=0;state.Wind=0;TestWeather_Write(&state);++rainCalls;RunWeather_AddRain();snapshot(104);
    }
    for(int mode=0;mode<8;mode++){
        // Enter all independent particle helpers with original camera modes, target fallbacks and day boundaries
        ++caseNumber;resetOwners();Timer_timeMs+=1000;Clock_hours=uint8_t(mode*3);groundFound=bool(mode&1);TheCamera.pTargetEntity=(mode&2)?nullptr:&target;TheCamera.Cams[0].Mode=mode==0?CAMERA_MODE_TOPDOWN:mode==1?CAMERA_MODE_TOP_DOWN_PED:CAMERA_MODE_FOLLOWPED;forwardView=bool(mode&1);hasVehicle=bool(mode&4);randomMode=mode%5;hook=mode%3;
        ++heatCalls;RunWeather_AddHeatHaze();++beastieCalls;RunWeather_AddBeastie();++splashes;RunWeather_AddSplashesDuringHurricane();++streams;RunWeather_AddStreamAfterRain();snapshot(105);
    }
    for(int reflection=0;reflection<2;reflection++)for(int mode=0;mode<8;mode++)for(uint32_t elapsed:{0u,1u,306u,308u,1024u,2048u,3788u,4096u,4097u}){
        // Compare primary/reflection geometry, exact fade/lifetime boundaries and transform failure/reentry
        ++caseNumber;resetOwners();Timer_timeMs=10000;Timer_timeStep=1;CustomPipes::bRenderingEnvMap=bool(reflection);fog=mode*8;TheCamera.m_CameraAverageSpeed=mode==7?2.0f:0.5f;Timer_codePause=mode==6;transformOK=mode!=5;hook=mode==4?3:0;framePresent=mode!=1;matrixPresent=mode!=2;
        WeatherTestState state=original;state.Rain=mode==3?0.0f:1.0f;state.streaks[0]={{11,22,30},{0,0,-12},Timer_timeMs-elapsed};state.streaks[1]={{-3,9,17},{0,0,0},Timer_timeMs-1024};TestWeather_Write(&state);
        ++streakCalls;RunWeather_RenderRainStreaks();snapshot(106);
    }
    for(int mode=0;mode<4;mode++)for(float distance:{0.0f,7.999f,8.0f,12.0f,16.0f,16.001f}){
        // Exercise the complete billboard helper with both scale choices, pause state and nonzero buffer offsets
        ++caseNumber;resetOwners();Timer_userPause=bool(mode&2);TempBufferIndicesStored=12;TempBufferVerticesStored=5;
        ++helperCalls;RunWeather_RenderOneRainStreak({1,2,3},{0,0,-12},mode==3?255:127,bool(mode&1),distance,{0,1,0},{0,0,1});snapshot(107);require(TempBufferIndicesStored==24 && TempBufferVerticesStored==10);
    }
    for(int16_t type:{int16_t(WEATHER_RANDOM),int16_t(0),int16_t(5)}){
        // Compare every public forcing operation without indexing tables using an invalid type
        ++caseNumber;RunWeather_ForceWeather(type);snapshot(108);RunWeather_ForceWeatherNow(type);snapshot(109);RunWeather_ReleaseWeather();snapshot(110);
    }
#ifdef SECUROM
    // Execute the guarded complete hurricane operation and observe both mutable schedules
    RunWeather_ForceHurricaneWeather();snapshot(111);
#endif
    // Report full canonical, random-stream, particle and geometry equivalence without a graphics device
    printf("states=%u calls=%u random=%u particles=%u removals=%u grounds=%u verticals=%u transforms=%u renders=%u ends=%u shakes=%u creations=%u updates=%u rains=%u streaks=%u helpers=%u heat=%u beasties=%u splashes=%u streams=%u hash=%016llx\n",states,calls,randomDraws,particles,removals,grounds,verticals,transforms,renders,ends,shakes,creations,updates,rainCalls,streakCalls,helperCalls,heatCalls,beastieCalls,splashes,streams,(unsigned long long)hashValue);
}
