#include "owners.h"
#include "entry.h"
#include <inttypes.h>
extern "C" void *NativeContactDefault(void *memory);
extern "C" void NativeContactCopy(void *memory,const CColPoint *source);
static CColPoint staticContacts[3];
static uint64_t hashValue=1469598103934665603ULL;
static unsigned states=0,checks=0;
static uint32_t randomState=0x71a2b3c4;
static void require(bool condition)
{
    // Report the first failed contract without a native error window
    ++checks;if(!condition){fprintf(stderr,"Failure at state %u check %u\n",states,checks);exit(73);}
}
static void observe(const void *value,size_t size)
{
    // Compare initialized observable representations across independent executables
    const unsigned char *p=(const unsigned char*)value;
    for(size_t i=0;i<size;++i){hashValue^=p[i];hashValue*=1099511628211ULL;}
}
static uint32_t nextBits()
{
    // Sequence input generation before using values as function arguments
    randomState=randomState*1664525U+1013904223U;return randomState;
}
static void fill(void *value,size_t size)
{
    // Initialize every explicit field including gap words and depth
    unsigned char *p=(unsigned char*)value;
    for(size_t i=0;i<size;i+=4){uint32_t bits=nextBits();memcpy(p+i,&bits,4);}
}
static void canonical(float &value)
{
    // Normalize arithmetic NaN payloads while retaining finite and signed-zero result bits
    uint32_t bits;memcpy(&bits,&value,4);
    if((bits&0x7f800000U)==0x7f800000U&&(bits&0x007fffffU)){bits=0x7fc00000U;memcpy(&value,&bits,4);}
}
static void normalResult(CColPoint &point)
{
    // Compare complete contact records after canonicalizing only arithmetic normal results
    canonical(point.normal.x);canonical(point.normal.y);canonical(point.normal.z);observe(&point,40);
}
static void lifetimesAndCopies()
{
    // Inspect no-write default construction while the object is alive
    alignas(CColPoint) unsigned char memory[40],expected[40];memset(memory,0xa5,40);memset(expected,0xa5,40);
    CColPoint *value=(CColPoint*)NativeContactDefault(memory);require(value==reinterpret_cast<CColPoint*>(memory)&&memcmp(memory,expected,40)==0);observe(memory,40);value->~CColPoint();++states;
    // Retain zero-filled static contact storage without new initialization writes
    unsigned char zero[120]={0};require(memcmp(staticContacts,zero,120)==0);observe(staticContacts,120);++states;
    // Distinguish selective assignment from full copy construction for arbitrary representations
    for(unsigned test=0;test<4096;++test){
        CColPoint initial,source,actual,model;fill(&initial,40);fill(&source,40);memcpy(&actual,&initial,40);memcpy(&model,&initial,40);
        memcpy(&model.point,&source.point,12);memcpy(&model.normal,&source.normal,12);memcpy(&model.surfaceA,&source.surfaceA,4);
        require(Run_Assign(&actual,&source)==&actual);require(memcmp(&actual,&model,40)==0);observe(&actual,40);
        require(Run_Assign(&actual,&actual)==&actual);require(memcmp(&actual,&model,40)==0);
        memcpy(&actual,&initial,40);Run_Copy(&actual,&source);require(memcmp(&actual,&source,40)==0);observe(&actual,40);
        NativeContactCopy(memory,&source);value=(CColPoint*)memory;require(memcmp(value,&source,40)==0);observe(value,40);value->~CColPoint();++states;
    }
}
static void metadataAndQueries()
{
    // Cover all byte values and stored depth representations while preserving every unrelated field
    for(unsigned test=0;test<65536;++test){
        CColPoint actual,model;fill(&actual,40);memcpy(&model,&actual,40);
        uint8_t a=(uint8_t)test,b=(uint8_t)(test>>8),c=(uint8_t)(test*73+19),d=(uint8_t)(test>>3);uint32_t bits=(test<<16)|test;float depth;memcpy(&depth,&bits,4);
        model.surfaceA=a;model.pieceA=b;model.surfaceB=c;model.pieceB=d;
        Run_Surfaces(&actual,a,b,c,d);require(memcmp(&actual,&model,40)==0);observe(&actual,40);
        memcpy(&model.depth,&depth,4);Run_Set(&actual,depth,a,b,c,d);require(memcmp(&actual,&model,40)==0);observe(&actual,40);
        const void *normal=Run_Normal(&actual);require(normal==&actual.normal&&memcmp(normal,&model.normal,12)==0);
        uint32_t changed=nextBits();memcpy(&actual.normal.x,&changed,4);require(memcmp(normal,&actual.normal,12)==0);observe(normal,12);
        float returned=Run_Depth(&actual);canonical(returned);observe(&returned,4);++states;
    }
}
static void checkNormal(CColPoint &initial)
{
    // Use the actual original vector implementation as an independent numeric reference
    CColPoint actual;memcpy(&actual,&initial,40);CVector expected;memcpy(&expected,&initial.normal,12);bool positive=expected.MagnitudeSqr()>0.0f;expected.Normalise();
    Run_Normalise(&actual);require(memcmp(&actual,&initial,16)==0&&memcmp((unsigned char*)&actual+28,(unsigned char*)&initial+28,12)==0);
    if(!positive)require(actual.normal.x==1.0f&&memcmp(&actual.normal.y,&initial.normal.y,8)==0);
    canonical(expected.x);canonical(expected.y);canonical(expected.z);canonical(actual.normal.x);canonical(actual.normal.y);canonical(actual.normal.z);
    require(memcmp(&actual.normal,&expected,12)==0);normalResult(actual);
    memcpy(&actual,&initial,40);memcpy(&expected,&initial.normal,12);expected*=-1.0f;Run_Reverse(&actual);
    require(memcmp(&actual,&initial,16)==0&&memcmp((unsigned char*)&actual+28,(unsigned char*)&initial+28,12)==0);
    canonical(expected.x);canonical(expected.y);canonical(expected.z);canonical(actual.normal.x);canonical(actual.normal.y);canonical(actual.normal.z);
    require(memcmp(&actual.normal,&expected,12)==0);normalResult(actual);++states;
}
static void normalArithmetic()
{
    // Exercise zero, underflow, overflow, signed-zero, infinity and NaN normalization cases
    const uint32_t special[]={0,0x80000000U,1,0x80000001U,0x3f800000U,0xbf800000U,0x7f7fffffU,0xff7fffffU,0x7f800000U,0xff800000U,0x7fc12345U,0xffc98765U,0x7f812345U};
    for(unsigned x=0;x<13;++x)for(unsigned y=0;y<13;++y)for(unsigned z=0;z<13;++z){
        CColPoint value;fill(&value,40);memcpy(&value.normal.x,&special[x],4);memcpy(&value.normal.y,&special[y],4);memcpy(&value.normal.z,&special[z],4);checkNormal(value);
    }
    // Compare additional arbitrary normal and non-normal field representations
    for(unsigned test=0;test<4096;++test){CColPoint value;fill(&value,40);checkNormal(value);}
}
static CVector nextVector()
{
    // Keep finite geometric inputs independent of argument evaluation order
    int x=(int)(nextBits()%129)-64;int y=(int)(nextBits()%129)-64;int z=(int)(nextBits()%129)-64;
    return CVector(x/8.0f,y/8.0f,z/8.0f);
}
static void suspension()
{
    // Compare the complete original spring function and observe the normal at both force callbacks
    const float steps[]={0,1,2,3,5},ratios[]={-1,0,0.5f,1,2},biases[]={-1,0.5f,1};
    for(unsigned test=0;test<4096;++test){
        CColPoint contact,initial;fill(&contact,40);CVector normal=nextVector();memcpy(&contact.normal,&normal,12);memcpy(&initial,&contact,40);
        CVector direction=test%3==0?CVector(0,0,0):test%3==1?normal:-normal;CVector position=nextVector();
        CPhysical physical;memset(&physical,0xa5,sizeof(physical));physical.m_fMass=(test%17)*100.f;physical.bIsHeavy=(test&1)!=0;physical.observed=&contact;physical.count=0;
        fixtureStep=steps[test%5];float ratio=ratios[(test/5)%5],bias=biases[(test/25)%3];float spring=(test%7)/4.0f;
#ifdef ORIGINAL
        bool result=physical.ApplySpringCollisionAlt(spring,direction,position,ratio,bias,contact.normal);
#else
        bool result=physical.ApplySpringCollisionAlt(spring,direction,position,ratio,bias,contact);
#endif
        require(result&&physical.count==(ratio<1?2U:0U));
        if(ratio>=1)require(memcmp(&contact,&initial,40)==0);
        else{
            CVector expected=normal;if(DotProduct(direction,normal)>0)expected*=-1.0f;
            require(memcmp(&contact.normal,&expected,12)==0&&memcmp(physical.moveNormal,&expected,12)==0&&memcmp(physical.turnNormal,&expected,12)==0);
        }
        require(memcmp(&contact,&initial,16)==0&&memcmp((unsigned char*)&contact+28,(unsigned char*)&initial+28,12)==0);
        observe(&contact,40);observe(&physical.count,sizeof(physical.count));observe(&physical.move,12);observe(&physical.turn,12);observe(&physical.position,12);observe(physical.moveNormal,12);observe(physical.turnNormal,12);++states;
    }
}
static void geometry()
{
    // Compare six actual collision consumers with ordinary, coincident and degenerate inputs
    for(unsigned test=0;test<8192;++test){
        CColSphere a,b;memset(&a,0xa5,20);memset(&b,0x6b,20);CVector ac=nextVector(),bc=nextVector();if(test%13==0)bc=ac;
        a.bounds.center=CollisionVector_FromNative(ac);a.bounds.radius=(test%17)/2.0f;a.surface=19;a.piece=7;
        b.bounds.center=CollisionVector_FromNative(bc);b.bounds.radius=(test%11)/2.0f;b.surface=13;b.piece=5;
        CVector lo=nextVector(),hi=lo+CVector(4,4,4);CColBox box;memset(&box,0x3c,sizeof(box));memcpy(&box.bounds.min,&lo,12);memcpy(&box.bounds.max,&hi,12);box.surface=5;box.piece=9;
        CColLine line;memset(&line,0xa5,sizeof(line));CVector start=nextVector(),end=nextVector();if(test%7==0)end=start;memcpy(&line.p0,&start,12);memcpy(&line.p1,&end,12);
        uint8_t result[6];result[0]=CCollision::TestSphereSphere(a.bounds,b.bounds);result[1]=CCollision::TestSphereBox(a.bounds,box.bounds);result[2]=CCollision::TestLineSphere(line,a);
        CColPoint point;memset(&point,0xa5,sizeof(point));float limit=100.f;result[3]=CCollision::ProcessSphereSphere(a,b,point,limit);canonical(point.point.x);canonical(point.point.y);canonical(point.point.z);canonical(point.depth);normalResult(point);canonical(limit);observe(&limit,4);
        memset(&point,0xa5,sizeof(point));limit=100.f;result[4]=CCollision::ProcessSphereBox(a,box,point,limit);canonical(point.point.x);canonical(point.point.y);canonical(point.point.z);canonical(point.depth);normalResult(point);canonical(limit);observe(&limit,4);
        memset(&point,0xa5,sizeof(point));limit=1.f;result[5]=CCollision::ProcessLineSphere(line,a,point,limit);canonical(point.point.x);canonical(point.point.y);canonical(point.point.z);canonical(point.depth);normalResult(point);canonical(limit);observe(&limit,4);observe(result,6);++states;
    }
}
int main()
{
    // Verify complete ownership, both copy policies, borrowed queries and mutation timing
    lifetimesAndCopies();metadataAndQueries();normalArithmetic();suspension();geometry();printf("states=%u hash=%016" PRIx64 "\n",states,hashValue);return 0;
}
