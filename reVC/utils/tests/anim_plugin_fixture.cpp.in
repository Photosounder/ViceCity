static void playback(void)
{
    // Run complete plugin playback against actual C associations, nodes, frames and hierarchy operations
    for(unsigned test=0;test<512;++test){
        // Provide one real initialized SDK frame for each native skin/render mode
        RwFrame root,frame;strcpy(frame.name,"root");root.children.push_back(&frame);RpSkin skin={1};RpGeometry geometry={&skin};RpAtomic atomic={&geometry};RpHAnimHierarchy nativeHierarchy={};
        RpClump clump;clump.root=&root;clump.skinned=(test&1)!=0;clump.atomic=&atomic;clump.hierarchy=&nativeHierarchy;Run_Init(&clump);
        CAnimBlendHierarchy hierarchies[15]={};CAnimBlendSequence sequences[15];KeyFrameTrans frames[15][3]={};KeyFrameTransCompressed packedFrames[15][3]={};
        bool packed=false;
#ifdef ANIM_COMPRESSION
        // Preserve packed frame dispatch even when rendering is disabled
        packed=(test&2)!=0;
#endif
