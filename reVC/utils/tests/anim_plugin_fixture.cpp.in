        CAnimBlendHierarchy bindingHierarchy={};CAnimBlendSequence bindingSequence;KeyFrame bindingKey={};AnimHierarchy_Init(&bindingHierarchy);AnimSequence_Init(&bindingSequence);strcpy(bindingSequence.name,"root");bindingSequence.numFrames=1;bindingSequence.type=ANIM_KEYFRAME_ROT;bindingSequence.keyFrames=&bindingKey;bindingHierarchy.numSequences=1;bindingHierarchy.sequences=&bindingSequence;
        CAnimBlendAssociation binding;AnimAssociation_Init(&binding);AnimAssociation_BindClump(&binding,&clump,&bindingHierarchy);require(binding.numNodes==test);require(binding.nodes[last-clump.data->frames].sequence==&bindingSequence);AnimAssociation_Destroy(&binding);
        require(destructorCallback(&clump,ClumpOffset,sizeof(void*))==&clump);require(clump.data==NULL);require(alignedMemory.empty());
        // Initialize every supported native skin size and inspect real C frame records and pose pointers
        RpSkin skin={(int)test};RpGeometry geometry={&skin};RpAtomic atomic={&geometry};RpHAnimHierarchy hierarchy={};
        for(unsigned i=0;i<64;++i)hierarchy.nodes[i].id=(int)i;
        clump.skinned=true;clump.atomic=&atomic;clump.hierarchy=&hierarchy;Run_Init(&clump);require(clump.data->numFrames==(int)test);
        for(unsigned i=0;i<test;++i){AnimBlendFrameData *frame=&clump.data->frames[i];require(frame->nodeID==(int)i);require(frame->hanimFrame==&hierarchy.poses[i]);require(frame->resetPos.y==-(float)i*.25f);require(Run_FindBone(&clump,i)==frame);record(frame->flag);recordFloat(frame->resetPos.x);recordFloat(frame->resetPos.y);recordFloat(frame->resetPos.z);}
        require(Run_FindBone(&clump,0xFFFFFFFFU)==NULL);require(Run_FindFrame(&clump,"ROOT")==&clump.data->frames[0]);
