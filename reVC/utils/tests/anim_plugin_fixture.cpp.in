static void removalAndReentry(void)
{
    // Exercise real masked deletion and global lookup reentry without replacing either plugin algorithm
    for(unsigned test=0;test<256;++test){
        // Allocate actual plugin ownership and heap associations with tracked real node arrays
        RpClump clump;Run_Allocate(&clump);require(clump.data&&!Run_Initialized(&clump));uint32_t mask=test%4==0?0:test%4==1?0x8000U:test%4==2?0xFFFFFFFFU:ASSOC_PARTIAL;
        bool removed[8];for(unsigned i=0;i<8;++i){
            // Include signed association flag patterns and zero-mask removal semantics
            CAnimBlendAssociation *association=(CAnimBlendAssociation*)malloc(sizeof(CAnimBlendAssociation));AnimAssociation_Init(association);association->numNodes=1;association->animId=(int16_t)i;association->flags=(int16_t)(test*311+i*17);AnimAssociation_AllocateAnimBlendNodeArray(association,1);AnimBlendLink_Prepend(&clump.data->link,&association->link);
            removed[i]=mask==0||(((uint32_t)(int32_t)association->flags&mask)!=0);
        }
        Run_Remove(&clump,mask,false);int next=7;
        for(CAnimBlendLink *link=clump.data->link.next;link;link=link->next){
            // Check survivor order independently of the removal loop's cached next pointer
            while(next>=0&&removed[next])--next;require(next>=0);CAnimBlendAssociation *association=AnimAssociation_FromLink(link);require(association->animId==next);record((unsigned)next);--next;
        }
        while(next>=0&&removed[next])--next;require(next==-1);Run_Remove(&clump,0,true);require(clump.data->link.next==NULL);destructorCallback(&clump,ClumpOffset,sizeof(void*));require(alignedMemory.empty());
    }
    // Preserve the original shared search-result state when a native name getter reenters another lookup
    RwFrame rootA,rootB,frameA,frameB;strcpy(frameA.name,"unmatched");strcpy(frameB.name,"target");rootA.children.push_back(&frameA);rootB.children.push_back(&frameB);RpClump a,b;a.root=&rootA;b.root=&rootB;Run_Init(&a);Run_Init(&b);
    searchReentryTarget=&b;require(Run_FindFrame(&a,"absent")==&b.data->frames[0]);searchReentryTarget=NULL;require(Run_FindFrame(&a,"absent")==NULL);
    destructorCallback(&a,ClumpOffset,sizeof(void*));destructorCallback(&b,ClumpOffset,sizeof(void*));require(alignedMemory.empty());
}
static void queries(void)
{
    // Compare all association query policies, strict blend ties, masks and untouched null-owner outputs
    for(unsigned test=0;test<4096;++test){
        // Populate actual initialized associations and their original linked-list order
        RpClump clump;CAnimBlendClumpData data;AnimBlendClump_Init(&data);clump.data=&data;data.numFrames=(test&1)?1:0;CAnimBlendAssociation associations[8];
        for(unsigned i=0;i<8;++i){memset(&associations[i],0,sizeof(associations[i]));AnimAssociation_Init(&associations[i]);associations[i].animId=(int16_t)(i%3);associations[i].flags=(int16_t)((test>>(i%4))&255);associations[i].blendAmount=(float)((test+i)%5)*.25f;AnimBlendLink_Prepend(&data.link,&associations[i].link);}
        uint32_t mask=(test%4)==0?0:(test%4)==1?ASSOC_PARTIAL:(test%4)==2?0xFFFFFFFFU:ASSOC_MOVEMENT;
        for(unsigned op=0;op<10;++op){
            // Encode selected owner identities and optional out-parameters without assuming pointer addresses
            CAnimBlendAssociation *second=(CAnimBlendAssociation*)(uintptr_t)1;float blend=-3;CAnimBlendAssociation *value=Run_Query(op,&clump,&associations[4],mask,(int)(test%11)-2,&second,&blend);unsigned identity=9;for(unsigned i=0;i<8;++i)if(value==&associations[i])identity=i;record(identity);if(op==4){unsigned other=9;for(unsigned i=0;i<8;++i)if(second==&associations[i])other=i;record(other);recordFloat(blend);}
        }
        Run_Deltas(&clump,mask,.375f);for(auto &association:associations)recordFloat(association.blendDelta);
        clump.data=NULL;CAnimBlendAssociation *second=(CAnimBlendAssociation*)(uintptr_t)1;float blend=-3;require(Run_Query(4,&clump,NULL,mask,0,&second,&blend)==NULL);require(second==(CAnimBlendAssociation*)(uintptr_t)1&&blend==-3);
    }
}
static void onDelete(CAnimBlendAssociation *association,void*)
{
    // Observe callback execution before the actual association releases its node array and link
    require(association->nodes&&alignedMemory.count(association->nodes)==1);++deletionCallbacks;record(500);
