    RpClump clump;clump.data=(CAnimBlendClumpData*)(uintptr_t)1;require(constructorCallback(&clump,ClumpOffset,sizeof(void*))==&clump);require(clump.data==NULL);
    require(copyCallback(&clump,&clump,ClumpOffset,sizeof(void*))==NULL);require(destructorCallback(&clump,ClumpOffset,sizeof(void*))==&clump);require(clump.data==NULL);
    // Require construction to use the SDK-provided offset independently of the registered global slot
