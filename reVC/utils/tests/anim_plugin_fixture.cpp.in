        if(packed)clump.data->frames[0].flag|=ANIM_FRAME_COMPRESSED;
        if(packed||(test&4))clump.data->frames[0].flag|=ANIM_FRAME_VELOCITY_EXTRACTION_3D;
        for(unsigned step=0;step<3;++step){
            // Preserve valid native storage dimensionality for each real offscreen and packed callback path
            bool render=(test&4)||((test+step)&1);if(packed||(test&4))clump.data->velocity3d=&velocity3;else if(!render&&!clump.skinned)clump.data->velocity2d=NULL;else clump.data->velocity2d=&velocity2;
            Run_Update(&clump,.375f,render);++playbackSteps;record(clump.data->frames[0].flag);record(objectUpdates);record(uncompressCalls);
            for(CAnimBlendLink *link=clump.data->link.next;link;link=link->next){
                // Compare every remaining actual association after callbacks, node accumulation and time updates
                CAnimBlendAssociation *association=AnimAssociation_FromLink(link);record((unsigned)association->animId);record((unsigned)association->flags);recordFloat(association->blendAmount);recordFloat(association->blendDelta);recordFloat(association->timeStep);recordFloat(association->currentTime);record((unsigned)association->callbackType);
                record((unsigned)association->nodes[0].frameA);record((unsigned)association->nodes[0].frameB);recordFloat(association->nodes[0].remainingTime);
            }
            recordFloat(velocity2.x);recordFloat(velocity2.y);recordFloat(velocity3.x);recordFloat(velocity3.y);recordFloat(velocity3.z);
            RwV3d position=clump.skinned?nativeHierarchy.poses[0].t:frame.matrix.pos;recordFloat(position.x);recordFloat(position.y);recordFloat(position.z);
