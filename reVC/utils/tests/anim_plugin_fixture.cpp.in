        for(unsigned i=0;i<count;++i){
            // Bind actual three-keyframe sequences and allow the real blend owner to delete faded instances
            AnimHierarchy_Init(&hierarchies[i]);strcpy(hierarchies[i].name,"fixture");hierarchies[i].totalLength=1.0f;hierarchies[i].keepCompressed=packed;hierarchies[i].numSequences=1;hierarchies[i].sequences=&sequences[i];
            AnimSequence_Init(&sequences[i]);sequences[i].type=ANIM_KEYFRAME_ROT|ANIM_KEYFRAME_TRANS;sequences[i].numFrames=3;sequences[i].keyFrames=frames[i];sequences[i].keyFramesCompressed=packedFrames[i];
            for(unsigned k=0;k<3;++k){
