int main(void)
{
    // Execute the complete producer's registration, frame hierarchy and association query boundaries
    registration();hierarchies();queries();removalAndReentry();playback();require(heapAllocations==heapFrees);printf("queries=4096 hierarchies=128 removals=256 playback=%u checks=%u registrations=%u enumerations=%u allocations=%u delete=%u finish=%u hash=%016llx\n",playbackSteps,checks,registrationCalls,enumerations,heapAllocations,deletionCallbacks,finishCallbacks,(unsigned long long)digest);return 0;
