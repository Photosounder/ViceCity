        RpClump clump;clump.root=&root;Run_Init(&clump);require(clump.data&&clump.data->numFrames==(int)test);require(Run_Initialized(&clump));
        AnimBlendFrameData *indexed[64]={};Run_Fill(&clump,indexed);
