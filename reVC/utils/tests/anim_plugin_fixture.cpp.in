                frames[i][k].base.rotation=Quaternion_Make(.1f,.2f,0,.9f);frames[i][k].base.deltaTime=k==0?0.0f:.5f;frames[i][k].translation={(float)k*.25f,(float)k*.5f,(float)i*.025f};
                KeyFrameCompressed_SetRotation(&packedFrames[i][k].base,&frames[i][k].base.rotation);KeyFrameCompressed_SetTime(&packedFrames[i][k].base,frames[i][k].base.deltaTime);KeyFrameVectorRef ref={&frames[i][k].translation.x,&frames[i][k].translation.y,&frames[i][k].translation.z};KeyFrameTransCompressed_SetTranslation(&packedFrames[i][k],ref);
            }
            CAnimBlendAssociation *association=(CAnimBlendAssociation*)malloc(sizeof(CAnimBlendAssociation));AnimAssociation_Init(association);association->numNodes=1;association->hierarchy=&hierarchies[i];association->animId=(int16_t)i;association->blendAmount=.25f*(1+i%4);association->speed=1.0f+(float)i*.125f;
            association->flags=ASSOC_RUNNING|ASSOC_HAS_TRANSLATION|((i%3)==0?ASSOC_MOVEMENT:0)|((i%4)==0?ASSOC_PARTIAL:0)|((test&8)?ASSOC_REPEAT:0);
            AnimAssociation_AllocateAnimBlendNodeArray(association,1);association->nodes[0].association=association;association->nodes[0].sequence=&sequences[i];association->nodes[0].frameA=1;association->nodes[0].frameB=0;association->nodes[0].remainingTime=.5f;
            if(packed)AnimBlendNode_CalcDeltasCompressed(&association->nodes[0]);else AnimBlendNode_CalcDeltas(&association->nodes[0]);
            if(i==0&&(test&16)){association->blendAmount=.1f;association->blendDelta=-2;association->flags|=ASSOC_DELETEFADEDOUT;AnimAssociation_SetDeleteCallback(association,onDelete,NULL);}else AnimAssociation_SetFinishCallback(association,onFinish,NULL);
