        bindingSequence.boneTag=0;AnimAssociation_Init(&binding);AnimAssociation_BindClump(&binding,&clump,&bindingHierarchy);require(binding.nodes[0].sequence==&bindingSequence);AnimAssociation_Destroy(&binding);
