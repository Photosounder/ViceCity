static void observe(const void *value,size_t size)
{
    // Compare initialized observable values without hashing native addresses
    const unsigned char *p=(const unsigned char*)value;for(size_t i=0;i<size;++i){hashValue^=p[i];hashValue*=1099511628211ULL;}
}
static void observeFloat(float value)
{
