    memset(memory,0xa5,sizeof(CAnimBlendHierarchy));Run_Hierarchy(0,memory,NULL,false);CAnimBlendHierarchy *h=(CAnimBlendHierarchy*)memory;require(h->sequences==NULL&&h->numSequences==0&&!h->compressed&&h->totalLength==0&&h->linkPtr==NULL);memset(h->name,0xa5,24);h->keepCompressed=false;observedHierarchy=h;eventCount=0;return h;
}
static void eventsResult()
{
    // Observe native cache and memory operations after checking their live hierarchy state
    observe(events,eventCount*4);eventCount=0;
}
static void lifetimeAndNames()
