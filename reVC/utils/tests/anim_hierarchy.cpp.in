static void sequenceValues(CAnimBlendHierarchy *h)
{
    // Compare the actual sequence fields and initialized buffers after hierarchy operations
    for(int i=0;i<h->numSequences;++i){CAnimBlendSequence *s=&h->sequences[i];observe(&s->type,4);observe(&s->numFrames,4);if(s->keyFrames)observe(s->keyFrames,s->numFrames*(s->type&2?32:20));if(s->keyFramesCompressed)observe(s->keyFramesCompressed,s->numFrames*(s->type&2?16:10));}
}
static void ownedStorageAndCache()
{
    // Exercise real compression configurations, known and unknown total lengths, and linked cache cleanup
    for(unsigned test=0;test<4096;++test){alignas(CAnimBlendHierarchy) unsigned char memory[sizeof(CAnimBlendHierarchy)];CAnimBlendHierarchy *h=initialize(memory);
#ifdef ANIM_COMPRESSION
        bool packed=true;
#else
        bool packed=false;
