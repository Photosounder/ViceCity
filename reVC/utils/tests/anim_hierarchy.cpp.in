    for(unsigned operation=7;operation<=8;++operation){alignas(CAnimBlendHierarchy) unsigned char memory[sizeof(CAnimBlendHierarchy)];CAnimBlendHierarchy *h=initialize(memory);h->compressed=operation==8;h->totalLength=1.0f;Run_Hierarchy(operation,h,NULL,false);
