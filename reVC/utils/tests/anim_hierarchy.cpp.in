        alignas(CAnimBlendHierarchy) unsigned char memory[sizeof(CAnimBlendHierarchy)];CAnimBlendHierarchy *h=initialize(memory);CAnimBlendSequence sequences[4];Frames frames[4];h->sequences=sequences;h->numSequences=(int16_t)(test%5);h->keepCompressed=(test&1)!=0;
        for(unsigned channel=0;channel<4;++channel){AnimSequence_Init(&sequences[channel]);bool translation=((test+channel)&1)!=0;sequences[channel].type=translation?3:1;sequences[channel].numFrames=(int32_t)((test+channel)%8);sequences[channel].keyFrames=translation?(void*)&frames[channel].trans[1]:&frames[channel].basic[1];sequences[channel].keyFramesCompressed=translation?(void*)&frames[channel].packedTrans[1]:&frames[channel].packed[1];
            // Include signed zero, infinities, NaNs and all packed narrowing boundaries in actual hierarchy time conversion
            for(unsigned key=0;key<9;++key){KeyFrame *f=translation?&frames[channel].trans[key].base:&frames[channel].basic[key];KeyFrameCompressed *p=translation?&frames[channel].packedTrans[key].base:&frames[channel].packed[key];uint32_t time=bits[(test+channel+key)%8];memcpy(&f->deltaTime,&time,4);float sign=((test+key)&1)?-1.0f:1.0f;f->rotation=Quaternion_Make(sign*0.2f,sign*0.3f,sign*0.4f,sign*0.5f);p->deltaTime=(int16_t)(test*19U+channel*103U+key*7301U);}
        }
        Run_Hierarchy(packed?4:3,h,NULL,false);if(!packed)Run_Hierarchy(5,h,NULL,false);hierarchyResult(h);
        for(unsigned channel=0;channel<4;++channel)for(unsigned key=0;key<9;++key){bool translation=sequences[channel].type&2;KeyFrame *f=translation?&frames[channel].trans[key].base:&frames[channel].basic[key];KeyFrameCompressed *p=translation?&frames[channel].packedTrans[key].base:&frames[channel].packed[key];observeFloat(f->deltaTime);observe(&f->rotation,16);observe(&p->deltaTime,2);}require(eventCount==0);++states;
    }
}
static void createSequences(CAnimBlendHierarchy *h,unsigned test,bool packed)
{
