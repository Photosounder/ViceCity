    h->numSequences=(int16_t)(test%5);h->sequences=(CAnimBlendSequence*)malloc(sizeof(CAnimBlendSequence)*h->numSequences);require(h->sequences||h->numSequences==0);h->keepCompressed=(test&8)!=0;
    for(int i=0;i<h->numSequences;++i){CAnimBlendSequence *s=&h->sequences[i];AnimSequence_Init(s);bool translation=((test+i)&1)!=0;int count=(int)((test+i)%4)+1;AnimSequence_SetNumFrames(s,count,translation,packed);
        // Supply safe packed-domain values and real original keyframe strides
        for(int key=0;key<count;++key){if(packed){KeyFrameCompressed *f=AnimSequence_GetKeyFrameCompressed(s,key);f->rot[0]=512;f->rot[1]=-1024;f->rot[2]=1536;f->rot[3]=2048;f->deltaTime=(int16_t)(key*15);if(translation){KeyFrameTransCompressed *t=(KeyFrameTransCompressed*)f;t->trans[0]=(int16_t)key;t->trans[1]=123;t->trans[2]=-456;}}else{KeyFrame *f=AnimSequence_GetKeyFrame(s,key);float sign=(key&1)?-1.0f:1.0f;f->rotation=Quaternion_Make(sign*.125f,sign*.25f,sign*.375f,sign*.5f);f->deltaTime=key*.25f;if(translation)((KeyFrameTrans*)f)->translation={(float)key,.5f,-.25f};}}
    }
