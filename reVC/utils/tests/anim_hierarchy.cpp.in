    // Preserve startup state without adding a C++ static constructor or an initialization reset at game startup
    for(unsigned i=0;i<7;++i){CAnimBlendHierarchy *h=&staticHierarchies[i];require(h->sequences==NULL&&h->numSequences==0&&!h->compressed&&!h->keepCompressed&&h->totalLength==0&&h->linkPtr==NULL);unsigned char zero[24]={0};require(memcmp(h->name,zero,24)==0);hierarchyResult(h);}++states;
