static void hierarchyResult(CAnimBlendHierarchy *h)
{
    // Observe all named fields independently of the original record padding
    observe(h->name,24);observe(&h->numSequences,2);observe(&h->compressed,1);observe(&h->keepCompressed,1);observeFloat(h->totalLength);bool sequence=h->sequences!=NULL,link=h->linkPtr!=NULL;observe(&sequence,1);observe(&link,1);require(Run_IsCompressed(h)==h->compressed);
