        createSequences(h,test,packed);h->totalLength=(test&2)?1.25f:0.0f;h->compressed=packed;h->linkPtr=(test&4)?CLinkList_Insert(&CAnimManager::ms_animCache,h):NULL;Run_Hierarchy(7,h,NULL,false);require(!h->compressed);hierarchyResult(h);sequenceValues(h);
        Run_Hierarchy(8,h,NULL,false);require(h->compressed);hierarchyResult(h);sequenceValues(h);unsigned before=eventCount;Run_Hierarchy(1,h,NULL,false);require(h->sequences==NULL&&h->numSequences==0&&!h->compressed&&h->totalLength==0&&h->linkPtr==NULL&&CLinkList_Count(&CAnimManager::ms_animCache)==0);require(events[before]==7);
