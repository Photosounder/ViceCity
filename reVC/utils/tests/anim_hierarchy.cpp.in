struct Frames {KeyFrame basic[9];KeyFrameTrans trans[9];KeyFrameCompressed packed[9];KeyFrameTransCompressed packedTrans[9];};
static void timeAndSignPolicy()
{
    // Cover empty sequences with a valid preceding record so both original classic and fixed policies remain defined
