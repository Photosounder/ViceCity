        RwFrame frame;fill(&frame.matrix,64);RpHAnimStdInterpFrame skin;memset(&skin,0x5a,sizeof(skin));AnimBlendFrameData data;data.flag=test&15;data.frame=&frame;data.hanimFrame=&skin;data.resetPos=CVector(0.5f,-1.25f,0.3f);AnimBlendFrameUpdateData update={(test&128)!=0,pointers};CVector2D velocity2(0.125f,-0.5f);CVector velocity3(0.25f,-0.5f,0.75f);CAnimBlendClumpData clump;clump.velocity2d=((test&256)&&(which==0||which==3||which>=6))?NULL:&velocity2;clump.velocity3d=&velocity3;gpAnimBlendClump=&clump;callbacks[which](&data,&update);matrixResult(frame.matrix);vectorResult(skin.q.imag);float real=skin.q.real;canonical(real);observe(&real,4);vectorResult(skin.t);canonical(velocity2.x);canonical(velocity2.y);observe(&velocity2,8);vectorResult(velocity3);
        for(unsigned channel=0;channel<2;++channel){
            // Observe complete animation state without comparing implementation-owned pointer values
            require(pointers[channel]==nodes[channel]||pointers[channel]==nodes[channel]+1);unsigned advanced=(unsigned)(pointers[channel]-nodes[channel]);observe(&advanced,4);CAnimBlendNode &node=nodes[channel][0];canonical(node.theta);canonical(node.invSin);observe(&node.theta,20);observe(sequences[channel].keyFrames,(test&16)?sizeof(frames[channel]):3*sizeof(KeyFrame));observe(sequences[channel].keyFramesCompressed,(test&16)?sizeof(packed[channel]):3*sizeof(KeyFrameCompressed));
        }
        ++states;
    }
}
int main()
{
    // Compare complete node ownership, lazy reads and every actual native frame callback
    lifetimesAndInit();directMethods();lazyReads();animation();printf("states=%u checks=%u hash=%016" PRIx64 "\n",states,checks,hashValue);return 0;
