        CAnimBlendSequence sequences[2];KeyFrameTrans frames[2][3];KeyFrameTransCompressed packed[2][3];KeyFrame rotations[2][3];KeyFrameCompressed packedRotations[2][3];CAnimBlendAssociation associations[2];CAnimBlendNode nodes[2][2];CAnimBlendNode *pointers[3]={nodes[0],nodes[1],NULL};
        for(unsigned channel=0;channel<2;++channel){
            // Supply initialized keyframes with alternating quaternion signs and safe packed ranges
            for(unsigned key=0;key<3;++key){
                float sign=((test+channel+key)&1)?-1.0f:1.0f;frames[channel][key].base.rotation=Quaternion_Make(sign*0.1f*(key+1),sign*0.2f,sign*0.3f,sign*0.8f);frames[channel][key].base.deltaTime=0.25f+key*0.125f;CVector framePosition((float)key+channel,-0.3f*(key+1),0.2f*(key+1));frames[channel][key].translation=KeyFrame_FromNative(framePosition);KeyFrameCompressed_SetRotation(&packed[channel][key].base,&frames[channel][key].base.rotation);KeyFrameCompressed_SetTime(&packed[channel][key].base,frames[channel][key].base.deltaTime);KeyFrameTransCompressed_SetTranslation(&packed[channel][key],KeyFrame_VectorRef(framePosition));
            }
            sequences[channel].type=CAnimBlendSequence::KF_ROT|((test&16)?CAnimBlendSequence::KF_TRANS:0);sequences[channel].numFrames=3;sequences[channel].keyFrames=frames[channel];sequences[channel].keyFramesCompressed=packed[channel];
            // Keep rotation-only fixture arrays at the correct original record stride
            if(!(test&16)){
                for(unsigned k=0;k<3;++k){rotations[channel][k]=frames[channel][k].base;packedRotations[channel][k]=packed[channel][k].base;}sequences[channel].keyFrames=rotations[channel];sequences[channel].keyFramesCompressed=packedRotations[channel];
            }
            sequences[channel].RemoveQuaternionFlips();associations[channel].blendAmount=(test&32)?0.7f:0.25f;associations[channel].timeStep=(test&64)?0.6f:0.05f;associations[channel].flags=(int16_t)((test+channel*7)&255);
            Run_Init(&nodes[channel][0]);nodes[channel][0].sequence=&sequences[channel];nodes[channel][0].association=&associations[channel];nodes[channel][0].frameA=1;nodes[channel][0].frameB=0;nodes[channel][0].remainingTime=0.2f;Run_Method(6,&nodes[channel][0],NULL,NULL,0);Run_Init(&nodes[channel][1]);
            // Exercise compressed sign correction and actual scalar interpolation before frame accumulation
            CVector translation;CQuaternion rotation;Run_Method(7,&nodes[channel][0],NULL,NULL,0);Run_Method(1,&nodes[channel][0],&translation,&rotation,0.75f);result(rotation);vectorResult(translation);nodes[channel][0].remainingTime=0.2f;nodes[channel][0].frameA=1;nodes[channel][0].frameB=0;Run_Method(6,&nodes[channel][0],NULL,NULL,0);
        }
