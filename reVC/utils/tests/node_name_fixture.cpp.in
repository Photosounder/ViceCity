        for(unsigned i=0;i<sizeof(target);++i){unsigned char value=0xd7;if(i>=(unsigned)offset&&i<(unsigned)offset+23)value=i<(unsigned)offset+length?source.bytes[i]:0;require(target.bytes[i]==value);}require(sizeObject(&source,99,-3)==(int32_t)length);hashBytes(&target,sizeof(target));
