static void script(uint16_t a,uint16_t b=0,uint16_t c=2,uint16_t d=3,uint16_t e=0x0d)
{
    // Supply a deterministic selection/retry sequence followed by independent glitch values
    randomRead=0;randomCount=5;randomValues[0]=a;randomValues[1]=b;randomValues[2]=c;randomValues[3]=d;randomValues[4]=e;
}
static void reset(unsigned seed)
{
    // Seed every real field and retained native buffer byte with valid deterministic values
    hook=0;triggered=false;cameraVisible=framePresent=matrixPresent=transformSuccess=true;secondMatrix=signStarted=false;projectMode=0;matrixQueries=0;nearClip=.1f;farClip=200.f;randomRead=randomCount=0;randomState=1234567+seed;clockHours=clockMinutes=0;gpCoronaTexture[0]=(RwTexture *)0x1000;TestSc_SetEvent(seed%3);ScrollBarVector first={10.f,20.f,30.f},last={10.f,42.f,34.f};TestSc_Init(first,last,0,123,197,251,.3f);ScrollBar v=TestSc_Get();v.m_fIntensity=.75f;for(int i=0;i<40;i++)v.m_MessageBar[i]=(uint8_t)((i+seed)%4==0?31:((i+seed)%4==1?5:0));TestSc_Set(&v);TheCamera.position=CVector(10.f,20.f,30.f);
    for(int i=0;i<2;i++){
        // Include a different second camera matrix and nonorthogonal normalized axes
        matrices[i].pos.x=10.f+i;matrices[i].pos.y=20.f-i;matrices[i].pos.z=20.f;matrices[i].right.x=1.f;matrices[i].right.y=.1f;matrices[i].right.z=0.f;matrices[i].up.x=.1f;matrices[i].up.y=1.f;matrices[i].up.z=.2f;matrices[i].at.x=0.f;matrices[i].at.y=0.f;matrices[i].at.z=2.f;
    }
    for(int i=0;i<512;i++){
        // Initialize stale native fields so any unintended overwrite remains observable
        RwIm3DVertex &v=TempBufferRenderVertices[i];v.setX(i*.125f);v.setY(-i*.25f);v.setZ(17.f);v.setColor(13,27,41,55);v.setU(.25f);v.setV(.75f);
    }
    for(int i=0;i<1024;i++)TempBufferRenderIndexList[i]=(uint16_t)((i*7+seed)&65535);TempBufferVerticesStored=3;TempBufferIndicesStored=3;RenderBuffer_VerticesToBeStored=7;RenderBuffer_IndicesToBeStored=11;
}
int main(void)
{
    // Compare static initialization before capturing each module's actual message literals
    snapshot();reset(0);snapshot();for(int kind=1;kind<9;kind++){
        // Capture all event, ticket, stadium and mutable-time messages through real updates
        ScrollBar v=TestSc_Get();v.m_pMessage=messages[0];v.m_MessageLength=2;v.m_MessageCurrentChar=1;v.m_Counter=7;TestSc_Set(&v);int option=kind<=3?0:kind<=6?1:kind==7?2:3;TestSc_SetEvent(kind<=3?kind-1:kind<=6?kind-4:0);script((uint16_t)option);update();require(messageId(TestSc_Get().m_pMessage)==kind);
    }
    require(strcmp(TestSc_Time(),"THE TIME IS 13:39    ")==0);
    for(int previous=0;previous<9;previous++)for(int stadium=-1;stadium<4;stadium++)for(int option=0;option<4;option++){
        // Exercise literal-identity repeats, invalid events and repeated mutable-time selection
        reset(previous*17+stadium+2);ScrollBar v=TestSc_Get();v.m_pMessage=messages[previous];v.m_MessageLength=(uint32_t)strlen(v.m_pMessage);v.m_MessageCurrentChar=v.m_MessageLength-1;v.m_Counter=7;TestSc_Set(&v);TestSc_SetEvent(stadium);script((uint16_t)option,(uint16_t)option);update();require(TestSc_Get().m_pMessage!=messages[previous]);
    }
    // Equal text at a different address must accept selection without another retry draw
    reset(0);strcpy(externalMessage,messages[1]);ScrollBar duplicate=TestSc_Get();duplicate.m_pMessage=externalMessage;duplicate.m_MessageLength=(uint32_t)strlen(externalMessage);duplicate.m_MessageCurrentChar=duplicate.m_MessageLength-1;duplicate.m_Counter=7;TestSc_Set(&duplicate);TestSc_SetEvent(0);script(0);update();require(TestSc_Get().m_pMessage==messages[1] && randomRead==2);
    const uint16_t glitches[]={0,0x0d,0xe3,0x64};
    for(int glyph=0;glyph<59;glyph++)for(int column=0;column<8;column++)for(int glitch=0;glitch<4;glitch++){
        // Cover every glyph column, blank spacing and all three intentional display glitches
        reset(glyph);externalMessage[0]=(char)(' '+glyph);externalMessage[1]=0;ScrollBar v=TestSc_Get();v.m_pMessage=externalMessage;v.m_MessageLength=1;v.m_MessageCurrentChar=0;v.m_Counter=(uint8_t)((column+7)%8);v.m_Type=255;TestSc_Set(&v);script(glitches[glitch]);update();
    }
    const float distances[]={0.f,74.99999f,75.f,75.00001f,99.99999f,100.f,100.00001f};
    for(int distance=0;distance<7;distance++)for(int counter=0;counter<256;counter+=17){
        // Check strict fade/culling boundaries and byte-promotion before modulo reduction
        reset(counter);TheCamera.position.x+=distances[distance];ScrollBar v=TestSc_Get();v.m_Counter=(uint8_t)counter;if(counter==255)v.m_MessageCurrentChar=0xffffffffU;TestSc_Set(&v);update();
    }
    for(int distance=0;distance<7;distance++)for(int mode=0;mode<3;mode++)for(int visible=0;visible<2;visible++){
        // Preserve the absent visibility gate and partial projection failures in the main pass
        reset(distance);cameraVisible=visible!=0;projectMode=mode;TheCamera.position.x+=distances[distance];update();renderMain();TestSc_Visibility(visible!=0);require(TestSc_Visible()==(visible!=0));snapshot();
    }
    for(int mode=0;mode<12;mode++)for(int transform=0;transform<2;transform++){
        // Cover optional camera gates, changed second matrix, zero axes and strict depth clipping
        reset(mode);transformSuccess=transform!=0;ScrollBar v=TestSc_Get();for(int i=0;i<40;i++)v.m_MessageBar[i]=31;TestSc_Set(&v);if(mode==1)gpCoronaTexture[0]=NULL;if(mode==2)framePresent=false;if(mode==3)matrixPresent=false;if(mode==4)secondMatrix=true;if(mode==5){matrices[0].right.x=matrices[0].right.y=matrices[0].right.z=0;matrices[0].up.x=matrices[0].up.y=matrices[0].up.z=0;matrices[0].at.x=matrices[0].at.y=matrices[0].at.z=0;}if(mode==6)nearClip=10.f;if(mode==7)farClip=10.f;if(mode>=8)matrices[0].pos.x+=distances[mode-5];renderEnv(mode==0?NULL:(void *)0x5000);
    }
    for(int h=1;h<=15;h++){
        // Change live state at native call boundaries and exercise nested same-sign rendering
        reset(h);hook=h;if(h==11){ScrollBar v=TestSc_Get();v.m_Counter=7;v.m_MessageCurrentChar=v.m_MessageLength-1;TestSc_Set(&v);script(0);update();require(triggered);}else if(h==6 || h==7 || h==8 || h==9 || h==14){ScrollBar v=TestSc_Get();for(int i=0;i<40;i++)v.m_MessageBar[i]=31;TestSc_Set(&v);renderEnv();
#ifdef REVC_SOFTWARE_POLYGONS
        require(triggered);
#endif
        }else if(h!=10 && h!=12){renderMain();require(triggered);}
    }
    reset(0);externalMessage[0]='A';externalMessage[1]=0;ScrollBar v=TestSc_Get();v.m_pMessage=externalMessage;v.m_MessageLength=1;v.m_Type=255;TestSc_Set(&v);uint8_t saved=TestSc_Glyph(33,1);TestSc_SetGlyph(33,1,(uint8_t)~saved);update();TestSc_SetGlyph(33,1,saved);snapshot();
    for(unsigned frame=0;frame<5000;frame++){
        // Sustain real message cycles with changing events, visibility, fades and both render passes
        if(frame==0)reset(23);TestSc_SetEvent(frame%3);TheCamera.position.x=10.f+(frame%131);update();if(frame%47==0)renderMain();if(frame%97==0)renderEnv();
    }
    printf("states=%u calls=%u updates=%u renders=%u reflections=%u projects=%u sprites=%u transforms=%u draws=%u randoms=%u hash=%016llx\n",states,calls,updates,renders,reflections,projects,sprites,transforms,draws,randoms,(unsigned long long)hash);return 0;
}
