void TestSF_Push(const char *name)
{
    // Preserve the original reflection profiling label and pending-flush position
    event(19);bytes(name);require(strcmp(name,"CScrollBar::RenderForEnvMap")==0);signStarted=true;
}
void TestSF_Pop(void)
{
    // Complete the original profiling group after all state restoration
    event(20);signStarted=false;
}
void RwIm3DVertexSetPos(RwIm3DVertex *v,RwReal x,RwReal y,RwReal z)
{
    // Compare every original corner and captured native vertex destination
    event(7);word((uint32_t)(v-TempBufferRenderVertices));vector(x,y,z);mutation(7);v->setX(x);v->setY(y);v->setZ(z);
