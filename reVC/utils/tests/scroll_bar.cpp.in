static void check(bool condition,int line)
{
    // Reject invalid corpus preconditions and unexpected native-owner identities immediately
    if(!condition){fprintf(stderr,"Scrolling-sign corpus check failed at line %d (hook %d)\n",line,hook);abort();}
}
#define require(condition) check((condition),__LINE__)
static void word(uint32_t value)
{
    // Compare each scalar through a deterministic byte-wise fingerprint
    for(int i=0;i<4;i++){hash^=(value>>(8*i))&255;hash*=1099511628211ULL;}
}
static void floating(float value)
{
    // Compare exact float bits without representation casts or a tolerance
    uint32_t bits;memcpy(&bits,&value,sizeof(bits));word(bits);
}
static void vector(float x,float y,float z)
{
    // Observe all three declared coordinates in their original arithmetic order
    floating(x);floating(y);floating(z);
}
static void bytes(const char *value)
{
    // Include the complete message and its terminator while preserving mutable time aliases
    if(!value){word(0);return;}size_t size=strlen(value)+1;word((uint32_t)size);for(size_t i=0;i<size;i++)word((uint8_t)value[i]);
}
static int messageId(const char *value)
{
    // Normalize actual module pointer identities rather than comparing message contents
    if(!value)return -1;for(int i=0;i<9;i++)if(messages[i] && value==messages[i])return i;if(value==TestSc_Time())return 8;if(value==externalMessage)return 9;require(false);return -2;
}
static void snapshot(void)
{
    // Observe every sign field, persistent message, glyph byte and shared-buffer counter
    states++;ScrollBar v=TestSc_Get();word(v.m_Counter);word(messageId(v.m_pMessage));bytes(v.m_pMessage);word(v.m_MessageCurrentChar);word(v.m_MessageLength);vector(v.m_Position.x,v.m_Position.y,v.m_Position.z);vector(v.m_Size.x,v.m_Size.y,v.m_Size.z);floating(v.m_fIntensity);for(int i=0;i<40;i++)word(v.m_MessageBar[i]);word(v.m_Type);word(v.m_bVisible);word(v.m_uRed);word(v.m_uGreen);word(v.m_uBlue);floating(v.m_fScale);word(TestSc_Event());bytes(TestSc_Time());for(int i=0;i<59;i++)for(int j=0;j<5;j++)word(TestSc_Glyph(i,j));word(TempBufferVerticesStored);word(TempBufferIndicesStored);word(RenderBuffer_VerticesToBeStored);word(RenderBuffer_IndicesToBeStored);
}
static void event(unsigned id)
{
    // Preserve the exact order and number of original external operations
    calls++;word(id);
}
extern "C" void TestSc_Bind(int32_t kind,const char *value)
{
    // Capture each algorithm's own literal address without changing its message pointer
    require(kind>=0 && kind<9);require(!messages[kind] || messages[kind]==value);messages[kind]=value;
}
static void renderMain(void)
{
    // Keep nested native projection owners distinct until their enclosing render returns
    require(renderDepth<2);renderDepth++;retainedInput[renderDepth]=NULL;retainedOutput[renderDepth]=NULL;retainedWidth[renderDepth]=retainedHeight[renderDepth]=NULL;renders++;TestSc_Render();snapshot();renderDepth--;
}
static void renderEnv(void *camera=(void *)0x5000)
{
    // Enter the complete reflection pass independently of the main visibility flag
    matrixQueries=0;signStarted=false;reflections++;TestSc_Env(camera);snapshot();
}
static void update(void)
{
    // Observe the complete message transition and bitmap shift after each frame
    updates++;TestSc_Update();snapshot();
}
static void mutation(int point)
{
    // Apply one bounded live-state change at an original external callback
    if(triggered)return;ScrollBar v=TestSc_Get();
    if((hook==1 && point==1)||(hook==2 && point==2)||(hook==3 && point==3)||(hook==4 && point==4)||(hook==7 && point==7)||(hook==14 && point==14)){
        // Change live geometry and bitmap while exposing incorrectly cached scale or colors
        triggered=true;v.m_Position.x+=.125f;v.m_Position.z+=.25f;v.m_Size.y+=.0625f;v.m_fScale=.47f;v.m_fIntensity=.25f;v.m_uRed=77;v.m_uGreen=183;v.m_uBlue=231;v.m_MessageBar[5]^=31;TestSc_Set(&v);gpCoronaTexture[0]=(RwTexture *)0x1100;
    }else if(hook==5 && point==5){
        // Mutate borrowed actual native vectors and C width outputs while they remain alive
        triggered=true;require(renderDepth>=0 && retainedInput[renderDepth] && retainedOutput[renderDepth]);RwV3d *input=const_cast<RwV3d *>(retainedInput[renderDepth]);input->x+=17.f;retainedOutput[renderDepth]->z=37.f;*retainedWidth[renderDepth]=71.f;*retainedHeight[renderDepth]=53.f;
    }else if(hook==6 && point==6 && signStarted){
        // Change the next sign pixels during a real shared-buffer capacity flush
        triggered=true;v.m_Position.y+=.75f;v.m_Size.x=.125f;v.m_fScale=.19f;v.m_MessageBar[38]^=15;TestSc_Set(&v);
    }else if((hook==8 && point==8)||(hook==9 && point==9)){
        // Keep camera basis copies and fade strength stable across later owner mutations
        triggered=true;matrices[0].right.x=7.f;matrices[0].up.y=-4.f;v.m_uRed=91;v.m_fIntensity=.1f;v.m_Position.z+=.125f;TestSc_Set(&v);
    }else if(hook==11 && point==11){
        // Expose the event value only after the selection random query has completed
        triggered=true;TestSc_SetEvent(2);
    }else if(hook==13 && point==2){
        // Reenter the same sign before the outer render caches its current colors
        triggered=true;renderMain();update();
    }else if(hook==15 && point==15){
        // Replace the texture after its original raster-query argument was captured
        triggered=true;gpCoronaTexture[0]=(RwTexture *)0x1100;
    }
}
bool CCamera::IsSphereVisible(const CVector &center,float radius)
{
    // Observe the original center and conditional-absolute-value radius before mutation
    event(1);vector(center.x,center.y,center.z);floating(radius);mutation(1);word(cameraVisible);return cameraVisible;
}
extern "C" uint16_t General_GetRandomNumber(void)
{
    // Keep selection retries and the independent display-glitch draw in their original order
    event(11);randoms++;mutation(11);uint16_t value;if(randomRead<randomCount)value=randomValues[randomRead++];else{randomState=randomState*1664525U+1013904223U;value=(uint16_t)(randomState>>16);}word(value);return value;
}
extern "C" uint8_t Clock_GetHours(void)
{
    // Return changing values so both original live hour queries remain observable
    event(12);uint8_t value=(clockHours++%2)?23:12;word(value);return value;
}
extern "C" uint8_t Clock_GetMinutes(void)
{
    // Return changing values so both original live minute queries remain observable
    event(13);uint8_t value=(clockMinutes++%2)?59:34;word(value);return value;
}
void CSprite::InitSpriteBuffer(void)
{
    // Retain the original sprite initialization before color narrowing
    event(2);mutation(2);
}
void CSprite::FlushSpriteBuffer(void)
{
    // Read retained native owners after every lit and unlit pixel has visited the loop
    event(16);if(renderDepth>=0 && retainedInput[renderDepth]){const RwV3d &in=*retainedInput[renderDepth];RwV3d &out=*retainedOutput[renderDepth];vector(in.x,in.y,in.z);vector(out.x,out.y,out.z);floating(*retainedWidth[renderDepth]);floating(*retainedHeight[renderDepth]);}
}
bool CSprite::CalcScreenCoors(const RwV3d &in,RwV3d *out,float *width,float *height,bool farclip)
{
    // Preserve actual input/output owner identity and lifetime across later sprite callbacks
    event(4);projects++;require(renderDepth>=0);int depth=renderDepth;require(&in!=out);if(retainedInput[depth]){require(retainedInput[depth]==&in && retainedOutput[depth]==out && retainedWidth[depth]==width && retainedHeight[depth]==height);}if(depth>0 && retainedInput[depth-1])require(retainedInput[depth-1]!=&in);retainedInput[depth]=&in;retainedOutput[depth]=out;retainedWidth[depth]=width;retainedHeight[depth]=height;vector(in.x,in.y,in.z);word(farclip);out->x=in.x*.75f;out->y=in.y*1.25f;out->z=in.z+2.f;*width=7.f+in.x*.01f;*height=9.f+in.y*.01f;mutation(4);bool result=projectMode==0 || (projectMode==1 && (projects%3)!=0);word(result);return result;
}
void CSprite::RenderBufferedOneXLUSprite(float x,float y,float z,float width,float height,uint8 r,uint8 g,uint8 b,int16 intensity,float reciprocal,uint8 alpha)
{
    // Capture current and trailing pixel sizes and cached integer colors before mutation
    event(5);sprites++;vector(x,y,z);floating(width);floating(height);word(r);word(g);word(b);word(intensity);floating(reciprocal);word(alpha);mutation(5);
}
RwBool RwRenderStateSet(RwRenderState state,void *value)
{
    // Compare complete native state order including the final reflection restore
    event(3);word(state);word((uint32_t)(uintptr_t)value);mutation(3);return TRUE;
}
RwRaster *RwTextureGetRaster(const RwTexture *texture)
{
    // Preserve the captured texture argument even if its canonical slot changes
    event(15);require(texture==(RwTexture *)0x1000 || texture==(RwTexture *)0x1100);word((uint32_t)(uintptr_t)texture);mutation(15);return (RwRaster *)((uintptr_t)texture+0x1000);
}
RwFrame *RwCameraGetFrame(const RwCamera *camera)
{
    // Observe the exact camera before the original frame-null gate
    event(17);require(camera==(RwCamera *)0x5000);word(framePresent);return framePresent?(RwFrame *)0x6000:NULL;
}
RwMatrix *RwFrameGetMatrix(RwFrame *frame)
{
    // Expose both original matrix queries and a distinct second returned owner
    event(18);require(frame==(RwFrame *)0x6000);matrixQueries++;word(matrixQueries);word(matrixPresent);int index=secondMatrix && matrixQueries==2?1:0;word(index);return matrixPresent?&matrices[index]:NULL;
}
RwReal RwCameraGetNearClipPlane(const RwCamera *camera)
