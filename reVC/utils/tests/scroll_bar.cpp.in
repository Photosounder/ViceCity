void *RwIm3DTransform(RwIm3DVertex *v,RwUInt32 count,RwMatrix *matrix,RwUInt32 flags)
{
    // Observe the actual shared-buffer batches including pending and capacity-flushed geometry
    event(6);transforms++;require(v==TempBufferRenderVertices && count<=512 && matrix==NULL);word(count);word(flags);for(unsigned i=0;i<count;i++){RwIm3DVertex &a=v[i];vector(a.getX(),a.getY(),a.getZ());RwRGBA c=a.getColor();word(c.red);word(c.green);word(c.blue);word(c.alpha);floating(a.getU());floating(a.getV());}mutation(6);word(transformSuccess);return transformSuccess?v:NULL;
}
RwBool RwIm3DRenderIndexedPrimitive(RwPrimitiveType type,RwImVertexIndex *indices,RwInt32 count)
{
