using uint8=uint8_t;using uint32=uint32_t;using int32=int32_t;using bool8=uint8_t;
#define FALSE 0
#define nil NULL
static void event(unsigned token);
struct IntValue {int32_t v;unsigned token;operator int32_t() const {
    // Observe each original direct integer field read
    event(token);return v;
}};
struct ShortValue {int32_t v;unsigned token;operator int16_t() const {
    // Observe each direct model read without changing signed narrowing
    event(token);return (int16_t)v;
}};
struct FloatValue {float v;unsigned token;operator float() const {
#ifndef _MSC_VER
