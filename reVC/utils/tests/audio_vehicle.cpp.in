extern "C" void AudioVehicleHost_BikeVelocity(CVehicle *vehicle,float velocity) {
    // Write the final parameter velocity to the captured bike
    vehicle->m_fVelocityChangeForAudio=velocity;
}
@METHOD@
static void prepare(unsigned seed) {
    // Sweep all areas, types, appearances and model branches with repeatable initialized storage
    seedValue=seed;findReads=0;active=&owners[seed&1];memset(active,0,sizeof(*active));memset(cars,0,sizeof(cars));memset(handling,0,sizeof(handling));
    const int models[]={MI_LANDSTAL,MI_RCBANDIT,MI_RCBARON,MI_RCRAIDER,MI_RCGOBLIN,MI_SKIMMER,MI_HUNTER,MI_PREDATOR,MI_AIRTRAIN,MI_DEADDODO,MI_BUS,MI_FIRST_VEHICLE-1};
    for(unsigned i=0;i<2;++i){cars[i].m_modelIndex={models[(seed/3+i)%12],14};cars[i].status={(int32_t)((seed/5+i)%13),16};cars[i].m_vehType={(int32_t)((seed/7+i)%8)-1,17};cars[i].AutoPilot.m_fMaxTrafficSpeed={(float)((int32_t)(seed%151)-50),18};cars[i].pHandling.pointer=(seed/11+i)%3==0?NULL:&handling[(seed/13+i)%2];cars[i].appearance=(seed/17+i)%7-1;cars[i].position={(float)(seed%43),-3,5};cars[i].m_vecMoveSpeed={-0.25f,(float)(seed%11)/10,0.75f};cars[i].forward={0.5f,-0.25f,1};cars[i].m_fVelocityChangeForAudio=-99;handling[i].Transmission.identity=i+1;}
    cars[0].m_vehType.v=(seed/7)%8-1;CGame::currArea={(int32_t)((seed/19)%21)-1,22};CWeather::WetRoads={(seed/23)%3==0?-1.0f:(seed/23)%3==1?0.0f:1.0f,23};camera={-5,4,1};
    active->m_sQueueSample.m_nCounter=777;active->m_sQueueSample.m_nFrequency=12345;active->m_sQueueSample.m_fDistance=17;active->m_sQueueSample.m_vecPos={1,2,3};
}
int main() {
#ifdef _WIN32
    // Keep sanitizer failures quiet
    SetErrorMode(3);
#endif
    // Compare complete routing runs over both owner layouts and changing game state
    for(unsigned seed=0;seed<32768;++seed){prepare(seed);observe();@RUN@;observe();if(cars[0].m_fVelocityChangeForAudio!=-99){if((seed/7)%8-1==VEHICLE_TYPE_CAR)++carWrites;else ++bikeWrites;}if(active->m_sQueueSample.m_nCounter==777)++areaRejects;++cases;}
    // Require every generator family and the early-return and captured-velocity paths
    for(unsigned i=0;i<23;++i)if(!layers[i])return 2;
    if(!carWrites||!bikeWrites||!oneShots||!gasCalls||!mutations||!areaRejects)return 3;
    printf("%u cases %u callbacks %u car %u bike %llu\n",cases,callbacks,carWrites,bikeWrites,(unsigned long long)digest);
}
