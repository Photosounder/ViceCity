    assert(slot>=0&&type==SHADOWTYPE_ADDITIVE&&texture==gpShadowExplosionTex&&frontX==7&&frontY==0&&sideX==0&&sideY==-7&&intensity==0&&red==green&&blue==0&&distance==10&&scale==1&&drawDistance==40&&!temporary&&up==0);
    number(12);number(slot);vector(*position);number(red);shadows++;return true;
}
