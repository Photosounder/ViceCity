static void bytes(const void *data,size_t length)
{
    // Hash observable scalar bytes without executable-specific pointer values or unspecified padding
    const uint8_t *p=(const uint8_t *)data;
    for(size_t i=0;i<length;i++){hashValue^=p[i];hashValue*=UINT64_C(1099511628211);}
}
static void number(uint32_t value)
{
    // Keep integer event observations independent of pointer width
    bytes(&value,4);
}
static void vector(const CVector &value)
{
    // Observe all three native vector components at each external operation
    bytes(&value.x,4);bytes(&value.y,4);bytes(&value.z,4);
}
static int entityId(CEntity *entity)
{
    // Preserve null and native entity identity without hashing addresses
    return entity?entity->id:-1;
}
static int fireId(CFire *fire)
{
    // Identify the actual canonical fire slot referenced by an entity
    return fire?int(fire-gFireManager.m_aFires):-1;
}
static TestFireState read(int index)
{
    // Retrieve all semantic members from the actual original or C record
    TestFireState result;TestFire_Read(index,&result);return result;
}
static void stateBytes(const TestFireState &s)
{
    // Include every persistent fire field in each state comparison
    number(s.ongoing);number(s.script);number(s.propagation);number(s.audio);bytes(&s.x,4);bytes(&s.y,4);bytes(&s.z,4);number(entityId(s.entity));number(entityId(s.source));number(s.extinguish);number(s.start);number(s.next);bytes(&s.strength,4);bytes(&s.water,4);number(s.withWater);
}
static int slotId(CEntity **slot)
{
    // Check that references retain the same actual field addresses through fire reuse
    for(int i=0;i<NUM_FIRES;i++){
        // Distinguish target and source reference slots in the canonical C or original array
        if(slot==&gFireManager.m_aFires[i].m_pEntity)return 2*i;
        if(slot==&gFireManager.m_aFires[i].m_pSource)return 2*i+1;
    }
    for(CPed *ped:{(CPed *)&player,&npc,&cop})if(slot==&ped->m_fleeFrom)return 100+ped->id;
    assert(false);return -1;
}
static void snapshot()
{
    // Observe the complete canonical manager, native entity state and actual reference chains
    number(TestFire_GetTotal());
    for(int i=0;i<NUM_FIRES;i++)stateBytes(read(i));
    for(CEntity *entity:actors){
        // Include live positions, scorched flags and each reference's field identity and current referent
        vector(entity->GetPosition());number(entity->bRenderScorched);
        unsigned count=0;
        for(CReference *ref=entity->m_pFirstReference;ref;ref=ref->next){assert(++count<100);number(slotId(ref->pentity));number(entityId(*ref->pentity));}
        number(count);
    }
    for(CPed *ped:{(CPed *)&player,&npc,&cop}){
        // Include every pedestrian field touched by the original fire lifecycle
        number(fireId(ped->m_pFire));number(ped->m_nMoveState);number(ped->m_nPedState);number(ped->m_nLastPedState);number(entityId(ped->m_fleeFrom));number(ped->m_fleeTimer);number(ped->bDrawLast);bytes(&ped->health,4);
    }
    number(fireId(car.m_pCarFire));number(fireId(bike.m_pCarFire));bytes(&car.m_fHealth,4);bytes(&bike.m_fHealth,4);number(car.Damage.status);number(Timer_timeMs);states++;
}
extern "C" int myrand(void)
