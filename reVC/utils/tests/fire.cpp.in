static void fresh()
{
    // Reset independent scenarios through semantic writes while retaining original constructor defaults
    for(int i=0;i<NUM_FIRES;i++)TestFire_Write(i,&initial[i]);TestFire_Total(0);References_Init();
    for(int i=0;i<6;i++){CEntity *e=actors[i];e->id=i;e->m_pFirstReference=nil;e->model=0;e->bRenderScorched=false;e->matrix.SetTranslate(10,20,3);}
    for(CPed *ped:{(CPed *)&player,&npc,&cop}){
        // Seed every native field used by the fire state machine without invoking unrelated game initialization
        ped->m_pFire=nil;ped->m_pMyVehicle=nil;ped->bInVehicle=false;ped->bFireProof=false;ped->bDrawLast=true;ped->inControl=true;ped->canSet=true;ped->damageResult=false;ped->m_nMoveState=PEDMOVE_RUN;ped->m_nPedState=PED_NONE;ped->m_nLastPedState=PED_FALL;ped->m_nPedType=PEDTYPE_CIVMALE;ped->m_fleeFrom=nil;ped->m_fleeTimer=0;ped->health=100;
    }
    cop.m_nPedType=PEDTYPE_COP;car.m_pCarFire=bike.m_pCarFire=nil;car.m_fHealth=bike.m_fHealth=1000;car.car=true;bike.car=false;car.model=1;bike.model=2;car.Damage.status=0;object.kind=0;
    player.GetPosition()=CVector(1000,1000,0);livePlayer=&player;liveVehicle=nil;CGameLogic::pShortCutTaxi=&car;CGameLogic::ShortCutState=0;
    for(int i=0;i<8;i++)models[i].m_positions[CAR_POS_HEADLIGHTS]=CVector(0.5f,1.75f,0.9f);
    Timer_timeMs=10000;Timer_timeStep=1.0f;randomState=1;advanceTime=moveOnIdle=moveOnEvent=false;
}
static void startup()
{
    // Require all forty actual static records to match the original global constructor before any lifecycle call
    assert(TestFire_GetTotal()==0);
    for(int i=0;i<NUM_FIRES;i++){
        // Include the next-flame timer that was only implicitly zeroed in the original global manager
        TestFire_Read(i,&initial[i]);TestFireState &s=initial[i];assert(!s.ongoing&&!s.script&&s.propagation&&s.audio&&s.x==0&&s.y==0&&s.z==0&&!s.entity&&!s.source&&s.extinguish==0&&s.start==0&&s.next==0&&s.strength==0.8f&&s.water==1.0f&&!s.withWater);
    }
    fresh();snapshot();
}
static void creationCases()
{
    // Exercise point, entity and script creation including each ordered rejection and reference registration
    for(int kind=0;kind<6;kind++)for(int scenario=0;scenario<12;scenario++){
        // Keep target types consistent with the original casts and engine-status preconditions
        fresh();CEntity *target=actors[kind];CEntity *source=scenario%2?&cop:nil;
        if(scenario==1&&kind<3)((CPed *)target)->inControl=false;
        if(scenario==2&&kind<3)((CPed *)target)->m_pFire=&gFireManager.m_aFires[4];
        if(scenario==2&&kind>=3&&kind<=4)((CVehicle *)target)->m_pCarFire=&gFireManager.m_aFires[4];
        if(scenario==3&&kind==3)car.Damage.status=225;
        if(scenario==4&&kind==3)car.Damage.status=224;
        if(scenario==5)advanceTime=true;
        if(scenario==6)moveOnEvent=true;
        if(scenario==7)object.kind=3;
        if(scenario==8){TestFireState s=read(0);s.water=-0.5f;TestFire_Write(0,&s);}
        if(scenario==9)for(int i=0;i<NUM_FIRES;i++){TestFireState s=read(i);s.script=true;TestFire_Write(i,&s);}
        int result=TestFire_On(target,source,1.7f,(uint8_t)(scenario%3));starts++;
        bool rejected=scenario==9||(kind<3&&(scenario==1||scenario==2))||((kind==3||kind==4)&&scenario==2)||(kind==3&&scenario==3);
        assert((result<0)==rejected);if(result>=0){TestFireState s=read(result);assert(s.ongoing&&!s.script&&s.entity==target&&s.source==source&&s.strength==1.7f&&s.propagation==(scenario%3!=0)&&TestFire_GetTotal()==1);if(scenario==8)assert(s.water==-0.5f);}
        snapshot();if(result>=0){TestFire_Extinguish(result);assert(TestFire_GetTotal()==0&&!read(result).ongoing&&!read(result).entity);snapshot();}
    }
    for(int reserve=0;reserve<=NUM_FIRES;reserve++){
        // Require first-free selection to skip inactive script reservations and handle the full array
        fresh();for(int i=0;i<reserve;i++){TestFireState s=read(i);s.script=true;TestFire_Write(i,&s);}
        assert(TestFire_Free()==(reserve<NUM_FIRES?reserve:-1));TestFire_At(CVector(1,2,3),2.0f,255);starts++;assert(TestFire_GetTotal()==(reserve<NUM_FIRES?1u:0u));snapshot();
    }
    for(int kind=-1;kind<6;kind++){
        // Script creation resets the water countdown and leaves the ordinary total unchanged
        fresh();CEntity *target=kind<0?nil:actors[kind];CVector position(4,5,6);if(kind==3)car.Damage.status=250;
        int index=TestFire_Script(&position,target,3.2f,2);scripts++;TestFireState s=read(index);assert(index==0&&s.ongoing&&s.script&&s.audio&&s.water==1&&s.strength==3.2f&&s.entity==target&&!s.source&&TestFire_GetTotal()==0);if(kind==3)assert(car.Damage.status==215);
        TestFire_Audio(index,false);assert(!read(index).audio);snapshot();TestFire_Remove(index);assert(!read(index).ongoing&&!read(index).script&&TestFire_GetTotal()==0);snapshot();
    }
    fresh();assert(TestFire_On(&player,&cop,0.8f,1)==0);moveOnIdle=true;float oldX=player.GetPosition().x;
    int script=TestFire_Script(&player.GetPosition(),&player,2.0f,1);scripts++;assert(script==0&&read(script).x==oldX+0.75f&&TestFire_GetTotal()==0);snapshot();
}
static void processCases()
{
    // Cover attachment validity, state gates, temporal thresholds, player ignition and both particle paths
    for(int kind=-1;kind<6;kind++)for(int scenario=0;scenario<20;scenario++){
        // Seed valid live targets and independently vary the state-machine conditions
        fresh();CEntity *target=kind<0?nil:actors[kind];int index=0;
        if(target){index=TestFire_On(target,&cop,0.9f,1);assert(index==0);}else TestFire_At(CVector(10,20,3),0.9f,1);
        TestFireState s=read(index);s.next=Timer_timeMs-1;s.extinguish=Timer_timeMs+1000;s.start=Timer_timeMs-1;
        if(scenario==0)s.next=Timer_timeMs;
        if(scenario==1)s.extinguish=Timer_timeMs;
        if(scenario==2)s.extinguish=Timer_timeMs-1;
        if(scenario==3){s.script=true;TestFire_Total(0);s.extinguish=0;}
        if(scenario==4){s.water=0.2f;}
        if(scenario==5){s.water=0.5f;}
        if(scenario==6){s.water=0.9f;}
        if(scenario==7&&kind>=0&&kind<3)((CPed *)target)->m_nMoveState=PEDMOVE_WALK;
        if(scenario==8&&kind>=0&&kind<3){((CPed *)target)->bInVehicle=true;((CPed *)target)->m_pMyVehicle=&car;}
        if(scenario==9&&kind>=0&&kind<3)((CPed *)target)->damageResult=true;
        if(scenario==10){if(kind>=0&&kind<3)((CPed *)target)->m_pFire=nil;if(kind==3||kind==4)((CVehicle *)target)->m_pCarFire=nil;}
        if(scenario==11){CGameLogic::ShortCutState=CGameLogic::SHORTCUT_TRANSITION;}
        if(scenario==12){advanceTime=true;}
        if(scenario==13){player.GetPosition()=CVector(10,20,3);}
        if(scenario==14){player.GetPosition()=CVector(10,20,3);player.bFireProof=true;}
        if(scenario==15){player.GetPosition()=CVector(10,20,3);liveVehicle=&car;}
        if(scenario==16){Timer_timeStep=-2.0f;}
        if(scenario==17){s.water=std::numeric_limits<float>::quiet_NaN();}
        if(scenario==18&&kind>=0){References_ResolveReferences(target);s.entity=nil;}
        if(scenario==19){s.start=Timer_timeMs;s.next=Timer_timeMs+1;}
        TestFire_Write(index,&s);unsigned oldParticles=particles,oldLights=lights;TestFire_Process(index);snapshot();
        if(scenario==0||scenario==19)assert(particles==oldParticles);
        if((scenario==1||scenario==2)&&!s.script)assert(!read(index).ongoing&&lights==oldLights);
        if(scenario==13&&kind!=0)assert(player.m_pFire!=nil);
        if(scenario==14&&kind!=0)assert(player.m_pFire==nil);
    }
    fresh();TestFire_At(CVector(10,20,3),1,1);player.GetPosition()=CVector(10,20,3);TestFire_Update();assert(player.m_pFire!=nil&&player.health<100);snapshot();
#ifdef FIX_BUGS
    fresh();TestFire_At(CVector(0,0,0),1,1);livePlayer=nil;TestFire_Process(0);snapshot();
#endif
}
static void queryAndWaterCases()
{
    // Cover nearest/furthest ties, strict ranges, first-match water effects and script reservation lifecycle
    fresh();float distance=-1;assert(TestFire_Nearest(CVector(0,0,0),&distance)==-1&&distance==999999);assert(TestFire_Furthest(CVector(0,0,0),0,100)==-1);
    for(int i=0;i<5;i++){TestFireState s=read(i);s.ongoing=true;s.x=i==0?-3:i==1?3:i==2?5:i==3?10:0;s.y=i==4?2:0;s.z=100+i;s.extinguish=20000;TestFire_Write(i,&s);}TestFire_Total(5);
    assert(TestFire_Nearest(CVector(0,0,1000),&distance)==4&&distance==2);assert(TestFire_Furthest(CVector(0,0,0),3,10)==2);assert(TestFire_Furthest(CVector(0,0,0),0,4)==0);snapshot();
    fresh();TestFire_At(CVector(0,0,0),1,1);TestFire_At(CVector(0,0,0),2,1);TestFireState first=read(0);first.water=0.012f;TestFire_Write(0,&first);
    unsigned previous=randoms;assert(TestFire_Water(CVector(0,0,0),1));waters++;assert(read(0).ongoing&&read(0).water==0&&read(0).withWater&&read(1).water==1&&randoms==previous+3);snapshot();
    assert(TestFire_Water(CVector(0,0,0),1));waters++;assert(!read(0).ongoing&&!read(0).withWater&&TestFire_GetTotal()==1);snapshot();
    TestFire_At(CVector(0,0,0),3,1);assert(read(0).water<0);snapshot();assert(!TestFire_Water(CVector(1,0,0),1));waters++;
    TestFire_ExtinguishPoint(CVector(0,0,0),1);assert(!read(0).ongoing&&!read(1).ongoing&&TestFire_GetTotal()==0);snapshot();
    fresh();CVector pos(0,0,0);int a=TestFire_Script(&pos,nil,1,1),b=TestFire_Script(&pos,nil,2,0);scripts+=2;TestFire_Extinguish(a);assert(TestFire_IsOut(a)&&read(a).script&&TestFire_Free()==2);TestFire_RemoveAll();assert(!read(a).script&&!read(b).script&&!read(b).ongoing&&TestFire_Free()==0);snapshot();
    for(int mode=0;mode<5;mode++){
        // Preserve native pedestrian cleanup gates and the original script/non-script counter behavior
        fresh();assert(TestFire_On(&npc,&cop,1,1)==0);if(mode==0)npc.canSet=false;if(mode==1)npc.m_nPedState=PED_DRIVING;if(mode==2)npc.m_nPedState=PED_FALL;if(mode==3){TestFireState s=read(0);s.script=true;TestFire_Write(0,&s);TestFire_Total(0);}if(mode==4)TestFire_Total(0);
        TestFire_Extinguish(0);assert(!npc.m_pFire&&!read(0).entity&&!read(0).ongoing&&read(0).source==&cop);if(mode==4)assert(TestFire_GetTotal()==UINT32_MAX);snapshot();TestFire_Extinguish(0);snapshot();
    }
}
int main()
{
    // Compare complete original and C behavior through quiet console operations only
    startup();creationCases();processCases();queryAndWaterCases();
    assert(starts==113&&scripts==10&&waters==3&&randoms>0&&actions>0&&events>0&&particles>0&&shadows>0&&lights>0&&registrations>0&&playerQueries>0&&vehicleQueries>0);
    printf("states=%u starts=%u scripts=%u water=%u random=%u actions=%u events=%u particles=%u shadows=%u lights=%u references=%u players=%u vehicles=%u hash=%016llx\n",states,starts,scripts,waters,randoms,actions,events,particles,shadows,lights,registrations,playerQueries,vehicleQueries,(unsigned long long)hashValue);
}
