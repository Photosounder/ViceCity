    uint32_t caps[4];capsExists=false;run(OP_ReadCaps,caps);hashBytes(caps,sizeof(caps));require(run(OP_CheckCaps).number==1);run(OP_WriteCaps);require(run(OP_CheckCaps).number==0);run(OP_ReadCaps,caps);hashBytes(caps,sizeof(caps));capsFile[8]^=0x40;require(run(OP_CheckCaps).number==1);capsReadLimit=1;run(OP_ReadCaps,caps);hashBytes(caps,sizeof(caps));capsReadLimit=4;capsWriteFail=true;run(OP_WriteCaps);capsWriteFail=false;for(unsigned mask=0;mask<4;++mask){dxtMask=mask;run(OP_DXT);}
    // Exercise the complete progress drawing calculations and frame-start early return without native rendering
    for(unsigned i=0;i<3;++i){RsGlobal.width=800+(int)i*320;RsGlobal.height=600+(int)i*120;aspect=(float)RsGlobal.width/(float)RsGlobal.height;run(OP_Screen,NULL,NULL,i,2);}frameAllowed=false;unsigned starts=frameStarts;run(OP_Screen);require(frameStarts==starts+1);frameAllowed=true;RsGlobal.quit=false;padPolls=0;run(OP_Error,NULL,NULL,1,4,"CVT_ERR");require(RsGlobal.quit&&padPolls==escapeAfter);RsGlobal.quit=true;padPolls=0;run(OP_Error,NULL,NULL,0,4,"CVT_CRT");require(RsGlobal.quit&&padPolls==0);snapshot();
