int32 CTimeCycle::colors[9];
CVector CTimeCycle::sun;
RwTexture *gpCoronaTexture[9];
static RwMatrix cameraMatrix;
static RwCamera *camera=(RwCamera *)0x5000;
static RwIm3DVertex vertices[4];
static uint16_t indices[6];
static uint64_t hash=UINT64_C(1469598103934665603);
static unsigned states,calls,projects,sprites,quads,flushes,randoms;
static int hour,minute,second,txd,savedTxd,nextTexture,hook,projectIndex;
static bool outside,framePresent,matrixPresent,triggered;
