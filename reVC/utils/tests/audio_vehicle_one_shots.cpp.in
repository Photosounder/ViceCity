@TABLE@
static cAudioManager owners[2],*active;static cVehicleParams params;static CVehicle cars[2];static CPed drivers[2];
static unsigned seedValue,cases,callbacks,requests,offsetReads,pedCalls,stereoRight,mutations,loops,reflections,clamps,layers[19];
static uint64_t digest=1469598103934665603ULL;
