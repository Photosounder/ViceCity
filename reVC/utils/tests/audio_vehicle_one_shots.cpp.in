@PROTOTYPES@
static void value(uint32_t v) {
    // Hash scalar observations and exact callback order
    digest=(digest^v)*1099511628211ULL;
}
static void bytes(const void *p,unsigned size) {
    // Hash every initialized word of complete records
    digest=TestAircraftHash(digest,p,size);
}
static unsigned identity(const void *p) {
    // Normalize vehicle and captured driver pointers
    return p==&cars[0]?1:p==&cars[1]?2:p==&drivers[0]?3:p==&drivers[1]?4:0;
}
static void observe() {
    // Include complete owner, parameter, vehicle and pedestrian records
    cVehicleParams copy=params;copy.m_pVehicle=(CVehicle *)(uintptr_t)identity(params.m_pVehicle);CVehicle vehicles[2];memcpy(vehicles,cars,sizeof(vehicles));
    for(unsigned i=0;i<2;++i)vehicles[i].pDriver.pointer=(CPed *)(uintptr_t)identity(cars[i].pDriver.pointer);
    bytes(active,sizeof(*active));bytes(&copy,sizeof(copy));bytes(vehicles,sizeof(vehicles));bytes(drivers,sizeof(drivers));
}
static void event(unsigned token) {
    // Observe live game queries before changing later vehicle and event-table reads
    ++callbacks;value(token);observe();
    if(token==31&&(seedValue&128)){params.m_pVehicle=&cars[1];cars[1].m_modelIndex.v=MI_PREDATOR;}
    if(token==26&&(seedValue&256)){++mutations;for(unsigned j=0;j<NUM_AUDIOENTITY_EVENTS;++j)active->m_asAudioEntities[active->m_sQueueSample.m_nEntityIndex].m_awAudioEvent[j]=SOUND_CAR_DOOR_CLOSE_FRONT_LEFT;}
    if(token==35&&(seedValue&512))drivers[0].weapons[WEAPONSLOT_SUBMACHINEGUN].m_eWeaponType.v=WEAPONTYPE_TEC9;
}
extern "C" float AudioAircraftHost_WheelSpeed(const CVehicle *vehicle) {
    // Query the live original rotor-speed input
    return vehicle->m_aWheelSpeed[1];
}
