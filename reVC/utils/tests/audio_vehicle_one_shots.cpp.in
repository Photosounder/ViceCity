struct CWeapon {IntValue m_eWeaponType;};
class CPed {public:CWeapon weapons[TOTAL_WEAPON_SLOTS];uint32_t driveBy;
    bool HasWeaponSlot(uint8_t slot) {
        // Observe the original captured driver predicate and its selected slot
        event(32);return weapons[slot].m_eWeaponType!=WEAPONTYPE_UNARMED;
    }
    bool IsPedDoingDriveByShooting() {
        // Observe the original captured driver's drive-by query
        event(34);return driveBy!=0;
    }
    CWeapon &GetWeapon(uint8_t slot) {
        // Observe the original selected weapon reference
        event(35);return weapons[slot];
    }
};
struct DriverValue {CPed *pointer;operator CPed *() const {
    // Observe capture of the current driver pointer
    event(31);return pointer;
