@METHOD@
@EVENTS@
static float eventVolume(int event,unsigned seed) {
    // Stay inside the original defined conversion domains while exercising clamping boundaries
    if(event==SOUND_CAR_SPLASH){const float v[]={149,150,151,799,800,801};return v[seed%6];}
    if(event==SOUND_CAR_TANK_TURRET_ROTATE){const float v[]={0,0.0001f,0.038399f,0.0384f,0.038401f,0.1f};return v[seed%6];}
    if(event==SOUND_CAR_PED_COLLISION){const float v[]={0,0.001f,1,19.999f,20,20.001f,50};return v[seed%7];}
    const float v[]={0,0.001f,0.25f,0.399f,0.4f,0.5f,1,1.2f};return v[seed%8];
}
static void prepare(unsigned seed) {
    // Seed all event labels, model and weapon choices, exact ranges and shared history cadence
    seedValue=seed;active=&owners[seed&1];memset(active,0,sizeof(*active));memset(&params,0,sizeof(params));memset(cars,0,sizeof(cars));memset(drivers,0,sizeof(drivers));
    const int models[]={MI_LANDSTAL,MI_CADDY,MI_HUNTER,MI_CHOPPER,MI_SEASPAR,MI_SPARROW,MI_MAVERICK,MI_VCNMAV,MI_PREDATOR,MI_SKIMMER};
    const int weapons[]={WEAPONTYPE_UNARMED,WEAPONTYPE_TEC9,WEAPONTYPE_SILENCED_INGRAM,WEAPONTYPE_MP5,WEAPONTYPE_UZI,WEAPONTYPE_COLT45};
    const float rotor[]={0,0.043999f,0.044f,0.044001f,0.1f,0.219999f,0.22f};
    for(unsigned j=0;j<2;++j){cars[j].m_modelIndex={models[(seed/11+j)%10],21};cars[j].appearance=(seed/13+j)%6;cars[j].m_aWheelSpeed[1]={rotor[(seed/17+j)%7],24};cars[j].pDriver.pointer=(seed/19+j)%3?&drivers[(seed/23+j)%2]:NULL;drivers[j].driveBy=(seed/29+j)%2;for(unsigned slot=0;slot<TOTAL_WEAPON_SLOTS;++slot)drivers[j].weapons[slot].m_eWeaponType={weapons[(seed/31+j)%6],33};}
    params.m_pVehicle=&cars[0];params.m_nIndex=seed%MAX_CARS;params.m_VehicleType=seed%2?VEHICLE_TYPE_BIKE:VEHICLE_TYPE_CAR;
    const float ranges[]={0,1,24,34.999f,35,35.001f,39.999f,40,40.001f,49.999f,50,50.001f,59.999f,60,60.001f,119.999f,120,120.001f};float range=ranges[(seed/37)%18];params.m_fDistance=range*range;params.m_bDistanceCalculated=(seed/41)%3;
    active->m_sQueueSample.m_fDistance=(seed/43)%36;active->m_sQueueSample.m_nCounter=777;active->m_sQueueSample.m_nSampleIndex=999;active->m_sQueueSample.m_nFrequency=12345;active->m_sQueueSample.m_nFramesToPlay=17;active->m_sQueueSample.m_nPan=53;active->m_sQueueSample.m_vecPos={1,2,3};active->m_sQueueSample.m_nEntityIndex=seed%2;active->m_nActiveSamples=8;active->m_bDynamicAcousticModelingStatus=1;
    active->m_FrameCounter=seed%97==0?UINT32_MAX-3:(seed/8)*7;
    for(unsigned j=0;j<5;++j)active->m_anRandomTable[j]=(int32_t)((seed*(j+1))%1001)-500;
    for(unsigned entity=0;entity<2;++entity){active->m_asAudioEntities[entity].m_AudioEvents=(seed/47+entity)%5;for(unsigned j=0;j<NUM_AUDIOENTITY_EVENTS;++j){int event=events[(seed+entity*7+j*11)%ARRAY_SIZE(events)];active->m_asAudioEntities[entity].m_awAudioEvent[j]=(int16_t)event;active->m_asAudioEntities[entity].m_afVolume[j]=eventVolume(event,seed+j);}}
#ifndef GTA_PS2
    // Seed loop fields to expose partial writes
    active->m_sQueueSample.m_nLoopStart=123;active->m_sQueueSample.m_nLoopEnd=456;
#endif
#ifdef AUDIO_REFLECTIONS
    // Exercise real reflection request insertion with initialized geometry
    for(unsigned j=0;j<5;++j){active->m_afReflectionsDistances[j]=4+(float)j*4;active->m_avecReflectionsPos[j]={1,(float)j,3};}
#endif
}
int main() {
#ifdef _WIN32
    // Keep sanitizer traps from opening an error dialog
    SetErrorMode(3);
#endif
    // Compare complete event loops across alternating owners without resetting shared counters
    for(unsigned seed=0;seed<16384;++seed){prepare(seed);observe();@RUN@;observe();for(unsigned entity=0;entity<2;++entity)for(unsigned j=0;j<NUM_AUDIOENTITY_EVENTS;++j)if(active->m_asAudioEntities[entity].m_afVolume[j]==800)++clamps;++cases;}
    // Require every sound family plus pedestrian, stereo, loop and mutable-event paths
    for(unsigned j=0;j<19;++j)if(!layers[j])return 2;
    if(!pedCalls||!stereoRight||!loops||!mutations||!clamps)return 3;
#ifndef GTA_PS2
    // Require desktop live loop queries
    if(!offsetReads)return 4;
#endif
#ifdef AUDIO_REFLECTIONS
    // Require actual request recursion in reflection-enabled shapes
    if(!reflections)return 5;
#endif
    printf("%u cases %u callbacks %u requests %u reflections %llu\n",cases,callbacks,requests,reflections,(unsigned long long)digest);
}
