enum {@CONSTANTS@};
static void event(unsigned token);
struct IntValue {int32_t v;unsigned token;operator int32_t() const {
    // Observe each original model or weapon field read
    event(token);return v;
}};
struct FloatValue {float v;unsigned token;operator float() const {
#ifndef _MSC_VER
    // Observe floating reads on Clang and GCC
    event(token);
