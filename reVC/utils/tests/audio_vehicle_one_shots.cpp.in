    // Read each original live model expression
    return vehicle->GetModelIndex();
}
extern "C" uint8_t AudioVehicleOneShotsHost_DoorType(uint32_t index) {
    // Read the original immutable audio-table door kind
    return aVehicleSettings[index].m_bDoorType;
}
static int16_t handBrake() {
    // Exercise both original Hunter weapon choices
    event(30);return (seedValue/7)%2?255:0;
}
extern "C" int16_t AudioVehicleOneShotsHost_HandBrake() {
    // Retain the first pad's original handbrake query
    return Pads[0].GetHandBrake();
}
extern "C" CVehicle *AudioGame_FindVehicle() {
    // Exercise player and AI Hunter branches after the handbrake predicate
    event(29);return seedValue%3==0?NULL:&cars[(seedValue/3)%2];
}
extern "C" CPed *AudioVehicleOneShotsHost_Driver(const CVehicle *vehicle) {
    // Capture the original driver before later live vehicle changes
    return vehicle->pDriver;
}
extern "C" uint8_t AudioVehicleOneShotsHost_HasWeapon(CPed *ped,uint8_t slot) {
    // Query the captured driver and selected slot
    return ped->HasWeaponSlot(slot);
}
extern "C" uint8_t AudioVehicleOneShotsHost_DriveBy(CPed *ped) {
    // Query the captured driver rather than a later replacement vehicle
    return ped->IsPedDoingDriveByShooting();
}
extern "C" int32_t AudioVehicleOneShotsHost_Weapon(CPed *ped,uint8_t slot) {
    // Read the type from the original selected weapon reference
    return ped->GetWeapon(slot).m_eWeaponType;
}
void cAudioManager::SetupPedComments(cPedParams &p,uint16_t sound) {
    // Observe retained pedestrian context and its original distance fields
    ++pedCalls;event(36);value(sound);value(p.m_bDistanceCalculated);bytes(&p.m_fDistance,4);value(identity(p.m_pPed));p.m_pPed=&drivers[0];
}
extern "C" void AudioPedSpeech_Setup(cAudioManager *manager,cPedParams *p,uint16_t sound) {
    // Forward the original local context through the remaining comment boundary
    manager->SetupPedComments(*p,sound);
}
extern "C" uint32_t SampleManager_GetSampleBaseFrequency(cSampleManager *,uint32_t sample) {
    // Observe sample selection and change subsequent live event and parameter accesses
    event(40);value(sample);
    if(seedValue&1024){params.m_pVehicle=&cars[1];params.m_VehicleType=VEHICLE_TYPE_BIKE;active->m_sQueueSample.m_nEntityIndex^=1;}
    return 16000+(sample%120)*127;
}
extern "C" uint32_t SampleManager_GetSampleLoopStartOffset(cSampleManager *,uint32_t sample) {
    // Change the live loop sample before its end-offset argument is evaluated
    ++offsetReads;event(41);value(sample);if(seedValue&2048)active->m_sQueueSample.m_nSampleIndex=SFX_M60_LEFT;return sample*3;
}
extern "C" int32_t SampleManager_GetSampleLoopEndOffset(cSampleManager *,uint32_t sample) {
    // Observe the later current sample argument
    ++offsetReads;event(42);value(sample);return sample*5+100;
}
extern "C" uint8_t AudioRequestsHost_InRoom() {
    // Observe actual C request and reflection recursion
    if(active->m_sQueueSample.m_nCounter>=256)++reflections;event(44);return (seedValue/5)%3==0;
}
extern "C" uint8_t AudioRequestsHost_SlowMotion() {
    // Exercise both defined disabled-time-scale reflection paths
    event(45);return (seedValue/9)%2;
}
extern "C" void AudioRequests_Submit(cAudioManager *manager) {
    // Observe actual insertion and retained stereo state across the first request
    ++requests;event(43);uint32_t c=manager->m_sQueueSample.m_nCounter;
    const uint32_t counters[]={68,36,37,81,87,51,86,15,80,48,50,79};
    for(unsigned j=0;j<12;++j)if(c==counters[j])++layers[j];
    if(c==34)++layers[18];if(c>=41&&c<=46)++layers[12];if(c>=82&&c<=85)++layers[13];if(c>=91&&c<=94)++layers[14];if(c>=53&&c<=58)++layers[15];if(c>=89&&c<=90)++layers[16];if(c<30||c>94)++layers[17];
    if(manager->m_sQueueSample.m_nLoopCount==0)++loops;if(manager->m_sQueueSample.m_bIs2D&&manager->m_sQueueSample.m_nPan==127)++stereoRight;
    TestVehicleOneShotsRealSubmit(manager);event(46);
    if(seedValue&4096){++mutations;manager->m_sQueueSample.m_nFrequency=12345;manager->m_sQueueSample.m_nSampleIndex=SFX_ROCKET_LEFT;manager->m_sQueueSample.m_fDistance=12;manager->m_sQueueSample.m_nEntityIndex^=1;params.m_pVehicle=&cars[1];}
}
extern "C" void AudioGeometryHost_CameraPosition(AudioSoundPosition *out) {
    // Supply the unused linked geometry dependency
    *out={0,0,0};
}
extern "C" void AudioGeometryHost_CameraMatrix(AudioCameraMatrix *out) {
    // Supply the unused linked geometry dependency
    memset(out,0,sizeof(*out));
