uint32_t RwStreamRead(RwStream *stream,void *output,uint32_t size)
{
    // Supply original serialized fields at the separate SDK stream boundary
    require(stream&&output);event(6,stream->id,size);if(stream->section==stream->shortSection)return 0;if(stream->section==0){require(size==4||size==12);int32_t values[]={stream->totalAtomics,7,9};memcpy(output,values,size);}else if(stream->section==1){require(size==4);memcpy(output,&stream->totalGeometries,4);}else{require(size==12||size==16);int index=stream->nextAtomic++;int32_t values[]={stream->totalFrames?index%stream->totalFrames:0,stream->totalGeometries?index%stream->totalGeometries:0,(int32_t)(UINT32_C(0x80000040)+(unsigned)index),99};memcpy(output,values,size);}position(stream,stream->position+(int)size);if(stream->section==1)stream->geometryBase=stream->position;return size;
}
RpGeometry *RpGeometryStreamRead(RwStream *stream)
{
    // Create independent SDK geometry references or a controlled decoder failure
    int index=stream->nextGeometry++;event(7,stream->id,(uint32_t)index);if(index==stream->failGeometryRead)return NULL;require(geometryCount<4095);RpGeometry *geometry=&geometries[++geometryCount];geometry->id=geometryCount;geometry->refs=1;geometry->alive=true;position(stream,stream->position+32);return geometry;
}
RwBool RpGeometryDestroy(RpGeometry *geometry)
{
    // Apply SDK reference release rather than reproducing reader-owned geometry-list policy
    require(geometry&&geometry->alive&&geometry->refs>0);event(8,geometry->id,geometry->refs);if(--geometry->refs==0)geometry->alive=false;return 1;
}
RpAtomic *RpAtomicCreate(void)
{
