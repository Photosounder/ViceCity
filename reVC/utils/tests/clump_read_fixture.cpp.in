    for(unsigned old=0;old<2;++old)for(int total=0;total<=6;++total){prime(120+old*10+total);RwStream first=makeStream(150+old*10+total,1,total,3,3,old!=0);require(run(OP_Start,&first).number==1);RwStream second=makeStream(180+old*10+total,1,total,3,3,old!=0);second.geometryBase=first.geometryBase;RpClump *clump=(RpClump*)run(OP_Finish,&second).pointer;require(clump&&clump->count==3&&clump->frame&&clump->frame->alive);for(unsigned i=0;i<3;++i){require(clump->atomics[i]->flags==UINT32_C(0x80000040)+i);RpGeometry *geometry=clump->atomics[i]->geometry;unsigned refs=0;for(unsigned j=0;j<3;++j)if(clump->atomics[j]->geometry==geometry)++refs;require(geometry->refs==refs);}snapshot();RpClumpDestroy(clump);run(OP_Cancel);}
    // Cover every first-stage failure and explicit caller cancellation with the actual original partial-state behavior
    for(unsigned mode=0;mode<7;++mode){prime(220+mode);RwStream first=makeStream(240+mode,1,4,2);if(mode==0)first.missingKind=rwID_STRUCT;if(mode==1)first.shortSection=0;if(mode==2)first.missingKind=rwID_FRAMELIST;if(mode==3)first.failFrames=true;if(mode==4)first.missingKind=rwID_GEOMETRYLIST;if(mode==5)first.failGeometryChunk=1;if(mode==6)first.failGeometryRead=1;require(run(OP_Start,&first).number==0);snapshot();run(OP_Cancel);}
