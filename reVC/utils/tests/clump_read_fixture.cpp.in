static void controls(void)
{
    // Reset only independent external failure controls between public owner scenarios
    failAllocation=false;failAtomic=false;failClump=false;
}
static void prime(unsigned id)
{
    // Begin a valid empty transaction to overwrite prior private geometry state without modifying the producer
    controls();RwStream stream=makeStream(id,1,0,0,1);require(run(OP_Start,&stream).number==1);run(OP_Cancel);require(observedFrames&&observedFrames->numFrames==0&&!observedFrames->frames);
