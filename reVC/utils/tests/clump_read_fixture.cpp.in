static void requireAt(bool value,unsigned line)
{
    // Stop quietly at the failing diagnostic line without invoking native dialogs
    ++checks;if(!value){fprintf(stderr,"line=%u checks=%u commands=%u\n",line,checks,commands);abort();}
}
#define require(value) requireAt((value),__LINE__)
static void hashBytes(const void *memory,size_t count)
