static void listSnapshot(FixtureGeometryList *list)
{
    // Observe exact geometry slot initialization and replacement through the real public record
    hashBytes(&list->numGeoms,sizeof(list->numGeoms));for(int i=0;i<list->numGeoms;++i){RpGeometry *geometry=(RpGeometry*)list->geometries[i];uint32_t id=geometry?geometry->id:0;hashBytes(&id,4);}
