    // Observe the precise original free sequence including null SDK frame-list releases
    if(!memory){event(3,UINT32_MAX);return;}unsigned i=0;while(i<allocations&&storage[i].memory!=memory)++i;require(i<allocations);event(3,i,storage[i].kind);storage[i].memory=NULL;++frees;_aligned_free(memory);
}
extern "C" void re3_assert(const char *expression,const char*,unsigned int line,const char*)
{
    // Report unexpected original-owner assertions without opening a native window
    fprintf(stderr,"owner assertion=%s line=%u\n",expression,line);require(false);
}
int32_t RwStream::tell(void)
{
    // Preserve each native SDK position query at the saved/resumed stream boundary
    event(4,id,(uint32_t)position);return position;
}
RwBool RwStreamFindChunk(RwStream *stream,uint32_t kind,uint32_t *size,uint32_t *version)
{
