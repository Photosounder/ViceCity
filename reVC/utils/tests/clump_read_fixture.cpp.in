    uint32_t values[]={operation,a,b};hashBytes(values,sizeof(values));++events;
}
static ClumpResult run(unsigned operation,void *a=NULL,void *b=NULL,void *c=NULL)
{
    // Exercise all complete original or C algorithms through independent callers
    ++commands;return TestClump(operation,a,b,c);
}
static void position(RwStream *stream,int value)
{
    // Keep only the controlled SDK cursor representations synchronized
    stream->position=value;stream->Type.memory.position=(uint32_t)value;
}
static RwStream makeStream(unsigned id,int mode,int geoms,int atoms=0,int numFrames=3,bool old=false)
{
    // Supply controlled SDK packet metadata rather than implementing clump splitting or cleanup
    RwStream stream={};stream.id=id;stream.mode=mode;stream.section=mode==1?0:mode==2?2:1;stream.totalGeometries=geoms;stream.totalAtomics=atoms;stream.totalFrames=numFrames;stream.failGeometryChunk=-1;stream.failGeometryRead=-1;stream.failAtomicChunk=-1;stream.missingKind=-1;stream.shortSection=-1;stream.version=old?0x32000:0x34000;stream.atomicSize=16;return stream;
