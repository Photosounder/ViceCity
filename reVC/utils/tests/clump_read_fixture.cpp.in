    // Observe initialized scalar data while excluding process-specific pointer values
    const uint8_t *bytes=(const uint8_t*)memory;for(size_t i=0;i<count;++i){hashValue^=bytes[i];hashValue*=UINT64_C(1099511628211);}
}
static void event(uint32_t operation,uint32_t a=0,uint32_t b=0)
