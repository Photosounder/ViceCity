    require(stream&&kind>=rwID_STRUCT&&kind<=rwID_ATOMIC);event(5,stream->id,kind);if((int)kind==stream->missingKind)return 0;if(kind==rwID_GEOMETRY){int limit=stream->totalGeometries;if(stream->mode==2||!limit)limit=stream->mode==2?1:stream->totalAtomics;if(stream->nextGeometry>=limit||stream->nextGeometry==stream->failGeometryChunk)return 0;}if(kind==rwID_ATOMIC&&stream->nextAtomic==stream->failAtomicChunk)return 0;if(kind==rwID_GEOMETRYLIST)stream->section=1;if(kind==rwID_ATOMIC)stream->section=2;if(size)*size=stream->section==0?(stream->version>=0x33000?12:4):stream->section==2?stream->atomicSize:4;if(version)*version=stream->version;position(stream,stream->position+12);return 1;
