    event(9,failAtomic);if(failAtomic)return NULL;require(atomicCount<4095);RpAtomic *atomic=&atomics[++atomicCount];atomic->id=atomicCount;atomic->alive=true;atomic->flags=0;atomic->frame=NULL;atomic->geometry=NULL;return atomic;
}
RwBool RpAtomicDestroy(RpAtomic *atomic)
{
    // Release only the SDK atomic's own geometry reference
    require(atomic&&atomic->alive);event(10,atomic->id);if(atomic->geometry)RpGeometryDestroy(atomic->geometry);atomic->alive=false;return 1;
}
RpAtomic *RpAtomicSetFlags(RpAtomic *atomic,uint32_t flags)
{
    // Record the original serialized flag bits at the typed SDK boundary
    require(atomic&&atomic->alive);event(11,atomic->id,flags);atomic->flags=flags;return atomic;
}
RpAtomic *RpAtomicSetFrame(RpAtomic *atomic,RwFrame *frame)
{
    // Borrow the actual selected SDK frame without changing its owner
    require(atomic&&atomic->alive&&frame&&frame->alive);event(12,atomic->id,frame->id);atomic->frame=frame;return atomic;
}
RpAtomic *RpAtomicSetGeometry(RpAtomic *atomic,RpGeometry *geometry,uint32_t flags)
{
    // Retain one SDK reference for every actual atomic attachment
    require(atomic&&atomic->alive&&geometry&&geometry->alive&&flags==0);event(13,atomic->id,geometry->id);if(atomic->geometry)RpGeometryDestroy(atomic->geometry);atomic->geometry=geometry;++geometry->refs;return atomic;
}
rwFrameList *rwFrameListStreamRead(RwStream *stream,rwFrameList *list)
{
    // Mutate the same SDK record before callbacks so the C bridge must preserve in-place visibility
    require(stream&&list);event(14,stream->id);observedFrames=list;list->numFrames=0;list->frames=NULL;if(stream->failFrames)return NULL;list->numFrames=stream->totalFrames;if(list->numFrames){list->frames=(RwFrame**)allocate(sizeof(RwFrame*)*list->numFrames,1);unsigned root=frameCount+1;for(int i=0;i<list->numFrames;++i){require(frameCount<8191);RwFrame *frame=&frames[++frameCount];frame->id=frameCount;frame->root=root;frame->alive=true;list->frames[i]=frame;}}position(stream,stream->position+8+stream->totalFrames*16);if(stream->cancelInFrames){++reentries;event(15);run(OP_Cancel);require(list->numFrames==0&&list->frames==NULL);}return list;
