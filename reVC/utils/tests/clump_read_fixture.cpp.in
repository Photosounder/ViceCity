    require(allocations<2048);void *memory=_aligned_malloc(size?size:1,16);require(memory!=NULL);memset(memory,0xa5,size?size:1);storage[allocations].memory=memory;storage[allocations].size=size;storage[allocations].kind=kind;event(1,allocations,(uint32_t)size);++allocations;return memory;
}
void *RwMalloc(size_t size)
{
