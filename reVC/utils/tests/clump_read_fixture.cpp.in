    event(18,failClump);if(failClump)return NULL;require(clumpCount<2047);RpClump *clump=&clumps[++clumpCount];clump->id=clumpCount;clump->count=0;clump->alive=true;clump->frame=NULL;return clump;
}
RpClump *RpClumpSetFrame(RpClump *clump,RwFrame *frame)
{
    // Attach the original root frame chosen by the actual clump reader
    require(clump&&clump->alive&&frame&&frame->alive);event(19,clump->id,frame->id);clump->frame=frame;return clump;
