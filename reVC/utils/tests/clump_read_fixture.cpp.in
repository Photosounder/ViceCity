int main(void)
{
    // Compare complete odd/even/empty geometry lists using both original splitting stages
    for(int total=0;total<=9;++total){FixtureGeometryList list={};RwStream stream=makeStream(10+total,0,total);require(run(OP_Geometry1,&stream,&list).pointer==&list&&list.numGeoms==total);for(int i=0;i<total;++i)require((list.geometries[i]!=NULL)==(i<total/2));listSnapshot(&list);require(run(OP_Geometry2,&stream,&list).pointer==&list);for(int i=0;i<total;++i)require(list.geometries[i]!=NULL);listSnapshot(&list);run(OP_Deinitialize,&list);require(list.numGeoms==0);snapshot();}
    // Exercise allocation, structure-read and geometry decode failures without assuming extra original cleanup
    for(unsigned mode=0;mode<5;++mode){FixtureGeometryList list={};RwStream stream=makeStream(30+mode,0,4);if(mode==0)stream.missingKind=rwID_STRUCT;if(mode==1)stream.shortSection=1;if(mode==2)failAllocation=true;if(mode==3)stream.failGeometryChunk=1;if(mode==4)stream.failGeometryRead=1;require(run(OP_Geometry1,&stream,&list).pointer==NULL);snapshot();failAllocation=false;if(list.geometries)run(OP_Deinitialize,&list);}
    // Compare inline and shared geometry, missing frames, partial atomic headers and all atomic error branches
    for(unsigned mode=0;mode<7;++mode){rwFrameList frameList={};RwStream frameStream=makeStream(50+mode,1,0,0,mode==1?0:3);require(rwFrameListStreamRead(&frameStream,&frameList));FixtureGeometryList list={};bool shared=mode==2;if(shared){RwStream geometry=makeStream(70,0,2);require(run(OP_Geometry1,&geometry,&list).pointer);require(run(OP_Geometry2,&geometry,&list).pointer);}RwStream stream=makeStream(80+mode,2,1,1,frameList.numFrames);stream.atomicSize=mode==1?12:16;if(mode==3)failAtomic=true;if(mode==4)stream.missingKind=rwID_GEOMETRY;if(mode==5)stream.failGeometryRead=0;if(mode==6)stream.shortSection=2;RpAtomic *atomic=(RpAtomic*)run(OP_Atomic,&stream,&frameList,&list).pointer;require((atomic!=NULL)==(mode<3));if(atomic){require(atomic->flags==UINT32_C(0x80000040)&&atomic->frame==(frameList.numFrames?frameList.frames[0]:NULL));require(atomic->geometry&&atomic->geometry->refs==(shared?2u:1u));}controls();run(OP_Deinitialize,&list);if(atomic)RpAtomicDestroy(atomic);rwFrameListDeinitialize(&frameList);snapshot();}
    // Preserve the atomic reader's shared-counter reset rather than silently repairing that original side effect
    FixtureGeometryList list={};RwStream stream=makeStream(100,0,4);require(run(OP_Geometry1,&stream,&list).pointer);RpGeometry *lost0=(RpGeometry*)list.geometries[0],*lost1=(RpGeometry*)list.geometries[1];FixtureGeometryList empty={};rwFrameList noFrames={};RwStream invalid=makeStream(101,2,1,1,0);invalid.missingKind=rwID_STRUCT;require(run(OP_Atomic,&invalid,&noFrames,&empty).pointer==NULL);require(run(OP_Geometry2,&stream,&list).pointer==NULL&&list.geometries[2]==NULL&&list.geometries[3]==NULL);require(list.geometries[0]!=lost0&&list.geometries[1]!=lost1);listSnapshot(&list);snapshot();run(OP_Deinitialize,&list);RpGeometryDestroy(lost0);RpGeometryDestroy(lost1);
