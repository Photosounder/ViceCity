    for(unsigned i=1;i<=geometryCount;++i){uint32_t values[]={geometries[i].id,geometries[i].refs,geometries[i].alive};hashBytes(values,sizeof(values));}for(unsigned i=1;i<=atomicCount;++i){RpAtomic *atomic=&atomics[i];uint32_t values[]={atomic->id,atomic->alive,atomic->flags,atomic->frame?atomic->frame->id:0,atomic->geometry?atomic->geometry->id:0};hashBytes(values,sizeof(values));}for(unsigned i=1;i<=frameCount;++i){uint32_t values[]={frames[i].id,frames[i].root,frames[i].alive};hashBytes(values,sizeof(values));}if(observedFrames){uint32_t values[]={(uint32_t)observedFrames->numFrames,observedFrames->frames!=NULL};hashBytes(values,sizeof(values));}
