    prime(260);failAllocation=true;RwStream first=makeStream(261,1,4,2);require(run(OP_Start,&first).number==0);snapshot();prime(262);
    // Cover clump allocation, remaining geometry, atomic chunk/create/read and inline geometry failures in stage two
    for(unsigned mode=0;mode<7;++mode){prime(280+mode);int total=mode==6?0:4;RwStream first=makeStream(300+mode,1,total,3);require(run(OP_Start,&first).number==1);RwStream second=makeStream(320+mode,1,total,3);second.geometryBase=first.geometryBase;if(mode==0)failClump=true;if(mode==1)second.failGeometryChunk=2;if(mode==2)second.failGeometryRead=2;if(mode==3)second.failAtomicChunk=1;if(mode==4)failAtomic=true;if(mode==5)second.shortSection=2;if(mode==6)second.failGeometryRead=0;require(run(OP_Finish,&second).pointer==NULL);snapshot();controls();run(OP_Cancel);}
