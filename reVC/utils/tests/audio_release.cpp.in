@METHOD@
static void prepare(unsigned seed) {
    // Seed both queue roles, current matches and bounded attachment/fading arithmetic
    seedValue=seed;active=&owners[seed&1];memset(active,0,sizeof(*active));
    memset(entities,0,sizeof(entities));
    active->m_nActiveQueue=(seed>>1)&1;
    active->m_nActiveSamples=seed%4==0?2:seed%4==1?4:seed%4==2?8:NUM_CHANNELS_GENERIC;
    active->m_bIsInitialised=(seed>>2)&1;
    active->m_bReduceReleasingPriority=(seed>>3)&1;
    active->m_bDynamicAcousticModelingStatus=(seed>>4)&1;
    unsigned previous=active->m_nActiveQueue^1;
    active->m_nRequestedCount[previous]=8;
    active->m_nRequestedCount[active->m_nActiveQueue]=seed%3==0?active->m_nActiveSamples:seed%3==1?0:1;
    for(unsigned queue=0;queue<2;++queue)
        for(unsigned i=0;i<NUM_CHANNELS_GENERIC;++i) {
            active->m_aRequestedOrderList[queue][i]=i;
            tSound &sound=active->m_aRequestedQueue[queue][i];
            sound.m_nEntityIndex=100+i;sound.m_nCounter=200+i;
            sound.m_nSampleIndex=1;sound.m_nFinalPriority=10000+i;
        }
    for(unsigned i=0;i<8;++i) {
        active->m_aRequestedOrderList[previous][i]=7-i;
        tSound &sound=active->m_aRequestedQueue[previous][i];
        sound.m_nEntityIndex=i==6?-1:(int32_t)i;
        sound.m_nCounter=i==2?300:10+i;
        sound.m_nSampleIndex=(seed+i)%3==0?SAMPLEBANK_PED_START:(seed+i)%3==1?SAMPLEBANK_PED_END:1;
        sound.m_nPriority=(seed+i)%25;sound.m_nFrequency=22050;
        sound.m_nVolume=(seed+i)%32;sound.m_fDistance=(float)((seed+i)%3)*25.0f;
        sound.m_MaxDistance=100.0f;sound.m_vecPos={9,8,7};
        sound.m_bIs2D=(seed+i)%4==0 || i==7;
        sound.m_nLoopCount=(seed+i)%3==0?0:1;
        sound.m_bIsPlayingFinished=i==0 && (seed&16);
        sound.m_bStatic=1;sound.m_nVolumeChange=(seed+i)%3==0?-1:(seed+i)%3==1?0:3;
#ifdef FIX_BUGS
        const float frames[]={-1.0f,0.0f,0.25f,0.5f,1.0f,2.0f,5.0f,20.0f,100.0f};
        sound.m_nFramesToPlay=frames[(seed+i)%9];
        // Keep fractional lifetimes while avoiding the original out-of-range byte conversion
        if(sound.m_nFramesToPlay>0.0f && sound.m_nFramesToPlay<1.0f && sound.m_nVolumeChange==-1)
            sound.m_nVolumeChange=3;
#else
        const uint32_t frames[]={0,1,2,5,20,100};
        sound.m_nFramesToPlay=frames[(seed+i)%6];
#endif
#ifdef EXTERNAL_3D_SOUND
        sound.m_nEmittingVolume=(seed+i)%32;
#ifdef FIX_BUGS
        sound.m_nEmittingVolumeChange=2;
#endif
#endif
#ifdef AUDIO_REFLECTIONS
        sound.m_nReflectionDelay=i==2 && (seed&32)?3:0;
        sound.m_bReflections=0;
#endif
        entities[i].position={(float)((seed+i)%7)*20.0f,0,0};
        active->m_asAudioEntities[i].m_bIsUsed=1;
        active->m_asAudioEntities[i].m_nType=i==5?AUDIOTYPE_FRONTEND:AUDIOTYPE_PHYSICAL;
        active->m_asAudioEntities[i].m_pEntity=i==3?NULL:&entities[i];
    }
    // Match by entity and counter alone while deliberately changing the current sample index
    active->m_aRequestedQueue[active->m_nActiveQueue][0].m_nEntityIndex=1;
    active->m_aRequestedQueue[active->m_nActiveQueue][0].m_nCounter=11;
    active->m_aRequestedQueue[active->m_nActiveQueue][0].m_nSampleIndex=2;
}
int main(void) {
    // Compare direct C operations, repeated carryover and actual C callers for both owners
    for(unsigned seed=0;seed<256;++seed) {
        prepare(seed);@RELEASE@;observe();++cases;
        @RELEASE@;observe();++cases;
        prepare(seed);@CALLER@;observe();++cases;
    }
    printf("%u cases %u callbacks : %llu\n",cases,callbacks,(unsigned long long)digest);
    return 0;
}
