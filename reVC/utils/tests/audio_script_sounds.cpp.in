@METHODS@
static void prepare(unsigned seed) {
    // Initialize both owners and all valid script routing inputs without automatic padding
    unsigned variant=seed/256;seedValue=variant*257;currentId=(seed>>1)%NUM_AUDIOENTITIES;memset(owners,0,sizeof(owners));memset(scripts,0,sizeof(scripts));memset(&MusicManager,0,sizeof(MusicManager));memset(&player,0,sizeof(player));active=&owners[variant&1];camera={0,0,0};
    active->m_nActiveSamples=6;active->m_nActiveQueue=(seed>>1)&1;active->m_nRequestedCount[active->m_nActiveQueue]=seed%7;
    for(unsigned i=0;i<6;++i){active->m_aRequestedOrderList[active->m_nActiveQueue][i]=i;active->m_aRequestedQueue[active->m_nActiveQueue][i].m_nFinalPriority=100+i*900;}
