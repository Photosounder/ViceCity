    active->m_sQueueSample.m_nEntityIndex=seed;active->m_sQueueSample.m_nFrequency=999;active->m_sQueueSample.m_fDistance=-1;active->m_sQueueSample.m_nCounter=777;active->m_sQueueSample.m_MaxDistance=40;
