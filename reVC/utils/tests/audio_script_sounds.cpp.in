    scripts[0].Posn.x=positions[(seed/256)%29];scripts[1].Posn.x=2;scripts[0].Posn.z=(float)((seed/1024)%3)*50;
    scripts[0].AudioId=(int16_t)((seed%256)+(int)((seed/256)%4)*256-256);scripts[1].AudioId=SCRIPT_SOUND_NEW_BUILDING_CHURCH;
    active->m_asAudioEntities[currentId].m_pEntity=(variant&16)?NULL:&scripts[0];active->m_asAudioEntities[currentId].m_AudioEvents=(variant>>2)%4;active->m_asAudioEntities[currentId].m_awAudioEvent[0]=(int16_t)((seed%256)+(int)(variant%4)*256-256);
    active->m_sQueueSample.m_vecPos.x=scripts[0].Posn.x;active->m_sQueueSample.m_vecPos.z=scripts[0].Posn.z;
    MusicManager.m_nMusicMode.v=(variant&8)?MUSICMODE_GAME:MUSICMODE_FRONTEND;MusicManager.m_nPlayingTrack.v=variant%3==0?STREAMED_SOUND_MALIBU_AMBIENT:variant%3==1?STREAMED_SOUND_STRIPCLUB_AMBIENT:UINT32_MAX;player.m_nSurfaceTouched.v=(uint8_t)variant;
}
