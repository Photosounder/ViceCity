static void observe() {
    // Hash every initialized owner field with stable identities for real script pointers
    static cAudioManager copies[2];memcpy(copies,owners,sizeof(copies));
    for(unsigned i=0;i<2;++i){void *p=copies[i].m_asAudioEntities[currentId].m_pEntity;copies[i].m_asAudioEntities[currentId].m_pEntity=(void *)(uintptr_t)(p==&scripts[0]?1:p==&scripts[1]?2:0);}
