    // Exercise native font callbacks that change later canonical fields and screen dimensions
    for(unsigned callback=0;callback<4;callback++){
        Reset();GLOBAL(Status)=KILLFRENZY_ONGOING;GLOBAL(bStandardSoundAndMessages)=true;now=5000;mode=callback==0?0:callback==1?10:callback==2?11:12;armed=true;Run_Darkel_DrawMessages();Snapshot();
    }
}
int main()
{
    // Confirm canonical static startup before any original or C operation mutates the owner
    Check(GLOBAL(Status)==0&&GLOBAL(TimeLimit)==0&&GLOBAL(pStartMessage)==NULL);for(unsigned i=0;i<NUM_DEFAULT_MODELS;i++)Check(GLOBAL(RegisteredKills)[i]==0);
    Check((uintptr_t)&victim!=(uintptr_t)(CEntity*)&victim);Check((uintptr_t)&players[0]!=(uintptr_t)(CPed*)&players[0]);
    FadeCases();RegisterCases();WeaponCases();UpdateCases();DrawCases();fprintf(stdout,"states=%llu checks=%llu observations=%llu hash=%016llx\n",(unsigned long long)states,(unsigned long long)checks,(unsigned long long)observations,(unsigned long long)digest);return 0;
}
