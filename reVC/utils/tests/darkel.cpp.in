    else if(mode==8&&point==40&&identity==SOUND_RAMPAGE_KILL){triggered=true;victim.model.value=12;victim.bChrisCriminal.value=true;}
    else if(mode==9&&point==40&&identity==SOUND_RAMPAGE_CAR_BLOWN){triggered=true;vehicle.model.value=13;vehicle.appearance.value=VEHICLE_APPEARANCE_BOAT;}
    else if(mode==10&&point==50){triggered=true;GLOBAL(TimeOfFrenzyStart)-=250;GLOBAL(pStartMessage)=passed;}
    else if(mode==11&&point==53){triggered=true;GLOBAL(TimeLimit)=-1;RsGlobal.width=853;RsGlobal.height=481;}
    else if(mode==12&&point==56){triggered=true;GLOBAL(KillsNeeded)=-3;GLOBAL(pStartMessage)=NULL;}
    else if(mode==13&&point==60){triggered=true;GLOBAL(pStartMessage)=passed;}
