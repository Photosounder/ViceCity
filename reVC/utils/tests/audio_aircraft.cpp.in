@METHODS@
static void prepare(unsigned seed,unsigned kind) {
    // Cover every rotor branch, camera orientation and distance gate without resetting smoothing history
    seedValue=seed;padReads[0]=padReads[1]=0;active=&owners[seed&1];memset(active,0,sizeof(*active));memset(&params,0,sizeof(params));memset(cars,0,sizeof(cars));memset(&TheCamera,0,sizeof(TheCamera));
    const float pedals[]={0,0.001f,0.25f,0.5f,1};const float rotor[]={0,0.05f,0.0879f,0.088f,0.0881f,0.2199f,0.22f,0.2201f,0.3f};const int models[]={MI_SKIMMER,MI_HUNTER,MI_MAVERICK,MI_CADDY};
    for(unsigned i=0;i<2;++i){cars[i].bEngineOn={uint32_t((seed/3+i)&1),10};cars[i].m_modelIndex={models[(seed/5+i)%4],14};cars[i].m_fGasPedal={pedals[(seed/7+i)%5],12};cars[i].m_fBrakePedal={pedals[(seed/11+i)%5],15};cars[i].m_fMovingSpeed={rotor[(seed/13+i)%9],16};for(unsigned j=0;j<4;++j)cars[i].m_aWheelSpeed[j]={rotor[(seed/17+i+j)%9],17+j};cars[i].matrix.rx=1;cars[i].matrix.fy=(seed/19+i)&1?1:-1;cars[i].matrix.uz=1;cars[i].matrix.px=3*i;cars[i].matrix.py=5*i;cars[i].boot={float((seed/23+i)%40),float(i),float(i*3)};}
    TheCamera.matrix.attachment=(seed/61)&1?(void *)(uintptr_t)1:NULL;TheCamera.matrix.owned=(seed/67)&1;TheCamera.matrix.rx=1;TheCamera.matrix.fy=(seed/29)&1?1:-1;const float upValues[]={-1.0f,-0.5f,-0.0f,0.0f,0.5f,1.0f};TheCamera.matrix.uy=upValues[(seed/31)%6];TheCamera.matrix.uz=1;TheCamera.Cams[0].Mode={uint32_t((seed/37)&1),34};
    const float distances[]={0,1,399,400,401,624,625,626,899,900,901,1599,1600,1601,8099,8100,8101,19599,19600,19601,39999,40000,40001,62499,62500,62501,NAN,INFINITY};params.m_pVehicle=&cars[0];params.m_fDistance=distances[(seed/41)%28];params.m_bDistanceCalculated=(seed/43)%3;params.m_VehicleType=(seed/47)&1?VEHICLE_TYPE_HELI:VEHICLE_TYPE_CAR;
#ifndef FIX_BUGS
    // Keep the original uninitialized vanilla rear-position branch outside its read domain
    if(params.m_VehicleType==VEHICLE_TYPE_HELI&&params.m_fDistance<19600)params.m_VehicleType=VEHICLE_TYPE_CAR;
#endif
    // Seed owner distance and scratch fields to observe partial writes and position restoration
    active->m_nActiveSamples=1+(seed/53)%8;active->m_sQueueSample.m_fDistance=(seed/59)%(kind==0?251:201);active->m_sQueueSample.m_nEntityIndex=(int32_t)(seed%31)-15;active->m_sQueueSample.m_nCounter=777;active->m_sQueueSample.m_nSampleIndex=999;active->m_sQueueSample.m_nFrequency=12345;active->m_sQueueSample.m_nFramesToPlay=17;active->m_sQueueSample.m_vecPos={1,2,3};active->m_bDynamicAcousticModelingStatus=1;
#ifndef GTA_PS2
    // Seed desktop offsets before live backend queries
    active->m_sQueueSample.m_nLoopStart=123;active->m_sQueueSample.m_nLoopEnd=456;
#endif
    // Seed random storage to detect unintended changes
    for(unsigned i=0;i<5;++i)active->m_anRandomTable[i]=(int32_t)(seed*(i+1)%10001)-5000;
    if(!(params.m_fDistance<(kind==0?62500.0f:40000.0f)))params.m_pVehicle=NULL;
}
int main() {
#ifdef _WIN32
    // Keep sanitizer failures quiet
    SetErrorMode(3);
#endif
    // Compare repeated complete generators and all three smoothing histories on alternating owners
    for(unsigned seed=0;seed<8192;++seed)for(unsigned kind=0;kind<2;++kind){prepare(seed,kind);for(unsigned call=0;call<2;++call){value(@RUN@);observe();++cases;}}
#ifdef AUDIO_REFLECTIONS
    // Require long-distance, front, starting, propeller, rear and Cessna request setup
    for(unsigned i=0;i<6;++i)if(!layers[i])return 2;
#endif
#ifndef GTA_PS2
    // Require the live backend loop-offset path
    if(!offsetReads)return 3;
#endif
#ifdef GTA_PS2
    // Require both PS2 matrix assignment and destructor side effects
    if(!matrixUpdates||!matrixReleases)return 4;
#endif
    printf("%u cases %u callbacks %llu\n",cases,callbacks,(unsigned long long)digest);
}
