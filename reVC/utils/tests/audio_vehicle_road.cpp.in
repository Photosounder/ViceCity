    return 8000+seedValue%10000;
}
extern "C" uint32_t SampleManager_GetSampleLoopStartOffset(cSampleManager *,uint32_t sample) {
    // Change the live sample index between the original loop offset queries
    ++offsetCalls;event(71);value(sample);
    if(seedValue&2048) active->m_sQueueSample.m_nSampleIndex=SFX_RAIN;
    return sample*3;
}
extern "C" int32_t SampleManager_GetSampleLoopEndOffset(cSampleManager *,uint32_t sample) {
    // Observe constant tyre offsets or reread road offsets at the original query point
    ++offsetCalls;event(72);value(sample);return sample*5+100;
}
