        ++wetCalls;
        if(seedValue&4096) active->m_sQueueSample.m_nCounter=777;
    }
}
extern "C" uint32_t SampleManager_GetSampleBaseFrequency(cSampleManager *,uint32_t sample) {
    // Observe road sample selection and mutate the live sample index before offset queries
    ++baseCalls;event(70);value(sample);
