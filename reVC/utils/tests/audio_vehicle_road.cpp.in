static void bytes(const void *p,unsigned size) {
    // Observe every initialized scalar and padding byte in four-byte words
    const unsigned char *data=(const unsigned char *)p;
    for(unsigned i=0;i<size;i+=4) {uint32_t word;memcpy(&word,data+i,4);value(word);}
}
static void observe() {
    // Normalize game pointer identities before observing owner, parameters and vehicle data
    cVehicleParams copy=params;
    unsigned id=params.m_pVehicle==&cars[0]?1:params.m_pVehicle==&cars[1]?2:params.m_pVehicle==&bikes[0]?3:params.m_pVehicle==&bikes[1]?4:0;
    copy.m_pVehicle=(CVehicle *)(uintptr_t)id;
    copy.m_pTransmission=(cTransmission *)(uintptr_t)(params.m_pTransmission==&transmissions[0]?1:params.m_pTransmission==&transmissions[1]?2:0);
    bytes(active,sizeof(*active));bytes(&copy,sizeof(copy));bytes(cars,sizeof(cars));bytes(bikes,sizeof(bikes));bytes(transmissions,sizeof(transmissions));bytes(&CWeather::WetRoads,sizeof(CWeather::WetRoads));
}
static void event(unsigned token) {
    // Observe exact game field reads and change later reads without unsequenced velocity writes
    ++callbacks;value(token);observe();
    if(token>=10 && token<20) {
        ++statusCalls;
        if(seedValue&1024) params.m_pVehicle=params.m_VehicleType==VEHICLE_TYPE_CAR?(CVehicle *)&cars[1]:(CVehicle *)&bikes[1];
    } else if(token>=20 && token<30) ++timerCalls;
    else if(token==30) ++groundCalls;
