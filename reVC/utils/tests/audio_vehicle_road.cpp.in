@METHODS@
static void prepare(unsigned seed,unsigned kind) {
    // Seed all vehicle kinds, wheels, velocity thresholds, transmission gates and retained sound fields
    seedValue=seed;active=&owners[seed&1];memset(active,0,sizeof(*active));memset(&params,0,sizeof(params));memset(cars,0,sizeof(cars));memset(bikes,0,sizeof(bikes));memset(transmissions,0,sizeof(transmissions));
    active->m_nActiveSamples=6;active->m_nActiveQueue=(seed>>1)&1;active->m_bIsInitialised=(seed>>2)&1;active->m_bIsPaused=(seed>>3)&1;
    active->m_nRequestedCount[active->m_nActiveQueue]=seed%7;
    for(unsigned i=0;i<6;++i) {active->m_aRequestedOrderList[active->m_nActiveQueue][i]=i;active->m_aRequestedQueue[active->m_nActiveQueue][i].m_nFinalPriority=100+i*800;}
    const int types[]={VEHICLE_TYPE_CAR,VEHICLE_TYPE_BIKE,VEHICLE_TYPE_BOAT,-1,99};
    const float speeds[]={0.0f,-0.0f,0.001f,0.02999f,0.03f,0.03001f,0.1f,-0.1f,1.0f,-10.0f,INFINITY,NAN};
    const float maxima[]={0.0f,0.1f,1.0f,10.0f,100.0f};
    const float ranges[]={-1.0f,0.0f,4.0f,100.0f,3599.0f,3600.0f,3601.0f,899.99f,900.0f,900.01f,9024.99f,9025.0f,9025.01f,INFINITY,NAN};
    const float timers[]={-1.0f,0.0f,0.01f,1.0f,NAN};
    const float wetness[]={0.0f,0.01f,0.5f,1.0f};
    params.m_VehicleType=types[seed%5];params.m_pVehicle=params.m_VehicleType==VEHICLE_TYPE_BIKE?(CVehicle *)&bikes[0]:(CVehicle *)&cars[0];
    params.m_fVelocityChange=speeds[(seed/5)%12];params.m_fDistance=ranges[(seed/60)%15];params.m_bDistanceCalculated=(seed/900)%4==0?0:(seed/900)%4==1?1:255;
    params.m_pTransmission=&transmissions[0];params.m_nIndex=seed;params.m_VehicleType=types[seed%5];
    for(unsigned obj=0;obj<2;++obj) {
        transmissions[obj].fMaxVelocity={obj?100.0f:maxima[(seed/11)%5],40};
        cars[obj].m_nSurfaceTouched={uint8_t((seed&128)?SURFACE_WATER:SURFACE_TARMAC),50};bikes[obj].m_nSurfaceTouched=cars[obj].m_nSurfaceTouched;
        cars[obj].m_nWheelsOnGround={uint8_t((seed/17+obj)%5),30};bikes[obj].m_nWheelsOnGround=cars[obj].m_nWheelsOnGround;
        for(unsigned wheel=0;wheel<4;++wheel) {
            cars[obj].Damage.status[wheel]={uint8_t((seed/19+wheel+obj)%3),10+wheel};cars[obj].m_aWheelTimer[wheel]={timers[(seed/23+wheel+obj)%5],20+wheel};
            if(wheel<2) {bikes[obj].m_wheelStatus[wheel]=cars[obj].Damage.status[wheel];bikes[obj].m_aWheelTimer[wheel]=cars[obj].m_aWheelTimer[wheel];}
        }
    }
    CWeather::WetRoads={wetness[(seed/29)%4],60};
    active->m_sQueueSample.m_fDistance=(float)(seed%31);active->m_sQueueSample.m_nVolume=77;active->m_sQueueSample.m_nCounter=999;active->m_sQueueSample.m_nFrequency=54321;active->m_sQueueSample.m_vecPos={1,2,3};active->m_sQueueSample.m_nFramesToPlay=17;
    if(kind && seed%13==0) params.m_pTransmission=NULL;
    // Reject NaN tyre modifiers before undefined float conversion while preserving dry/wet NaN velocity gates
    if(!kind && isnan(params.m_fVelocityChange)) params.m_fVelocityChange=0.0f;
}
int main() {
#ifdef _WIN32
    // Keep sanitizer failures quiet instead of opening a Windows crash dialog
    SetErrorMode(3);
#endif
    // Compare all three generators across actual C callers and original in-range return values
    for(unsigned seed=0;seed<8192;++seed) for(unsigned kind=0;kind<3;++kind) {
        prepare(seed,kind);value(@RUN@);observe();++cases;
    }
    // Require wheel status, contact, transmission, wetness and sample selection boundaries
    if(!statusCalls || !timerCalls || !groundCalls || !maxCalls || !surfaceCalls || !wetCalls || !baseCalls) return 2;
#ifndef GTA_PS2
    if(!offsetCalls) return 3;
#endif
#ifdef AUDIO_REFLECTIONS
    if(!requestCalls) return 4;
#endif
    printf("%u cases %u callbacks %llu\n",cases,callbacks,(unsigned long long)digest);
}
