    for(unsigned type=0;type<4;++type){alignas(4) unsigned char memory[32],expected[32];memset(memory,0xa5,32);memset(expected,0xa5,32);require(NativeKeyFrameDefault(type,memory)==memory&&memcmp(memory,expected,32)==0);observe(memory,sizes[type]);++states;}
