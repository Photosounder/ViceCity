        for(unsigned i=0;i<count;++i){KeyFrame *frame=sequence.GetKeyFrame(i);frame->rotation=Quaternion_Make(0.1f*(i%4),-0.2f,0.3f,0.75f);frame->deltaTime=((int)(i%7)-3)*0.125f;if(translated){KeyFrameTrans *full=(KeyFrameTrans*)frame;CVector value((float)i,-0.5f*i,0.25f*i);setTranslation(*full,value);}}
