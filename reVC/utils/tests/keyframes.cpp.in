        KeyFrameTransCompressed frame,prior;fill(&frame,16);uint16_t bits=(uint16_t)test;memcpy(&PACKED(frame).deltaTime,&bits,2);memcpy(&frame.trans[0],&bits,2);memcpy(&PACKED(frame).rot[0],&bits,2);memcpy(&prior,&frame,16);CQuaternion rotation;fill(&rotation,16);Run_GetRotation(&PACKED(frame),&rotation);result(rotation);float time=Run_GetTime(&PACKED(frame));observe(&time,4);float multiplied=PACKED(frame).deltaTime*(1.0f/60.0f);if(memcmp(&time,&multiplied,4))++timeDifferences;
        CVector translation;fill(&translation,12);Run_GetTranslation(&frame,&translation);vectorResult(translation);require(memcmp(&frame,&prior,16)==0);
        // Retain signed truncation across exact packed quanta and fractional boundaries
