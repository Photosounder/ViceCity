        Run_SetTime(&PACKED(frame),(n+fraction)/60.0f);require(memcmp(&frame,&prior,8)==0&&memcmp(frame.trans,prior.trans,6)==0);observe(&frame,16);memcpy(&prior,&frame,16);
        CVector position((n+fraction)/1024.0f,n/1024.0f,-(n+fraction)/1024.0f);if(n==-32768)position.z=32767.0f/1024.0f;Run_SetTranslation(&frame,&position);require(memcmp(&frame,&prior,10)==0);observe(&frame,16);KeyFrameTransCompressed copy=frame;require(memcmp(&copy,&frame,16)==0);++states;
    }
