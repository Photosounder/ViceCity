    // Observe each original preference read at the same native boundary
    ++languageReads;Hash(0x41);Hash(value);return value;
}
TextObservedInteger &TextObservedInteger::operator=(int next)
{
    // Assign the test preference without introducing an observed read
    value=next;return *this;
}
TextObservedFlag::operator bool()const
{
    // Observe the original short-circuit locale reads in their exact order
    ++localeReads;Hash(this==&CGame::russianGame?0x52:0x4a);Hash(value);return value;
}
TextObservedFlag &TextObservedFlag::operator=(bool next)
{
    // Assign the native locale flag without introducing an observed read
    value=next;return *this;
}
CMenuManager FrontEndMenuManager;
