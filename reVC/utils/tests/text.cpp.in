static uint64_t fingerprint=UINT64_C(1469598103934665603),checks,states,reads,clears,suspends,resumes,languageReads,localeReads;
static void Hash(uint64_t value)
{
    // Hash normalized values independently of native addresses and pointer width
    for(int i=0;i<8;i++){fingerprint^=(uint8_t)value;fingerprint*=UINT64_C(1099511628211);value>>=8;}
}
static void Bytes(const void *pointer,size_t size)
{
    // Compare initialized payload bytes while keeping unspecified padding out of observations
    const uint8_t *bytes=(const uint8_t *)pointer;Hash(size);for(size_t i=0;i<size;i++)Hash(bytes[i]);
}
static void Check(bool condition)
{
    // Stop the quiet console fixture at the first violated invariant
    ++checks;if(!condition){fprintf(stderr,"Text check failed at check %llu\n",(unsigned long long)checks);abort();}
}
static void Trace(const char *stage)
{
    // Emit optional phase fingerprints without changing the deterministic comparison itself
    if(getenv("TEXT_TRACE"))fprintf(stderr,"%s %016" PRIx64 "\n",stage,fingerprint);
}
TextObservedInteger::operator int()const
