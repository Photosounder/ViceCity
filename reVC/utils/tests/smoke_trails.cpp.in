static void reset(unsigned seed)
{
    // Seed every real field, native vertex and table while retaining valid gate preconditions
    hook=0;triggered=false;activeRecord=0;pedQueries=0;boneIndex=1;changingPeds=false;cameraVisible=true;transformSuccess=true;firstPerson=false;pedPresent=true;vehiclePresent=false;cutscene=false;clumpPresent=true;CustomPipes::bRenderingEnvMap=false;Timer_timeMs=10001+seed*97;TestSm_SetFlag(true);CWeather::Wind=.3f;
    for(int index=0;index<3;index++){
        // Include opacity, unused bytes and nonuniform positions in all retained records
        peds[index].identity=index;SmokeTrail t;for(int i=0;i<16;i++){t.m_pos[i].x=index*101.f+i*.17f;t.m_pos[i].y=i*-.23f;t.m_pos[i].z=50.f+index+i*.11f;t.m_time[i]=(int32_t)(Timer_timeMs-100-i*120);t.m_opacity[i]=.1f+(i%7)*.13f;}for(int i=0;i<536;i++)t.m_unused[i]=(char)((i+index+seed)&255);t.m_seed=index*2+(int)seed%13;TestSm_Set(index,&t);
    }
    for(int i=0;i<4;i++){matrices[i].pos.x=i*17.f;matrices[i].pos.y=-i*7.f;matrices[i].pos.z=80.f+i;}for(int i=0;i<32;i++)TestSm_SetIndex(i,initialIndices[i]);for(int i=0;i<16;i++)TestSm_SetRandom(i,initialRandom[i]);
    for(int i=0;i<512;i++){
