        RwIm3DVertex &v=TempBufferRenderVertices[i];v.setX(i*.125f);v.setY(-i*.25f);v.setZ(17.f);v.setColor(13,27,41,55);v.setU(.25f);v.setV(.75f);
    }TempBufferVerticesStored=17;TempBufferIndicesStored=31;
}
int main(void)
{
    // Observe actual static storage and both partial initialization paths before any rendering
    TestSm_Tables(initialIndices,initialRandom);snapshot();reset(0);TestSm_InitOne(1,-3);snapshot();TestSm_Init();snapshot();require(TestSm_Flag());
    const int32_t ages[]={-3000,-1,0,1,149,150,151,2249,2250,2251,10000};
    for(int a=0;a<11;a++)for(int reflect=0;reflect<2;reflect++)for(int transform=0;transform<2;transform++){
        // Cover exact expiry, future timestamps, zero slots and both native transform outcomes
        reset(a);CustomPipes::bRenderingEnvMap=reflect!=0;transformSuccess=transform!=0;SmokeTrail t=TestSm_Get(0);for(int i=0;i<16;i++)t.m_time[i]=(int32_t)(Timer_timeMs-ages[(a+i)%11]);t.m_time[5]=0;t.m_time[9]=0;TestSm_Set(0,&t);renderOne(0);
    }
    const uint32_t times[]={0,1,149,150,151,2250,2251,0x7fffffff,0x80000000U,0xfffffff0U};
    const float opacities[]={0.f,.25f,.5f,1.f,2.f};
    for(int t=0;t<10;t++)for(int opacity=0;opacity<5;opacity++)for(int id=0;id<3;id++){
        // Preserve shift thresholds, unsigned timer wrap, aliased input capture and density clamping
        reset(t);Timer_timeMs=times[t];SmokeTrail record=TestSm_Get(id);record.m_time[0]=(int32_t)(Timer_timeMs-150);if(opacity==0)record.m_pos[1]=record.m_pos[2];TestSm_Set(id,&record);SmokeTrailVector p={31.f,-47.f,63.f};registrations++;TestSm_Register(id,p,opacities[opacity]);snapshot();Timer_timeMs++;registrations++;TestSm_Alias(id,(id+3)%16,opacities[opacity]);snapshot();renderOne(id);
    }
    for(int opacity=0;opacity<5;opacity++){
        // Retain the original infinite zero-distance density followed by finite opacity saturation
        reset(opacity);SmokeTrail t=TestSm_Get(0);t.m_time[0]=0;t.m_pos[1]=t.m_pos[2];TestSm_Set(0,&t);SmokeTrailVector p={31.f,-47.f,63.f};registrations++;TestSm_Register(0,p,opacities[opacity]);t=TestSm_Get(0);require(t.m_opacity[1]==opacities[opacity]);snapshot();
    }
    for(int mask=0;mask<17;mask++){
        // Verify sparse writes retain original indices instead of compacting active points
        reset(mask);SmokeTrail t=TestSm_Get(0);for(int i=0;i<16;i++)t.m_time[i]=i<mask && i%3!=1?(int32_t)Timer_timeMs:0;TestSm_Set(0,&t);renderOne(0);
    }
    for(int gate=0;gate<7;gate++){
        // Exercise every ordered controller early return independently and one complete successful path
        reset(gate);TestSm_SetFlag(gate!=0);firstPerson=gate==1;pedPresent=gate!=2;vehiclePresent=gate==3;cutscene=gate==4;clumpPresent=gate!=5;update();
    }
    for(int h=1;h<=12;h++){
        // Preserve live timer/table/record reads, player selection and nested native point lifetimes
        reset(h);hook=h;if(h>=6 && h<=11)update();else renderOne(0);require(triggered);snapshot();
    }
    reset(0);TestSm_Init();
    for(int frame=0;frame<900;frame++){
        // Keep real retained positions and opacity across mixed registration, expiry and reflection frames
        Timer_timeMs+=frame%7==0?151:73;TestSm_SetFlag(frame%17!=0);firstPerson=frame%29==0;vehiclePresent=frame%31==0;cutscene=frame%37==0;clumpPresent=frame%41!=0;changingPeds=frame%3==0;CWeather::Wind=(frame%13-6)*.13f;CustomPipes::bRenderingEnvMap=frame%5==0;transformSuccess=frame%11!=0;cameraVisible=frame%19!=0;matrices[1].pos.x=frame*.11f;update();renders++;TestSm_Render();snapshot();if(frame%97==0){TestSm_Init();snapshot();}
    }
    require(states>5000 && transforms>1000 && pointTransforms>1000 && draws==ends);printf("states=%u calls=%u registrations=%u updates=%u renders=%u queries=%u pointTransforms=%u transforms=%u draws=%u hash=%016llx\n",states,calls,registrations,updates,renders,queries,pointTransforms,transforms,draws,(unsigned long long)hash);
