static void value(uint32_t v) {
    // Hash observed values reproducibly
    digest=(digest^v)*1099511628211ULL;
}
static void bytes(const void *p,unsigned size) {
    // Hash initialized storage without aliasing the records
    const unsigned char *data=(const unsigned char *)p;
    for(unsigned i=0;i<size;i+=4) {uint32_t word=0;unsigned remaining=size-i;memcpy(&word,data+i,remaining<4?remaining:4);value(word);}
}
static unsigned identity(const CVehicle *v) {
    // Normalize game pointers across before and after processes
    return v==vehicles[0]?1:v==vehicles[1]?2:v==vehicles[2]?3:0;
}
static void observe() {
    // Compare all owner and parameter state and the original gas-audio storage
    cVehicleParams copy=params;copy.m_pVehicle=(CVehicle *)(uintptr_t)identity(params.m_pVehicle);
    copy.m_pTransmission=(cTransmission *)(uintptr_t)(params.m_pTransmission==&transmissions[0]?1:params.m_pTransmission==&transmissions[1]?2:0);
    bytes(active,sizeof(*active));bytes(&copy,sizeof(copy));bytes(cars,sizeof(cars));bytes(bikes,sizeof(bikes));bytes(transmissions,sizeof(transmissions));
}
