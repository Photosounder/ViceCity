template<class T> static void prepareVehicle(T &v,unsigned seed,unsigned index) {
    // Populate defined car and bike inputs with zeroed padding
    memset(&v,0,sizeof(v));const int models[]={MI_PIZZABOY,MI_FAGGIO,MI_CADDY,MI_LANDSTAL};
    v.model=(int16_t)models[(seed/3+index)%4];v.status=seed%7;v.bEngineOn={seed%3!=0,22};v.bIsHandbrakeOn={(seed/5)%2,23};v.bIsDrowning={(seed/7)%2,24};v.m_nCurrentGear={(seed/11)%6,25};v.m_fGasPedal={seed%2?0.5f:0.0f,26};
    v.m_nDriveWheelsOnGround={(seed/13)%3,27};v.m_nDriveWheelsOnGroundPrev={(seed/17)%3,28};v.m_fGasPedalAudio=(seed%5)*0.2f;
    for(unsigned w=0;w<sizeof(v.m_aWheelState)/sizeof(v.m_aWheelState[0]);++w)v.m_aWheelState[w]=(enum tWheelState)((seed/19+w)%4);
}
static void prepare(unsigned seed) {
    // Cover range gates, gears, wheel states, drivetrain, models and safe transmission boundaries
    seedValue=seed;active=&owners[seed&1];memset(active,0,sizeof(*active));memset(&params,0,sizeof(params));memset(transmissions,0,sizeof(transmissions));
    bool bike=(seed/23)%2;for(unsigned i=0;i<3;++i) {prepareVehicle(cars[i],seed,i);prepareVehicle(bikes[i],seed,i);vehicles[i]=bike?(CVehicle *)&bikes[i]:(CVehicle *)&cars[i];}
    if(bike)++bikeCases;else ++carCases;
    for(unsigned i=0;i<2;++i) {
        transmissions[i].nNumberOfGears={5,29};const char drives[]={'4','F','R','X'};transmissions[i].nDriveType={(unsigned)drives[(seed/29)%4],30};
        transmissions[i].fMaxVelocity={seed%31==0?0.0f:100.0f,31};transmissions[i].fMaxReverseVelocity={-100.0f,32};
        for(unsigned g=0;g<6;++g) {transmissions[i].Gears[g].fShiftDownVelocity={0.0f,33};transmissions[i].Gears[g].fShiftUpVelocity={20.0f,34};}
    }
    for(unsigned i=0;i<8;++i) {aVehicleSettings[i]={SFX_CAR_REV_1+(int32_t)i,(uint8_t)(CAR_SFX_BANKS_OFFSET+i),{0,0,0}};}
    const float distances[]={-1.0f,0.0f,25.0f,100.0f,2499.0f,2500.0f,2501.0f,NAN,INFINITY};
    params.m_pVehicle=vehicles[0];params.m_pTransmission=&transmissions[0];params.m_VehicleType=seed%37==0?99:bike?VEHICLE_TYPE_BIKE:VEHICLE_TYPE_CAR;
    params.m_fDistance=distances[(seed/37)%9];params.m_bDistanceCalculated=(seed/333)%3;params.m_fVelocityChange=(seed/41)%3==0?0.0f:(seed/41)%3==1?0.5f:101.0f;params.m_nIndex=seed%8;playerId=(seed/43)%4;
    active->m_nActiveSamples=27;active->m_sQueueSample.m_fDistance=(float)(seed%51);active->m_sQueueSample.m_nEntityIndex=(int32_t)(seed%31)-15;active->m_sQueueSample.m_nCounter=999;active->m_sQueueSample.m_vecPos={1,2,3};
    if(seed%47==0) {params.m_pTransmission=NULL;vehicles[0]->status=STATUS_SIMPLE;vehicles[0]->m_fGasPedal.v=0.0f;}
    if(vehicles[0]->m_nCurrentGear.v==0 && params.m_fVelocityChange>100.0f)params.m_fVelocityChange=0.5f;
    if(!(params.m_fDistance<2500.0f))params.m_pVehicle=NULL;
}
int main() {
#ifdef _WIN32
    // Keep sanitizer failures quiet
    SetErrorMode(3);
#endif
    // Compare repeated generator calls on alternating owners across all defined branch inputs
    for(unsigned seed=0;seed<16384;++seed) {prepare(seed);value(@RUN@);observe();++cases;value(@RUN@);observe();++cases;}
    // Require both vehicle types and the player, unsupported and wrecked paths
    if(!carCases||!bikeCases||!playerCalls||!stops||!unknowns)return 2;
#ifndef GTA_PS2
    if(!offsets)return 3;
#endif
    printf("%u cases %u callbacks %llu\n",cases,callbacks,(unsigned long long)digest);
}
