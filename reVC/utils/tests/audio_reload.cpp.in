static void snapshot(void) {
    // Normalize entity pointer identities before observing all zero-padded owner bytes
    cAudioManager copy=*active;
    for(unsigned i=0;i<NUM_AUDIOENTITIES;++i) {
        uintptr_t pointer=(uintptr_t)copy.m_asAudioEntities[i].m_pEntity;
        uintptr_t base=(uintptr_t)scripts;
        if(pointer>=base && pointer<base+sizeof(scripts))
            copy.m_asAudioEntities[i].m_pEntity=(void *)(uintptr_t)(((pointer-base)/sizeof(*scripts))+1);
    }
    const unsigned char *bytes=(const unsigned char *)&copy;
    for(unsigned i=0;i<sizeof(copy);++i) value(bytes[i]);
    // Observe real pooled script storage, flags and the allocation cursor after each reset or deletion
    bytes=(const unsigned char *)scripts;
    for(unsigned i=0;i<sizeof(scripts);++i) value(bytes[i]);
    for(unsigned i=0;i<NUM_AUDIOENTITIES;++i) value(poolFlags[i]);
    value(pool.m_allocPtr);
}
