@METHODS@
static void prepare(unsigned seed,bool global) {
    // Seed valid queue bounds, mixed entity types and real pool slots with retained sentinel fields
    active=global?&AudioManager:&other;memset(active,0,sizeof(*active));memset(scripts,0,sizeof(scripts));
    pool.m_entries=(uint8_t *)scripts;pool.m_flags=poolFlags;pool.m_size=NUM_AUDIOENTITIES;pool.m_entrySize=sizeof(*scripts);pool.m_allocPtr=NUM_AUDIOENTITIES-1;
    active->m_bIsInitialised=seed&1;active->m_nActiveQueue=(seed>>1)&1;active->m_nActiveSamples=seed%4==0?1:seed%4==1?2:8;
    active->m_bIsPlayerShutUp=1;active->m_nTimer=0x87654321U;active->m_sAudioScriptObjectManager.m_nScriptObjectEntityTotal=17;
    for(unsigned queue=0;queue<2;++queue) {
        active->m_nRequestedCount[queue]=active->m_nActiveSamples;
        for(unsigned i=0;i<NUM_CHANNELS_GENERIC;++i) {
            active->m_aRequestedOrderList[queue][i]=i;
            active->m_aRequestedQueue[queue][i].m_nSampleIndex=i+1;
        }
    }
    for(unsigned i=0;i<NUM_CHANNELS_GENERIC;++i) {
        active->m_asActiveSamples[i].m_nSampleIndex=i+10;
        active->m_asActiveSamples[i].m_fDistance=31.5f;
    }
    for(unsigned i=0;i<2;++i) {
        active->m_nMissionAudioSampleIndex[i]=400+i;
        active->m_nMissionAudioLoadingStatus[i]=LOADING_STATUS_LOADED;
        active->m_bIsMissionAudioPlaying[i]=1;
        active->m_bIsMissionAudioAllowedToPlay[i]=1;
        active->m_nMissionAudioFramesToPlay[i]=17;
    }
    for(unsigned i=0;i<NUM_AUDIOENTITIES;++i) {
        active->m_aAudioEntityOrderList[i]=NUM_AUDIOENTITIES;
        scripts[i].AudioId=33;scripts[i].Posn={1,2,3};scripts[i].AudioEntity=i;
        poolFlags[i]=i&POOLFLAG_ID;
        tAudioEntity &entity=active->m_asAudioEntities[i];
        entity.m_bIsUsed=(seed+i)%3!=0;entity.m_bStatus=1;
        entity.m_nType=(eAudioType)((seed+i)%(TOTAL_AUDIO_TYPES+3));
        entity.m_pEntity=entity.m_nType==AUDIOTYPE_SCRIPTOBJECT?((seed+i)%7==0?NULL:&scripts[i]):(void *)(uintptr_t)0x123;
        if(entity.m_bIsUsed) active->m_aAudioEntityOrderList[active->m_nAudioEntitiesCount++]=i;
    }
}
int main(void) {
    // Compare direct helpers, repeated cleanup and live facades with all initialization and queue gates
    for(unsigned seed=0;seed<128;++seed) {
        uint32_t time=seed%5==0?UINT32_MAX:seed*1234567U;
        prepare(seed,false);@RESET@;snapshot();++cases;
        @DESTROY@;snapshot();++cases;
        @DESTROY@;snapshot();++cases;
        prepare(seed,true);@FACADE@;snapshot();++cases;
    }
    printf("%u cases %u callbacks : %llu\n",cases,callbacks,(unsigned long long)digest);
    return 0;
}
