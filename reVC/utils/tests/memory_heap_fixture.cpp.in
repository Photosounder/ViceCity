static void requireAt(bool value,unsigned line)
{
    // Stop quietly when a complete owner or external primitive contract differs
    ++checks;if(!value){fprintf(stderr,"check=%u commands=%u fixture-line=%u\n",checks,commands,line);abort();}
}
#define require(value) requireAt((value),__LINE__)
static void hashBytes(const void *data,size_t count)
