    // Observe initialized scalar and payload bytes independently of process-specific addresses
    const uint8_t *bytes=(const uint8_t*)data;for(size_t i=0;i<count;++i){hashValue^=bytes[i];hashValue*=UINT64_C(1099511628211);}
}
