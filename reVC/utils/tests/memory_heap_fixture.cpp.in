    ++snapshots;uint32_t state[]={gMainHeap.m_totalMemUsed,gMainHeap.m_totalBlocksUsed,gMainHeap.m_currentMemID,gMainHeap.m_idStack.sp,(uint32_t)numPtrs,(uint32_t)gPosnInList,m_ptrListIndexStack.sp,memMoved};hashBytes(state,sizeof(state));hashBytes(gMainHeap.m_memUsed,NUM_MEMIDS*4);hashBytes(gMainHeap.m_blocksUsed,NUM_MEMIDS*4);
    unsigned count=0;for(HeapBlockDesc *block=gMainHeap.m_start;block<gMainHeap.m_end;block=(HeapBlockDesc*)run(OP_HeapBlock_GetNextConsecutive,block).pointer){require(++count<10000&&block->m_size<backingSize);uint32_t values[]={address(block),block->m_size,(uint32_t)(int32_t)block->m_memId,(uint32_t)(int32_t)block->m_ptrListIndex};hashBytes(values,sizeof(values));}
    // Observe only initialized caller payloads because allocator slack can contain process addresses
    for(unsigned i=0;i<4100;++i)if(slots[i]&&slotSizes[i])hashBytes(slots[i],slotSizes[i]);
    for(unsigned i=0;i<NUM_FIXED_MEMBLOCKS;++i){CommonSize *list=&gMainHeap.m_fixedSize[i];uint32_t values[]={list->m_size,list->m_failed,list->m_remaining};hashBytes(values,sizeof(values));unsigned length=0;for(HeapBlockDesc *block=list->m_freeList.m_first.m_next;block!=&list->m_freeList.m_last;block=block->m_next){require(++length<10000);uint32_t offset=address(block);hashBytes(&offset,4);}hashBytes(&length,sizeof(length));}
    unsigned freeCount=0;for(HeapBlockDesc *block=gMainHeap.m_freeList.m_first.m_next;block!=&gMainHeap.m_freeList.m_last;block=block->m_next){require(++freeCount<10000);uint32_t values[]={address(block),block->m_size};hashBytes(values,sizeof(values));}
    fprintf(stderr,"snapshot=%u hash=%016llx\n",snapshots,(unsigned long long)hashValue);
}
