    if(!pointer)return UINT32_MAX;uintptr_t value=(uintptr_t)pointer,start=(uintptr_t)backing,owner=(uintptr_t)&gMainHeap;if(value>=start&&value<start+backingSize)return (uint32_t)(value-start);if(value>=owner&&value<owner+sizeof(gMainHeap))return 0x40000000u+(uint32_t)(value-owner);require(false);return 0;
}
static void event(uint32_t kind,uint32_t a=0,uint32_t b=0)
