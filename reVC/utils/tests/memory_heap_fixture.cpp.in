    ++commands;return TestHeap(operation,self,a,b,value);
}
static void *allocate(uint32_t size)
{
    // Use the complete allocator rather than replacing its block or fixed-list policy
    return run(OP_MemoryHeap_Malloc,&gMainHeap,NULL,NULL,size).pointer;
