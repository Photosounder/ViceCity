static void reset(unsigned seed)
{
    // Seed legal actual records, native fields, resource slots and all shared indices
    hook=0;triggered=false;activeRecord=0;matrixQueries=0;framePresent=true;matrixPresent=true;cameraVisible=true;transformSuccess=true;CustomPipes::bRenderingEnvMap=false;CustomPipes::EnvMapCam=(RwCamera *)0x5000;Timer_timeStep=1.f;TheCamera.position=CVector(100.f,0.f,600.f);matrices[0].pos.x=125.f;matrices[0].pos.y=3.f;matrices[0].pos.z=600.f;matrices[1].pos.x=175.f;matrices[1].pos.y=7.f;matrices[1].pos.z=601.f;
    for(int index=0;index<5;index++){
        // Include nonuniform positions so every segment normalization and stale value remains observable
        PlaneBanner b;for(int i=0;i<8;i++){b.m_pos[i].x=index*7.f+i*(7.f+seed*.01f);b.m_pos[i].y=i*.3f;b.m_pos[i].z=600.f+i*.1f;}TestPb_Set(index,&b);
    }
    for(int i=0;i<512;i++){
        // Initialize even untouched native tail fields through their actual typed accessors
        RwIm3DVertex &v=TempBufferRenderVertices[i];v.setX(i*.125f);v.setY(-i*.25f);v.setZ(17.f);v.setColor(13,27,41,55);v.setU(.25f);v.setV(.75f);
    }
    for(int i=0;i<1024;i++)TempBufferRenderIndexList[i]=(i*7+seed)&65535;for(int i=0;i<4;i++)gpRubbishTexture[i]=(void *)(uintptr_t)(0x3000+i*0x100);for(int i=0;i<40;i++)renderStates[i]=0;TempBufferVerticesStored=37;TempBufferIndicesStored=73;
}
int main(void)
{
    // Observe actual static initialization and both complete initializers before registration
    snapshot();reset(0);TestPb_InitOne(3);snapshot();TestPb_Init();snapshot();
    const float heights[]={-100.f,-60.f,-50.0001f,-50.f,-49.9999f,0.f,600.f};
    const float steps[]={-10.f,0.f,1.f,20.f,1000.f,5000.f};
    for(int h=0;h<7;h++)for(int s=0;s<6;s++){
        // Verify the strict activity gate, original fall/clamp and continued segment updates after clamping
        reset(h);PlaneBanner b=TestPb_Get(0);for(int i=0;i<8;i++)b.m_pos[i].z=heights[h]+i*.2f;TestPb_Set(0,&b);Timer_timeStep=steps[s];updates++;TestPb_UpdateOne(0);snapshot();renderOne(0);
    }
    const float distances[]={0.f,1.f,249.999f,250.f,250.001f,275.f,299.99f,300.f,300.01f,500.f};
    for(int d=0;d<10;d++)for(int visible=0;visible<2;visible++)for(int transform=0;transform<2;transform++){
        // Exercise exact fade/distance gates, sphere rejection, alpha narrowing and failed transforms
        reset(d);TheCamera.position=CVector(distances[d],0.f,600.f);cameraVisible=visible!=0;transformSuccess=transform!=0;renderOne(0);
    }
    const float lengths[]={0.f,7.9999f,8.f,8.0001f,19.f,100.f};
    for(int n=0;n<6;n++)for(int axis=0;axis<3;axis++){
        // Keep zero-length and exact eight-unit links plus every component of successive normalized segments
        reset(n);PlaneBanner b=TestPb_Get(0);for(int i=0;i<8;i++){b.m_pos[i].x=axis==0?i*lengths[n]:0.f;b.m_pos[i].y=axis==1?i*lengths[n]:0.f;b.m_pos[i].z=600.f+(axis==2?i*lengths[n]:0.f);}TestPb_Set(0,&b);Timer_timeStep=0.f;updates++;TestPb_UpdateOne(0);snapshot();
    }
    for(int id=0;id<5;id++)for(int slot=0;slot<8;slot++){
        // Capture by-value records, same-record aliases and the actual typed application input
        reset(id);registrations++;PlaneBannerVector p={13.25f,-17.5f,623.f};TestPb_Register(p,id);snapshot();registrations++;TestPb_RegisterAlias(id,slot,id);snapshot();CVector actual(31.f,-47.f,611.f);registrations++;TestPb_RegisterVector(&actual,id);snapshot();
    }
    for(int reflect=0;reflect<2;reflect++)for(int camera=0;camera<2;camera++)for(int frame=0;frame<2;frame++)for(int matrix=0;matrix<2;matrix++){
        // Verify every auxiliary-camera null gate and the main-camera fallback without collapsing matrix reads
        reset(0);CustomPipes::bRenderingEnvMap=reflect!=0;CustomPipes::EnvMapCam=camera?(RwCamera *)0x5000:NULL;framePresent=frame!=0;matrixPresent=matrix!=0;PlaneBannerVector position=TestPb_Camera();floating(position.x);floating(position.y);floating(position.z);snapshot();renderOne(0);
    }
    for(int h=1;h<=16;h++){
        // Exercise live camera/anchor ordering, counters, colors, UVs, resources, indices and nested rendering
        reset(h);hook=h;CustomPipes::bRenderingEnvMap=h==2 || h==3 || h==15 || h==16;renderOne(0);
#if defined(LIBRW) && defined(EXTENDED_PIPELINES)
        require(triggered);
#else
        if(h!=2 && h!=3 && h!=15 && h!=16)require(triggered);
#endif
        snapshot();
    }
    reset(0);TestPb_Init();
    for(int frame=0;frame<750;frame++){
        // Keep all five records across mixed registration, motion, visibility and reflection rendering
        PlaneBannerVector p={frame*.3f,-frame*.17f,600.f+frame%13};registrations++;TestPb_Register(p,frame%5);Timer_timeStep=frame%29==0?50.f:.5f+(frame%7)*.1f;updates++;TestPb_Update();TheCamera.position=CVector(p.x+frame%301,p.y,600.f);matrices[0].pos.x=TheCamera.position.x+17.f;matrices[0].pos.y=p.y+3.f;matrices[0].pos.z=604.f;CustomPipes::bRenderingEnvMap=frame%7==0;framePresent=frame%13!=0;matrixPresent=frame%17!=0;cameraVisible=frame%11!=0;transformSuccess=frame%19!=0;renders++;TestPb_Render();snapshot();if(frame%91==0){TestPb_InitOne(frame%5);snapshot();}
    }
    require(states>5000 && transforms>1000 && draws==ends);printf("states=%u calls=%u registrations=%u updates=%u renders=%u queries=%u transforms=%u draws=%u hash=%016llx\n",states,calls,registrations,updates,renders,queries,transforms,draws,(unsigned long long)hash);
}
