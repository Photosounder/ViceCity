CVector &CCamera::GetPosition(void)
{
    // Retain fallback camera reads and source-record mutations before vector copying
    event(1);queries++;mutation(1);vector(position);return position;
}
bool CCamera::IsSphereVisible(const CVector &center,float radius)
{
    // Observe the original visibility input before subsequent record changes
    event(2);queries++;vector(center);floating(radius);mutation(4);word(cameraVisible);return cameraVisible;
}
