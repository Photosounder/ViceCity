    if(triggered)return;
    if(hook==1 && point==1){triggered=true;mutateAnchor(37.f);TheCamera.position.y+=13.f;}
    else if(hook==2 && point==2){triggered=true;mutateAnchor(-19.f);matrices[0].pos.x+=29.f;}
    else if(hook==3 && point==3 && matrixQueries==2){triggered=true;mutateAnchor(23.f);matrices[1].pos.x=211.f;matrices[1].pos.z=607.f;}
    else if(hook==4 && point==4){triggered=true;mutateAnchor(600.f);}
    else if(hook==5 && point==5){triggered=true;mutateAnchor(47.f);TempBufferVerticesStored+=4;TempBufferIndicesStored+=9;}
    else if(hook==6 && point==6){triggered=true;TempBufferVerticesStored+=2;}
    else if(hook==7 && point==7){triggered=true;renderOne(1);}
    else if(hook==8 && point==8){triggered=true;TestPb_Init();}
    else if(hook==9 && point==9){triggered=true;renderOne(1);}
    else if(hook==10 && point==10){triggered=true;TempBufferVerticesStored=32;TempBufferIndicesStored=60;gpRubbishTexture[2]=(void *)0x4100;}
    else if(hook==11 && point==11){triggered=true;TempBufferRenderIndexList[0]=93;TempBufferIndicesStored=12;TempBufferVerticesStored=5;}
    else if(hook==12 && point==12){triggered=true;renderOne(1);TempBufferRenderIndexList[3]=35;}
    else if(hook==13 && point==13){triggered=true;TempBufferVerticesStored=77;TempBufferIndicesStored=89;}
