{
    // Capture the original destination before a callback changes the live shared count
    event(6);word((uint32_t)(v-TempBufferRenderVertices));word(r);word(g);word(b);word(a);mutation(5);v->setColor(r,g,b,a);
}
void RwIm3DVertexSetPos(RwIm3DVertex *v,RwReal x,RwReal y,RwReal z)
