void *RwIm3DTransform(RwIm3DVertex *v,RwUInt32 count,RwMatrix *matrix,RwUInt32 flags)
{
    // Compare all original native geometry, flags and live transform-count reads
    event(11);transforms++;require(v==TempBufferRenderVertices && count<=64 && matrix==NULL);word(count);word(flags);for(unsigned i=0;i<count;i++)vertex(v[i]);mutation(11);snapshot();word(transformSuccess);return transformSuccess?v:NULL;
