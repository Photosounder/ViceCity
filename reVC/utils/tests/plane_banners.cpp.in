static void require(bool condition)
{
    // Reject missed callback preconditions or invalid test buffer ranges immediately
    if(!condition)abort();
}
static void word(uint32_t value)
{
    // Compare every scalar bit through a deterministic byte-wise fingerprint
    for(int i=0;i<4;i++){hash^=(value>>(i*8))&255;hash*=1099511628211ULL;}
}
