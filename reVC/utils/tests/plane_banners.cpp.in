extern "C" void *Rubbish_BackendRaster(void *texture)
{
    // Capture the actual texture argument before changes to its canonical C-owned slot
    event(10);queries++;word((uint32_t)(uintptr_t)texture);mutation(10);return (void *)((uintptr_t)texture+0x100);
