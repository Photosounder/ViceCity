};
@MACROS@
static cAudioManager owners[2],*active;
static cVehicleParams params;
static CVehicle vehicles[2];
static unsigned seedValue,cases,callbacks,rainQueries,cameraQueries,playerQueries,requests;
static unsigned reads;
static float rain;
static bool cameraNoRain,playerNoRain;
static uint64_t digest=1469598103934665603ULL;
extern "C" void AudioRequests_Submit(cAudioManager *);
extern "C" void AudioVehicleRain_Process(cAudioManager *,cVehicleParams *);
extern "C" void TestVehicleRainC(cAudioManager *,cVehicleParams *);
static void value(uint32_t v) {
    // Hash scalar state and query order reproducibly
    digest=(digest^v)*1099511628211ULL;
}
static void observe() {
    // Observe complete owner and parameter bytes with stable vehicle identities
    cVehicleParams copy=params;copy.m_pVehicle=(CVehicle *)(uintptr_t)(params.m_pVehicle==&vehicles[0]?1:params.m_pVehicle==&vehicles[1]?2:0);
    const unsigned char *bytes=(const unsigned char *)active;
    for(unsigned i=0;i<sizeof(*active);i+=4) {uint32_t word;memcpy(&word,bytes+i,4);value(word);}
    bytes=(const unsigned char *)&copy;
    for(unsigned i=0;i<sizeof(copy);i+=4) {uint32_t word;memcpy(&word,bytes+i,4);value(word);}
    value(vehicles[0].m_bRainAudioCounter);value(vehicles[0].m_bRainSamplesCounter);
    value(vehicles[1].m_bRainAudioCounter);value(vehicles[1].m_bRainSamplesCounter);
}
struct RainValue {
    operator float() const {
        // Change the parameter's vehicle on the volume read after the generator captures its counters
        ++callbacks;++rainQueries;value(1);observe();
        if(++reads==2 && (seedValue&2048)) params.m_pVehicle=&vehicles[1];
        return rain;
    }
};
class CWeather {public:static RainValue Rain;};RainValue CWeather::Rain;
class CCullZones {public:
    static bool CamNoRain() {
        // Modify rainfall and vehicle selection after the original rain eligibility read
        ++callbacks;++cameraQueries;value(2);observe();
        if(seedValue&1024) {rain=0.25f;params.m_pVehicle=&vehicles[1];}
        return cameraNoRain;
    }
    static bool PlayerNoRain() {
        // Observe that the player check only occurs after a true camera exclusion
        ++callbacks;++playerQueries;value(3);observe();return playerNoRain;
    }
};
extern "C" uint8_t AudioRequestsHost_InRoom() {
    // Observe actual request insertion and mutate previously captured game state
    ++callbacks;++requests;value(4);observe();vehicles[0].m_bRainSamplesCounter^=(seedValue>>12)&1;
    return (seedValue>>4)&1;
}
