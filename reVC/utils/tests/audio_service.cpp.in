static void value(uint32_t v) {
    // Hash callback tokens and scalar values independently of addresses
    digest=(digest^v)*1099511628211ULL;
}
static void snapshot(void) {
    // Normalize opaque ped identities while observing complete zero-padded owner bytes
    cAudioManager copy=*active;
    for(unsigned i=0;i<NUM_AUDIOENTITIES;++i) {
        uintptr_t pointer=(uintptr_t)copy.m_asAudioEntities[i].m_pEntity;
        uintptr_t base=(uintptr_t)peds;
        if(pointer>=base && pointer<base+sizeof(peds))
            copy.m_asAudioEntities[i].m_pEntity=(void *)(uintptr_t)(((pointer-base)/sizeof(*peds))+1);
    }
    const unsigned char *bytes=(const unsigned char *)&copy;
    for(unsigned i=0;i<sizeof(copy);++i) value(bytes[i]);
    for(unsigned i=0;i<8;++i) {
        value(peds[i].m_lastSoundStart.value);value(peds[i].m_soundStart.value);value(peds[i].isPed);
    }
}
static void event(unsigned token) {
    // Observe callback-visible fields and mutate the retained live timer
    ++callbacks;value(token);snapshot();active->m_nTimer+=token;
}
static void pedWrite(uint8_t kind) {
    // Change the random input after the previous-start write to detect premature next-start evaluation
    event(kind?4:3);
    if(!kind) active->m_anRandomTable[0]=-1234;
}
extern "C" int myrand(void) {
    // Observe every unconditional RNG draw and return signed boundary inputs
    ++rngCalls;value(1);snapshot();
    const int draws[]={-3001,0,1,INT32_MIN,INT32_MAX,3001};
    return draws[rngIndex++%6];
}
extern "C" void SampleManager_StopStreamedFile(cSampleManager *manager,uint8_t slot) {
    // Observe mission reset order while changing the timer subsequently read by music
    value(manager==&SampleManager);value(slot);event(5);
}
extern "C" void SampleManager_StopChannel(cSampleManager *manager,uint32_t channel) {
    // Observe the unconditional police stop at the end of deferred game timer reset
    value(manager==&SampleManager);value(channel);event(6);
}
struct FakeMusic {
    void ResetTimers(uint32_t time) {
        // Observe the fresh timer argument and change initialization before the next service gate
        value(time);event(7);active->m_bIsInitialised=enableAfterReset;
