static uint64_t digest=1469598103934665603ULL;
static unsigned cases,callbacks,rngCalls;
static unsigned rngIndex;
static uint8_t paused,enableAfterReset;
static void snapshot(void);
static void event(unsigned token);
static void pedWrite(uint8_t kind);
struct TimerField {
