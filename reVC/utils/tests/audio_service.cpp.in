        // Observe previous pause capture and change initialization after its enclosing gate
        event(8);active->m_bIsInitialised=0;return paused!=0;
    }
};
extern "C" void AudioReflections_Update(cAudioManager *manager) {
    // Retain the controlled reflection callback while actual reflection arithmetic is tested separately
    value(manager==active);event(9);active->m_FrameCounter+=31;
}
void cAudioManager::ServiceSoundEffects(void) {
    // Retain the controlled sound service callback before final music service
    event(10);m_bIsPaused^=1;
}
@METHODS@
@HOST@
static void prepare(unsigned seed,bool global) {
    // Seed all gates, bounded entity orders, signed random inputs and retained timer fields
    active=global?&AudioManager:&other;memset(active,0,sizeof(*active));memset(peds,0,sizeof(peds));
    active->m_bIsInitialised=seed&1;active->m_bTimerJustReset=(seed>>1)&1;
    active->m_bIsPaused=(seed>>2)&1;active->m_bWasPaused=3;
    active->m_nTimer=seed%3==0?UINT32_MAX:seed*1234567U;active->m_FrameCounter=seed;
    active->m_nAudioEntitiesCount=seed%9;active->m_anRandomTable[0]=seed&1?INT32_MIN:INT32_MAX;
    enableAfterReset=(seed>>3)&1;paused=(seed>>4)&1;rngIndex=seed%6;
    for(unsigned i=0;i<8;++i) {
        peds[i].isPed=(seed+i)%3!=0;peds[i].m_lastSoundStart.value=100+i;peds[i].m_soundStart.value=200+i;
        peds[i].m_lastSoundStart.kind=0;peds[i].m_soundStart.kind=1;
        unsigned id=NUM_AUDIOENTITIES-1-i;
        active->m_aAudioEntityOrderList[i]=id;
        active->m_asAudioEntities[id].m_nType=i%3==0?AUDIOTYPE_WEATHER:AUDIOTYPE_PHYSICAL;
        active->m_asAudioEntities[id].m_bIsUsed=i&1;
        active->m_asAudioEntities[id].m_pEntity=&peds[i];
    }
    for(unsigned i=0;i<2;++i) {
        active->m_nMissionAudioSampleIndex[i]=400+i;active->m_nMissionAudioLoadingStatus[i]=LOADING_STATUS_LOADED;
        active->m_bIsMissionAudioPlaying[i]=1;active->m_bIsMissionAudioAllowedToPlay[i]=1;
    }
}
int main(void) {
    // Exercise service gates and deferred resets independently with alternating owners and public facades
    for(unsigned seed=0;seed<256;++seed) {
        uint32_t time=seed%3==0?UINT32_MAX:seed*9876543U;
        prepare(seed,false);@SERVICE@;snapshot();++cases;
        @SERVICE@;snapshot();++cases;
        prepare(seed,false);@RESET@;snapshot();++cases;
        prepare(seed,true);@FACADE@;snapshot();++cases;
    }
    printf("%u cases %u callbacks %u RNG draws : %llu\n",cases,callbacks,rngCalls,(unsigned long long)digest);
    return 0;
}
