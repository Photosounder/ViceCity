    TimerField &operator=(uint32_t time) {
        // Observe the original field write and expose the following random-table read
        value=time;pedWrite(kind);return *this;
    }
};
class CPed {
public:
    TimerField m_lastSoundStart,m_soundStart;
    bool isPed;
    bool IsPed(void) {
        // Observe the original game type test before either sound timer is written
        event(2);return isPed;
