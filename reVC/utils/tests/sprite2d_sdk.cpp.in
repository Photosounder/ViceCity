    ++setters;if(setters!=mutateAt)return;++mutations;if(mutateRect){mutateRect->left+=2.5f;mutateRect->right-=1.75f;mutateRect->top-=3;mutateRect->bottom+=4;}if(mutateColours)for(unsigned i=0;i<4;++i){mutateColours[i].r^=0x51;mutateColours[i].g^=0x37;mutateColours[i].b^=0xA5;mutateColours[i].a^=0x73;}
}
RwTexture *RwTextureRead(const char *name,const char *mask)
