    event(1);need(name!=NULL);bytes(name,strlen(name)+1);if(mask)bytes(mask,strlen(mask)+1);else event(2);++reads;if(reads==failRead)return NULL;need(reads<1024);RwTexture *texture=&textures[reads];rasters[reads].id=2000+reads;*texture={1000+reads,true,&rasters[reads],0};return texture;
}
