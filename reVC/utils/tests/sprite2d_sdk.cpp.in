    const uint8_t *p=(const uint8_t*)data;for(size_t i=0;i<count;++i){hashValue^=p[i];hashValue*=UINT64_C(1099511628211);}
}
static void event(uint32_t op,uint32_t a=0,uint32_t b=0)
{
