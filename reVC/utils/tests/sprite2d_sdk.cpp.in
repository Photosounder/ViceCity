    uint32_t values[]={op,a,b};bytes(values,sizeof(values));++events;
}
static uint32_t identity(const void *object)
{
    // Normalize nullable controlled SDK resource identities
    return object?*(const uint32_t*)object:0;
}
static void setter(void)
{
