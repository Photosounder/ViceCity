    }
}
int main()
{
    // Compare complete quaternion ownership and its actual animation consumers
    lifetimes();numericOperations();conversions();animation();printf("states=%u checks=%u hash=%016" PRIx64 "\n",states,checks,hashValue);return 0;
}
