                for(unsigned k=0;k<3;++k){rotations[channel][k]=frames[channel][k];packedRotations[channel][k]=packed[channel][k];}sequences[channel].keyFrames=rotations[channel];sequences[channel].keyFramesCompressed=packedRotations[channel];
            }
            sequences[channel].RemoveQuaternionFlips();associations[channel].blendAmount=(test&32)?0.7f:0.25f;associations[channel].timeStep=(test&64)?0.6f:0.05f;associations[channel].flags=((test>>5)+channel)&31;
            nodes[channel][0].Init();nodes[channel][0].sequence=&sequences[channel];nodes[channel][0].association=&associations[channel];nodes[channel][0].frameA=1;nodes[channel][0].frameB=0;nodes[channel][0].remainingTime=0.2f;nodes[channel][0].CalcDeltas();nodes[channel][1].Init();
            // Exercise compressed sign correction and actual scalar interpolation before frame accumulation
            CVector translation;CQuaternion rotation;nodes[channel][0].CalcDeltasCompressed();nodes[channel][0].UpdateCompressed(translation,rotation,0.75f);result(rotation);vectorResult(translation);nodes[channel][0].remainingTime=0.2f;nodes[channel][0].frameA=1;nodes[channel][0].frameB=0;nodes[channel][0].CalcDeltas();
        }
