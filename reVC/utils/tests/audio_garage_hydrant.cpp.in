    if(token==6&&(seedValue&32))particles[arg].position.x=2;
    if(token==7&&(seedValue&64))active->m_sQueueSample.m_vecPos.x=2;
    if(token==8&&(seedValue&128))active->m_sQueueSample.m_nSampleIndex=SFX_CAR_ON_FIRE;
