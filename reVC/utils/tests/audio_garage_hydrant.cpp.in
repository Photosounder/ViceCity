}
@METHODS@
static void prepare(unsigned seed) {
    // Initialize both owners and all valid garage, door and particle records with zero padding
    seedValue=seed;mutations=1;entityId=seed%NUM_AUDIOENTITIES;otherId=(entityId+1)%NUM_AUDIOENTITIES;current=0;memset(owners,0,sizeof(owners));memset(CGarages::aGarages,0,sizeof(CGarages::aGarages));memset(doors,0,sizeof(doors));memset(particles,0,sizeof(particles));active=&owners[seed&1];camera={0,0,0};
    active->m_nActiveSamples=6;active->m_nActiveQueue=(seed>>1)&1;active->m_nRequestedCount[active->m_nActiveQueue]=seed%7;
    for(unsigned i=0;i<6;++i){active->m_aRequestedOrderList[active->m_nActiveQueue][i]=i;active->m_aRequestedQueue[active->m_nActiveQueue][i].m_nFinalPriority=100+i*900;}
    active->m_sQueueSample.m_nEntityIndex=entityId;active->m_sQueueSample.m_nFrequency=999;active->m_sQueueSample.m_fDistance=-1;active->m_sQueueSample.m_nCounter=777;active->m_FrameCounter=seed&1;
    static const int32_t randoms[]={0,1,-1,INT32_MIN,INT32_MAX,173};for(unsigned i=0;i<5;++i)active->m_anRandomTable[i]=randoms[(seed/8+i)%6];
    // Enable real reflections only where original old-frequency initialization is defined
