static void value(uint32_t v) {
    // Observe original arguments and exact callback ordering
    digest=(digest^v)*1099511628211ULL;
}
static void observe() {
    // Hash all initialized records with stable identities for door and particle pointers
    static cAudioManager copies[2];static CGarage garageCopies[NUM_GARAGES];memcpy(copies,owners,sizeof(copies));memcpy(garageCopies,CGarages::aGarages,sizeof(garageCopies));
    for(unsigned i=0;i<2;++i)for(unsigned j=0;j<2;++j){void *p=copies[i].m_asAudioEntities[j?otherId:entityId].m_pEntity;copies[i].m_asAudioEntities[j?otherId:entityId].m_pEntity=(void *)(uintptr_t)(p==&particles[0]?1:p==&particles[1]?2:0);}
    for(unsigned i=0;i<NUM_GARAGES;++i){CEntity *p=garageCopies[i].m_pDoor1.v;garageCopies[i].m_pDoor1.v=(CEntity *)(uintptr_t)(p?(p-doors)+1:0);}
    digest=TestAircraftHash(digest,copies,sizeof(copies));digest=TestAircraftHash(digest,garageCopies,sizeof(garageCopies));digest=TestAircraftHash(digest,doors,sizeof(doors));digest=TestAircraftHash(digest,particles,sizeof(particles));digest=TestAircraftHash(digest,&CGarages::NumGarages,sizeof(CGarages::NumGarages));digest=TestAircraftHash(digest,&camera,sizeof(camera));
