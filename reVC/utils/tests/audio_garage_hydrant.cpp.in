static void event(unsigned token,unsigned arg) {
    // Observe state before callbacks change later type, state, pointer or cached-distance reads
    ++callbacks;value(token);value(arg);observe();
    if(token==2){current=arg;++garageVisits[arg];}
    if(!mutations)return;
    if(token==1&&(seedValue&1))CGarages::NumGarages.v=NUM_GARAGES;
    if(token==2&&(seedValue&2))CGarages::aGarages[arg].m_eGarageState.v=GS_AFTERDROPOFF;
    if(token==3&&(seedValue&4))CGarages::aGarages[arg].m_eGarageType.v=GARAGE_CRUSHER;
