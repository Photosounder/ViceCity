    active->m_bDynamicAcousticModelingStatus=(seed>>2)&1;for(unsigned i=0;i<5;++i)active->m_afReflectionsDistances[i]=12+i*8;
#endif
    // Cover every garage slot, crusher states, null doors and strict position boundaries
    static const uint32_t counts[]={0,1,7,NUM_GARAGES-1,NUM_GARAGES};CGarages::NumGarages.v=counts[seed%5];
    static const uint8_t types[]={GARAGE_NONE,GARAGE_MISSION,GARAGE_CRUSHER,255};static const uint8_t states[]={GS_FULLYCLOSED,GS_OPENING,GS_CLOSING,GS_AFTERDROPOFF,GS_OPENED,255};static const float positions[]={0,6.999f,7,7.001f,15.999f,16,16.001f,34.999f,35,35.001f,79.999f,80,80.001f,NAN,INFINITY};
    for(unsigned i=0;i<NUM_GARAGES;++i){CGarage *g=&CGarages::aGarages[i];g->m_eGarageType.token=2;g->m_eGarageType.index=i;g->m_eGarageType.v=types[(seed/4+i)%4];g->m_eGarageState.token=3;g->m_eGarageState.index=i;g->m_eGarageState.v=states[(seed/16+i)%6];g->m_pDoor1.index=i;g->m_pDoor1.v=(seed+i)%7==0?NULL:&doors[i];doors[i].index=i;doors[i].position.x=positions[(seed/5+i)%15];doors[i].position.z=(float)((seed/75)%3)*50;}
    // Seed defined live event counts and separate particle-object pointers for both entity choices
    static const int16_t events[]={SOUND_GARAGE_DOOR_OPENED,SOUND_GARAGE_DOOR_CLOSED,SOUND_NO_SOUND,-1};
    for(unsigned i=0;i<2;++i){particles[i].index=i;particles[i].position.x=positions[(seed+i)%15];active->m_asAudioEntities[i?otherId:entityId].m_pEntity=&particles[i];active->m_asAudioEntities[i?otherId:entityId].m_AudioEvents=(seed+i)%5;for(unsigned j=0;j<NUM_AUDIOENTITY_EVENTS;++j)active->m_asAudioEntities[i?otherId:entityId].m_awAudioEvent[j]=events[(seed+i+j)%4];}
}
int main() {
    // Keep failures console-only on Windows
#ifdef _WIN32
    SetErrorMode(3);
#endif
    // Exercise repeated live changes and a fresh pass retaining original seeded boundaries
    for(unsigned seed=0;seed<1024;++seed){prepare(seed);@RUN@;observe();++cases;@RUN@;observe();++cases;prepare(seed);mutations=0;@RUN@;observe();++cases;}
    // Require shared one-shot wrapping through every counter and every garage index
    assert(submits);for(unsigned i=32;i<256;++i)assert(counters[i]);for(unsigned i=0;i<NUM_GARAGES;++i)assert(garageVisits[i]);
#ifndef GTA_PS2
    assert(loops);
#endif
    printf("%u %u %u %u %llu\n",cases,callbacks,submits,loops,(unsigned long long)digest);return 0;
