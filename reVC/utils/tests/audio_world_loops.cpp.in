    for(unsigned seed=0;seed<1024;++seed){prepare(seed);@RUN@;observe();++cases;@RUN@;observe();++cases;prepare(seed);mutations=0;@RUN@;observe();++cases;}
    // Require every projectile counter and escalator index along with real loop submissions
    assert(submits);for(unsigned i=0;i<NUM_PROJECTILES;++i)assert(projectileCounters[i]);for(unsigned i=0;i<NUM_ESCALATORS;++i)assert(escalatorVisits[i]);
