        reset(state+alpha+3);CObject *object=create(zero);require(object!=NULL);TestSea_Allocate(0,object,.04f,-.005f,3.0f,(uint32_t)alpha,state);recordOps++;TestSea_SetCount(state==WATER_CREATURE_DISABLED?0:1);Timer_timeMs=times[(state+(unsigned)(alpha+1))%5];object->m_nEndOfLifeTime=0;object->matrix.rx=0;object->matrix.ry=0;object->matrix.rz=0;waterDepth=state%2?3.f:3.0001f;update();update();remove();
    }
