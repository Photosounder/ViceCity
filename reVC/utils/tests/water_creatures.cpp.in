    reset();object=create(zero);TestSea_Allocate(0,object,.04f,0,3,255,WATER_CREATURE_REMOVE);recordOps++;TestSea_SetCount(1);hook=8;triggered=false;update();require(triggered && TestSea_Count()==2);hook=0;
    reset();one(point,26);for(unsigned frame=0;frame<80;frame++){Timer_timeMs+=100;waterDepth=frame<10?12.f:2.f;update();if(TestSea_Count()==0)break;}remove();clean();for(int p=0;p<2;p++)CPool_Flush(&pools[p]);
