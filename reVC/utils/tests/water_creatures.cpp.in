    for(int model: {-2,-1,65,2147483647}){reset(4);forced=32767;one(point,model);remove();}
    reset();visible=true;one(point,0);require(TestSea_Count()==0);visible=false;depthResult=false;one(point,0);waterDepth=4.5f;depthResult=true;one(point,0);require(TestSea_Count()==0);waterDepth=4.5001f;one(point,0);require(TestSea_Count()==1);remove();
