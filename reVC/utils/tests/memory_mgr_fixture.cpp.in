static void *allocate(size_t size,bool heap,const char *func)
{
    // Check that actual CITAlloc macros keep the public owner's function metadata
    if(!heap)require(strcmp(func,"MemoryMgrMalloc")==0);event(heap?11:1,NULL,size,0);void *pointer=reserve(size,0xa5);reenter();finish(pointer,size,0);return pointer;
}
static void *resize(void *pointer,size_t size,bool heap,const char *func)
