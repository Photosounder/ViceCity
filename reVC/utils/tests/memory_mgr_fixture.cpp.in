    if(!pointer)return;for(unsigned i=0;i<32;++i)if(blocks[i].pointer==pointer){memset(pointer,0xdd,blocks[i].size);blocks[i].pointer=NULL;++frees;return;}require(false);
}
static void reenter(void)
{
    // Raise the owner's high-water mark inside selected allocator calls before the outer call returns
    if(!triggerReentry)return;triggerReentry=false;++reentries;void *nested=TestMemory(1,NULL,0,4096,0);require(nested!=NULL);TestMemory(4,nested,0,0,0);
}
static void finish(void *pointer,size_t size,size_t count)
{
    // Retain the live state immediately before returning to the original or C memory algorithm
    lastPointer=pointer;lastRequest=size;lastCount=count;lastTopAtReturn=pMemoryTop;
