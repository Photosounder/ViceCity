    // Compare the original live high-water formula after any reentrant allocator update
    uint8_t *expected=(uint8_t*)pointer+size;if(expected<lastTopAtReturn)expected=lastTopAtReturn;require(pMemoryTop==expected);uint32_t offset=relative(pMemoryTop);hashBytes(&offset,4);
}
int main(void)
{
