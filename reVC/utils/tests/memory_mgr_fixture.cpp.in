static void require(bool value)
{
    // Fail quietly at the exact allocator or owner contract violation
    ++checks;if(!value){fprintf(stderr,"check=%u\n",checks);abort();}
}
static void hashBytes(const void *value,size_t count)
{
    // Observe initialized values without including process-specific pointer addresses
    const uint8_t *bytes=(const uint8_t*)value;for(size_t i=0;i<count;++i){hashValue^=bytes[i];hashValue*=UINT64_C(1099511628211);}
}
static uint32_t relative(const void *pointer)
