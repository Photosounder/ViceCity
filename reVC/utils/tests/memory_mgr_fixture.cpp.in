    // Preserve existing bytes and callback-visible state across real reallocation requests
    if(!heap)require(strcmp(func,"MemoryMgrRealloc")==0);event(heap?12:2,pointer,size,0);++reallocCalls;size_t oldSize=0;for(unsigned i=0;i<32;++i)if(blocks[i].pointer==pointer)oldSize=blocks[i].size;require(oldSize>0);void *replacement=reserve(size,0xa5);memcpy(replacement,pointer,oldSize<size?oldSize:size);release(pointer);reenter();finish(replacement,size,0);return replacement;
}
extern "C" void *cita_win_malloc(size_t size,const char *filename,const char *func,int line)
{
    // Supply only the actual external normal allocator boundary through its genuine C declaration
    require(filename&&line>0);return allocate(size,false,func);
}
extern "C" void *cita_win_realloc(void *pointer,size_t size,const char *filename,const char *func,int line)
{
    // Preserve the exact normal allocator arguments and public owner metadata
    require(filename&&line>0);return resize(pointer,size,false,func);
}
extern "C" void *cita_win_calloc(size_t count,size_t size,const char *filename,const char *func,int line)
{
    // Keep the external calloc's zeroed bytes independent of the owner's optional second clearing pass
    require(filename&&line>0&&strcmp(func,"MemoryMgrCalloc")==0);event(3,NULL,size,count);++callocCalls;void *pointer=reserve(count*size,0);reenter();finish(pointer,size,count);return pointer;
}
extern "C" void cita_win_free(void *pointer,const char *filename,const char *func,int line)
{
    // Observe the original normal free even when its argument is null
    require(filename&&line>0&&strcmp(func,"MemoryMgrFree")==0);event(4,pointer,0,0);release(pointer);
}
void MemoryHeap::Init(uint32_t size)
{
    // Verify the actual original custom-heap size without replacing any owner initialization policy
    require(size==128*1024*1024);event(10,NULL,size,0);++initCalls;
}
void *MemoryHeap::Malloc(uint32_t size)
{
    // Borrow the same custom allocator boundary for ordinary and count-multiplied requests
    return allocate(size,true,NULL);
}
void *MemoryHeap::Realloc(void *pointer,uint32_t size)
{
    // Preserve the original custom request narrowing at the native heap method signature
    return resize(pointer,size,true,NULL);
}
void MemoryHeap::Free(void *pointer)
{
    // Observe custom null-free policy at its actual external boundary
    event(14,pointer,0,0);release(pointer);
}
extern "C" void re3_assert(const char*,const char*,unsigned int,const char*)
{
    // Treat unexpected owner assertions as failures without native error windows
    require(false);
}
static void expectedTop(void *pointer,size_t size)
