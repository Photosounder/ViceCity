    for(unsigned test=0;test<2048;++test){
        // Alternate independent public callers and the actual SDK callback table
        cursor=64+(test%32)*16;size_t size=1+test%257;triggerReentry=(test%32)==0;void *pointer;if(test&1){pointer=memFuncs.rwmalloc(size);++tableCalls;}else pointer=TestMemory(1,NULL,0,size,0);require(pointer==lastPointer&&lastRequest==size);expectedTop(pointer,size);for(size_t i=0;i<size;++i)((uint8_t*)pointer)[i]=(uint8_t)(test+i);
        // Reallocate while preserving payload contents and reentrant high-water observations
        size_t nextSize=size+1+test%31;triggerReentry=(test%64)==1;if(test&1){pointer=memFuncs.rwrealloc(pointer,nextSize);++tableCalls;}else pointer=TestMemory(2,pointer,0,nextSize,0);require(pointer==lastPointer&&lastRequest==nextSize);expectedTop(pointer,nextSize);for(size_t i=0;i<size;++i)require(((uint8_t*)pointer)[i]==(uint8_t)(test+i));hashBytes(pointer,nextSize);uint8_t *peak=pMemoryTop;if(test&1){memFuncs.rwfree(pointer);++tableCalls;}else TestMemory(4,pointer,0,0,0);require(pMemoryTop==peak);
        // Preserve the original single-element high-water update for count-multiplied allocation
        size_t count=1+test%5,element=1+test%53;if(test&1){pointer=memFuncs.rwcalloc(count,element);++tableCalls;}else pointer=TestMemory(3,NULL,count,element,0);expectedTop(pointer,element);
#if defined(USE_CUSTOM_ALLOCATOR) && !defined(FIX_BUGS)
        const uint8_t expectedByte=0xa5;
#else
        const uint8_t expectedByte=0;
#endif
        for(size_t i=0;i<count*element;++i)require(((uint8_t*)pointer)[i]==expectedByte);hashBytes(pointer,count*element);TestMemory(4,pointer,0,0,0);
        // Exercise the original pointer-width alignment formulas and the hidden original-allocation header
        uint32_t alignment=1u<<(3+test%8);size_t payload=test%129;void *aligned=TestMemory(5,NULL,0,payload,alignment);require(((uintptr_t)aligned&(alignment-1))==0&&*(((void**)aligned)-1)==lastPointer);
#if defined(FIX_BUGS) || defined(FIX_BUGS_64)
