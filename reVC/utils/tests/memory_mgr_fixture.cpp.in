    if(!pointer)return UINT32_MAX;require((const uint8_t*)pointer>=arena&&(const uint8_t*)pointer<arena+arenaSize);return (uint32_t)((const uint8_t*)pointer-arena);
}
static void event(uint32_t operation,const void *pointer,size_t size,size_t count)
{
    // Record call ordering and the live high-water value at each actual allocator boundary
    uint32_t values[]={operation,relative(pointer),(uint32_t)size,(uint32_t)count,relative(pMemoryTop)};hashBytes(values,sizeof(values));
}
static void *reserve(size_t size,uint8_t pattern)
{
    // Return valid aligned raw storage while tracking exact byte requests and live allocations
    require(size>0&&size<65536);cursor=(cursor+15)&~(size_t)15;require(cursor+size<arenaSize);void *pointer=arena+cursor;cursor+=size+16;memset(pointer,pattern,size);
    for(unsigned i=0;i<32;++i)if(!blocks[i].pointer){blocks[i]={pointer,size};++allocations;return pointer;}require(false);return NULL;
}
static void release(void *pointer)
