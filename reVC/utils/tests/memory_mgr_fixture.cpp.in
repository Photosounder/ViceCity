        require(lastRequest==requested);expectedTop(lastPointer,requested);require((uint8_t*)aligned>=(uint8_t*)lastPointer+sizeof(void*)&&(uint8_t*)aligned+payload<=(uint8_t*)lastPointer+requested);memset(aligned,(int)(test%251),payload);hashBytes(aligned,payload);TestMemory(6,aligned,0,0,0);TestMemory(4,NULL,0,0,0);require(allocations==frees);
    }
