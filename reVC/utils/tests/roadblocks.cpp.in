static void Reset(unsigned seed,int objects=24)
{
    // Recreate real C pools and seed every canonical field before each independent full-policy case
    armed=false;CPool_Flush(&pedPool);CPool_Flush(&vehiclePool);CPool_Flush(&objectPool);Check(CPool_Init(&pedPool,8,sizeof(CCopPed),"cop"));Check(CPool_Init(&vehiclePool,8,sizeof(CAutomobile),"car"));Check(CPool_Init(&objectPool,objects,sizeof(CObject),"object"));
    nextIdentity=100;now=seed&1?UINT32_MAX-5000:12345;frame=seed;randomState=seed*17+1;mode=0;activePlayer=0;hasVehicle=hasPlayer=true;triggered=false;collisionMode=groundMode=collisionCalls=groundCalls=refs=0;roadUpZ=1;sirenEnabled=true;
    for(int i=0;i<NUM_DEFAULT_MODELS;i++){models[i].col.boundingSphere.radius=2.0f+(i%3)*0.25f;models[i].col.boundingBox.min=CVector(-1,-1,-0.75f);loaded[i]=true;}
    for(int i=0;i<2;i++){wanted[i].m_RoadblockDensity=127;wanted[i].army=wanted[i].fbi=wanted[i].swat=false;players[i].m_pWanted=&wanted[i];players[i].identity=10+i;players[i].matrix.SetTranslate(i?8.0f:0.0f,i?-3.0f:0.0f,i?5.0f:0.0f);}
    playerCar.identity=20;otherCar.identity=21;playerCar.model=MI_POLICE;playerCar.radius=3;playerCar.matrix.SetTranslate(3,7,2);playerCar.matrix.RotateZ(0.4f);
    GLOBAL(NumRoadBlocks)=0;for(int i=0;i<NUMROADBLOCKS;i++){GLOBAL(RoadBlockNodes)[i]=(int16_t)(i+seed);GLOBAL(InOrOut)[i]=(i+seed)&1;}
    for(int i=0;i<NUM_SCRIPT_ROADBLOCKS;i++){CScriptRoadblock &b=GLOBAL(aScriptRoadBlocks)[i];b.m_vInf.x=(float)(seed+i);b.m_vInf.y=-4;b.m_vInf.z=2;b.m_vSup.x=-3;b.m_vSup.y=4;b.m_vSup.z=-2;b.m_bInUse=true;}
    memset(&ThePaths,0,sizeof(ThePaths));
#ifdef SECUROM
    roadBlocksPirateCheck=(uint8_t)(seed%3);
#endif
}
static unsigned Occupied(CPool *pool)
{
    // Count actual occupied pool slots independently of producer counters
    unsigned n=0;for(int i=0;i<CPool_GetSize(pool);i++)if(CPool_GetSlot(pool,i))++n;return n;
}
int main()
{
    // Prove the mock native hierarchy exercises real base-pointer adjustment
    Check((void*)&playerCar!=(void*)(CEntity*)&playerCar);Check((void*)&players[0]!=(void*)(CEntity*)&players[0]);
    // Exercise empty, full, filtered and overflowing path discovery including the early-return script state
    int counts[]={0,1,299,300,301,312};for(unsigned k=0;k<6;k++){Reset(k);ThePaths.m_numCarPathNodes=counts[k];for(int i=0;i<counts[k];i++){ThePaths.m_pathNodes[i].bUseInRoadBlock=true;ThePaths.m_pathNodes[i].numLinks=2;}Run_RoadBlocks_Init();Check(GLOBAL(NumRoadBlocks)==(counts[k]<NUMROADBLOCKS?counts[k]:NUMROADBLOCKS));Check(GLOBAL(aScriptRoadBlocks)[0].m_bInUse==(counts[k]>NUMROADBLOCKS));Snapshot();}
    Reset(17);ThePaths.m_numCarPathNodes=312;for(int i=0;i<312;i++){ThePaths.m_pathNodes[i].bUseInRoadBlock=i%3;ThePaths.m_pathNodes[i].numLinks=(uint8_t)(i%4);}Run_RoadBlocks_Init();Snapshot();
    // Exercise complete registry saturation and midpoint arithmetic through independent C callers
    Reset(19);Run_RoadBlocks_ClearScriptRoadBlocks();for(int i=0;i<20;i++){RBTestVector a={(float)i,-0.0f,(float)i*0.3f},b={-(float)i,8,3};Run_RoadBlocks_RegisterScriptRoadBlock(a,b);RBTestVector mid=Run_RoadBlocks_Midpoint(a,b);Floating(mid.x);Floating(mid.y);Floating(mid.z);Check(mid.x==0);Snapshot();}Check(GLOBAL(aScriptRoadBlocks)[15].m_vInf.x==15);Run_RoadBlocks_ClearScriptRoadBlocks();Snapshot();
    // Exercise all six cop offsets, special-unit fallbacks, captured targets and live native callbacks
    int copModels[]={MI_POLICE,MI_FBIRANCH,MI_ENFORCER,MI_BARRACKS};for(unsigned seed=0;seed<216;seed++){Reset(seed);playerCar.model=copModels[seed%4];playerCar.radius=1.0f+(seed%7)*0.375f;for(int model=0;model<NUM_DEFAULT_MODELS;model++)loaded[model]=(seed/4)%2;hasVehicle=seed%3==0;hasPlayer=seed%3!=2;mode=seed%9;armed=true;Run_RoadBlocks_GenerateRoadBlockCopsForCar(&playerCar,(seed/4)%3);armed=false;Check(Occupied(&pedPool)==2&&refs==4);Snapshot();}
    // Exercise full vehicle and barrier placement across geometry, wanted priority, streaming and collision boundaries
    for(unsigned seed=0;seed<576;seed++){Reset(seed);wanted[0].army=seed&1;wanted[0].fbi=seed&2;wanted[0].swat=seed&4;wanted[1].army=seed&8;loaded[MI_BARRACKS]=seed&16;loaded[MI_FBICAR]=seed&32;loaded[MI_ENFORCER]=seed&64;loaded[MI_ROADWORKBARRIER1]=seed%5!=0;collisionMode=(seed/3)%3;groundMode=(seed/9)%3;sirenEnabled=seed&1;float thresholds[]={0.939f,0.94f,0.940001f,1.0f};roadUpZ=thresholds[seed%4];mode=seed%9;armed=true;
        float lengths[]={0,0.1f,3.99f,4.0f,4.01f,8.0f,12.0f,27.0f,60.0f};float length=lengths[seed%9];RBTestVector a={-length*0.5f,-1.25f,(float)(seed%3)},b={length*0.5f,(seed%2)?-1.25f:2.75f,(float)(seed%3)};Run_RoadBlocks_CreateRoadBlockBetween2Points(a,b);armed=false;Check(Occupied(&vehiclePool)<=6&&Occupied(&objectPool)<=16);Snapshot();}
#ifdef FIX_BUGS
    // Exercise exhausted object pools with no temporary entries and deterministic first-temporary handle reuse
    for(unsigned seed=0;seed<24;seed++){Reset(seed,4);for(int i=0;i<4;i++){CObject *object=(CObject*)CPool_New(&objectPool);std::allocator<CObject>().construct(object,MI_ROADWORKBARRIER1,true);object->ObjectCreatedBy=(seed%3==0||i<(int)(seed%4))?1:TEMP_OBJECT;}RBTestVector a={-8,0,0},b={8,0,0};Run_RoadBlocks_CreateRoadBlockBetween2Points(a,b);Check(Occupied(&objectPool)==4);Snapshot();}
#endif
    // Exercise all frame batches, strict spatial boundaries, script one-shot behavior and squeeze gates
    for(unsigned seed=0;seed<384;seed++){Reset(seed);GLOBAL(NumRoadBlocks)=NUMROADBLOCKS;ThePaths.m_numCarPathNodes=NUMROADBLOCKS;for(int i=0;i<NUMROADBLOCKS;i++){GLOBAL(RoadBlockNodes)[i]=(int16_t)i;GLOBAL(InOrOut)[i]=true;ThePaths.m_pathNodes[i].x=16000;ThePaths.m_pathNodes[i].numLinks=2;ThePaths.m_pathNodes[i].firstLink=(int16_t)(2*i);ThePaths.m_carPathConnections[2*i]=2*i;ThePaths.m_carPathConnections[2*i+1]=2*i+1;ThePaths.m_carPathLinks[2*i].x=-40;ThePaths.m_carPathLinks[2*i+1].x=40;ThePaths.m_carPathLinks[2*i].numLeftLanes=ThePaths.m_carPathLinks[2*i+1].numRightLanes=1;for(int k=0;k<2;k++)ThePaths.m_carPathLinks[2*i+k].numRightLanes=ThePaths.m_carPathLinks[2*i+k].numLeftLanes=1;}
        int index=NUMROADBLOCKS*(frame&15)/16;float distance[]={89.875f,90,90.125f,0};ThePaths.m_pathNodes[index].x=(int16_t)(distance[(seed/4)%4]*8);ThePaths.m_pathNodes[index].z=24000;ThePaths.m_pathNodes[index].width=(seed/16)&1?(uint8_t)(16+seed%240):0;ThePaths.m_carPathLinks[2*index].numLeftLanes=(int8_t)((seed/32)%7-3);ThePaths.m_carPathLinks[2*index+1].numRightLanes=(int8_t)((seed/48)%7-3);GLOBAL(InOrOut)[index]=false;wanted[0].m_RoadblockDensity=seed%5?127:0;hasVehicle=seed&1;collisionMode=1;groundMode=1;mode=seed%9;
        for(int i=0;i<16;i++){CScriptRoadblock &block=GLOBAL(aScriptRoadBlocks)[i];block.m_vInf.x=200;block.m_vSup.x=204;block.m_vInf.y=block.m_vSup.y=block.m_vInf.z=block.m_vSup.z=0;block.m_bInUse=true;}
        CScriptRoadblock &block=GLOBAL(aScriptRoadBlocks)[frame&15];float d[]={99.875f,100,100.125f,0};block.m_vInf.x=d[(seed/4)%4]-2;block.m_vSup.x=d[(seed/4)%4]+2;armed=true;Run_RoadBlocks_GenerateRoadBlocks();armed=false;Snapshot();Run_RoadBlocks_GenerateRoadBlocks();Snapshot();}
    // Release plain pool storage after the final canonical observation
    CPool_Flush(&pedPool);CPool_Flush(&vehiclePool);CPool_Flush(&objectPool);printf("states=%llu checks=%llu observations=%llu hash=%016llx\n",(unsigned long long)states,(unsigned long long)checks,(unsigned long long)observations,(unsigned long long)digest);return 0;
}
