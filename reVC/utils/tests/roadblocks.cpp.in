        else {CObject *object=(CObject*)CPool_GetSlot(pool,i);entity=object;Number(object->ObjectCreatedBy);Number(object->m_nEndOfLifeTime);}
        Number(Identity(entity));Number(entity->model);Number(entity->status);Matrix(entity->matrix);
    }}
    Number(now);Number(frame);Number(randomState);Number(activePlayer);Number(triggered);Number(refs);Number(collisionCalls);Number(groundCalls);for(int i=0;i<2;i++){Number(wanted[i].m_RoadblockDensity);Number(wanted[i].army);Number(wanted[i].fbi);Number(wanted[i].swat);}Number(loaded[MI_ROADWORKBARRIER1]);Floating(models[MI_ROADWORKBARRIER1].col.boundingSphere.radius);
