        if(k==0){CCopPed *cop=(CCopPed*)CPool_GetSlot(pool,i);entity=cop;Number(cop->type);Number(cop->weapon);Number(cop->m_bIsDisabledCop);Number(cop->bKindaStayInSamePlace);Number(cop->bNotAllowedToDuck);Number(cop->bCrouchWhenShooting);Number(cop->bCullExtraFarAway);Number(cop->m_nExtendedRangeTimer);Number(Identity(cop->m_nRoadblockVeh));Number(Identity(cop->m_pMyVehicle));Number(Identity(cop->target));}
