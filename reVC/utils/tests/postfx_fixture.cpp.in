int main(void)
{
    // Verify classic lighting forwarding even when the complete extended owner is intentionally inactive
    TestPostArgs args={&camera,137,257,511,173,0,0};
#ifndef EXTENDED_COLOURFILTER
    MBlur_BlurOn=false;require(run(OP_BindLighting,&args)==0);MBlur_BlurOn=true;require(run(OP_BindLighting,&args)==1);
#else
    // Observe original static initialization and both uniform registration boundaries
    TestPostState initial=state();require(initial.front==NULL&&initial.back==NULL&&!initial.initialised&&!initial.blur&&!initial.motion&&initial.effect==2&&initial.intensity==1.0f&&initial.next==0&&initial.count==0);run(OP_Init,&args);run(OP_Init,&args);
    // Verify the complete smoothing ring wraps and divides with original integer semantics
    for(unsigned i=0;i<40;++i){args.red=i;args.green=2*i;args.blue=3*i;args.alpha=4*i;run(OP_Smooth,&args);}TestPostState current=state();require(current.count==20&&current.next==0&&current.average[0]==29&&current.average[1]==59&&current.average[2]==88&&current.average[3]==118);memset(current.previous,0,sizeof(current.previous));memset(current.average,0,sizeof(current.average));current.next=current.count=0;TestPostSetState(&current);args.red=UINT32_MAX;args.green=1;args.blue=2;args.alpha=3;run(OP_Smooth,&args);require(state().average[0]==-1);current=state();memset(current.previous,0,sizeof(current.previous));current.next=current.count=0;TestPostSetState(&current);
    for(unsigned cycle=0;cycle<12;++cycle){
        // Exercise complete open, repeated open, direct draws and both depth-dependent vertex layouts
        cameraRaster.width=cycle&1?800:640;cameraRaster.height=cycle&1?600:448;cameraRaster.depth=cycle&2?16:32;camera.nearClip=cycle&1?0.25f:0.5f;run(OP_Open,&args);run(OP_Open,&args);current=state();require(current.front&&current.back&&current.initialised);args.red=137+cycle;args.green=257+cycle;args.blue=511-cycle;args.alpha=173;args.blur=0;run(OP_Motion,&args);args.blur=289;run(OP_Motion,&args);run(OP_GetBack,&args);
        for(int effect=-1;effect<=4;++effect)for(int flags=0;flags<8;++flags){
            // Vary each live buffer-selection and filter predicate independently of rendering implementation
            current=state();current.effect=effect;current.blur=(flags&1)!=0;current.motion=(flags&2)!=0;current.initialised=(flags&4)!=0;current.intensity=cycle%3==0?0.0f:cycle%3==1?0.75f:2.25f;TestPostSetState(&current);MBlur_Drunkness=cycle&1?0.375f:0.0f;args.type=flags%3==0?MOTION_BLUR_SNIPER:flags%3==1?MOTION_BLUR_LIGHT_SCENE:MOTION_BLUR_NONE;require(run(OP_UseBlur,&args)==(effect!=1));require(run(OP_BindLighting,&args)==(effect!=1));run(OP_NeedBack,&args);run(OP_NeedFront,&args);run(OP_Blur,&args);run(OP_Sniper,&args);run(OP_Shader,&args);run(OP_Render,&args);run(OP_BindRender,&args);
        }
        // Exercise live C forwarding and every original lifetime exit operation
        run(OP_BindClose,&args);run(OP_BindOpen,&args);run(OP_BindClose,&args);run(OP_Close,&args);require(state().front==NULL&&state().back==NULL);
    }
    // Observe partial allocation behavior without inventing recovery or hiding originally retained resources
    failRasterCall=rasterCalls+1;run(OP_Open,&args);current=state();require(current.front==NULL&&current.back!=NULL);failRasterCall=0;run(OP_Open,&args);run(OP_Close,&args);cleanupRetained();failRasterCall=rasterCalls+2;run(OP_Open,&args);current=state();require(current.front!=NULL&&current.back==NULL);failRasterCall=0;run(OP_Close,&args);cleanupRetained();
    // Observe shader factory failure in a defined open/close sequence without using a null shader
    failShaderCall=shaderCalls+1;run(OP_Open,&args);failShaderCall=0;run(OP_Close,&args);cleanupRetained();
    // Reenter the complete shader operation while the outer stack coefficients remain borrowed
    run(OP_Open,&args);current=state();current.effect=3;TestPostSetState(&current);nestedArgs=args;nestedArgs.red=11;nestedArgs.green=29;nestedArgs.blue=53;
#if defined(RW_D3D9)||defined(RW_OPENGL)
    reenterUpload=true;run(OP_Shader,&args);require(reentries==1&&!reenterUpload);
#endif
    run(OP_Close,&args);cleanupRetained();require(state().front==NULL&&state().back==NULL);
#endif
    require(rastersCreated==rastersDestroyed&&shadersCreated==shadersDestroyed);printf("commands=%u checks=%u events=%u rasters=%u/%u shaders=%u/%u failures=%u/%u draws=%u constants=%u uniforms=%u registrations=%u reentries=%u assertions=%u hash=%016llx\n",commands,checks,events,rastersCreated,rastersDestroyed,shadersCreated,shadersDestroyed,rasterFailures,shaderFailures,draws,constants,uniforms,registrations,reentries,assertions,(unsigned long long)hashValue);return 0;
