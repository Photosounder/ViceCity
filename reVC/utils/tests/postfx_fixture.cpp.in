    bool colour=(shaderCalls%2)==0;const void *reference=colour?(void*)colourfilterVC_PS_cso:(void*)contrastPS_cso;size_t size=colour?sizeof(colourfilterVC_PS_cso):sizeof(contrastPS_cso);require(memcmp(bytes,reference,size)==0);event(18,(uint32)size,colour);hashBytes(bytes,size);return makeShader(colour?1:2);
