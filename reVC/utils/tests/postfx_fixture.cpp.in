        float saved[4];memcpy(saved,values,components*sizeof(float));outerValues=values;reenterUpload=false;insideUpload=true;++reentries;run(OP_Shader,&nestedArgs);require(memcmp(saved,values,components*sizeof(float))==0);insideUpload=false;outerValues=NULL;
    }
}
