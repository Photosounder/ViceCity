@METHODS@
static void prepare(unsigned seed) {
    // Seed every pause combination, both queues, frame wrap and valid real pool entries
    seedValue=seed;entityCalls=0;active=&owners[seed&1];memset(active,0,sizeof(*active));
    memset(scripts,0,sizeof(scripts));
    pool.m_entries=(uint8_t *)scripts;pool.m_flags=poolFlags;pool.m_size=NUM_AUDIOENTITIES;
    pool.m_entrySize=sizeof(*scripts);pool.m_allocPtr=NUM_AUDIOENTITIES-1;
    active->m_bIsInitialised=(seed>>6)&1;active->m_bIsPaused=seed&1;
    active->m_bWasPaused=(seed>>1)&1;active->m_bIsSurround=(seed>>2)&1;
    active->m_FrameCounter=seed%7==0?UINT32_MAX:seed;
    active->m_bReduceReleasingPriority=seed%2;
    active->m_nActiveQueue=(seed>>3)&1;active->m_nActiveSamples=8;
    active->m_nAudioEntitiesCount=9;
    for(unsigned queue=0;queue<2;++queue) {
        active->m_nRequestedCount[queue]=3;
        for(unsigned i=0;i<NUM_CHANNELS_GENERIC;++i) {
            active->m_aRequestedOrderList[queue][i]=i;
            active->m_aRequestedQueue[queue][i].m_nSampleIndex=i+1;
        }
    }
    for(unsigned i=0;i<NUM_CHANNELS_GENERIC;++i) {
        active->m_asActiveSamples[i].m_nSampleIndex=i+10;
        active->m_asActiveSamples[i].m_fDistance=31.5f;
    }
    for(unsigned i=0;i<NUM_AUDIOENTITIES;++i) {
        active->m_aAudioEntityOrderList[i]=NUM_AUDIOENTITIES;
        active->m_asAudioEntities[i].m_bIsUsed=1;
        active->m_asAudioEntities[i].m_AudioEvents=i%4+1;
        scripts[i].AudioId=33;scripts[i].Posn={1,2,3};scripts[i].AudioEntity=i;
        poolFlags[i]=i&POOLFLAG_ID;
    }
    for(unsigned i=0;i<6;++i) active->m_aAudioEntityOrderList[i]=5-i;
    active->m_sAudioScriptObjectManager.m_nScriptObjectEntityTotal=seed%4;
    for(unsigned i=0;i<3;++i) {
        unsigned id=9+i*2;
        active->m_aAudioEntityOrderList[6+i]=id;
        active->m_asAudioEntities[id].m_pEntity=&scripts[id];
        active->m_sAudioScriptObjectManager.m_anScriptObjectEntityIndices[i]=id;
    }
    active->m_asAudioEntities[14].m_pEntity=(void *)(uintptr_t)0x123;
}
int main(void) {
    // Compare direct traversal, repeated service and C callers across both owner instances
    for(unsigned seed=0;seed<256;++seed) {
        prepare(seed);@INTERROGATE@;snapshot();++cases;
        prepare(seed);@SERVICE@;snapshot();++cases;
        @SERVICE@;snapshot();++cases;
        prepare(seed);@CALLER@;snapshot();++cases;
    }
    printf("%u cases %u callbacks : %llu\n",cases,callbacks,(unsigned long long)digest);
    return 0;
}
