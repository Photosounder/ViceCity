    CPager local;seed(local,false,0x21);Run_Pager_Init(&local);Run_Pager_AddMessage(&local,texts[2],33,7,19);assert(local.m_messages[0].m_pText==texts[2]&&local.m_messages[0].m_nCurrentPosition==-18);snapshot();
    printf("states=%u checks=%u lengths=%u expansions=%u briefs=%u displays=%u callbacks=%u hash=%016llx\n",states,checks,lengths,expansions,briefs,displays,callbacks,(unsigned long long)hashValue);
