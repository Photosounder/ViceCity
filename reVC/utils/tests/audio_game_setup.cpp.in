    static const int32_t randoms[]={0,1,-1,INT32_MIN,INT32_MAX,173};active->m_anRandomTable[0]=randoms[(seed/13)%6];active->m_nGlobalSfxVolumeMultiplier=17;active->m_bIsPlayerShutUp=1;active->m_nPlayerMood=PLAYER_MOOD_ANGRY;active->m_nPlayerMoodTimer=UINT32_MAX;
}
int main() {
    // Keep failures console-only on Windows
#ifdef _WIN32
    SetErrorMode(3);
#endif
    // Compare repeated live mutations and fresh seeded gates across every operation
    for(unsigned seed=0;seed<1024;++seed)for(unsigned mode=0;mode<5;++mode){prepare(seed,mode);run();observe();++cases;run();observe();++cases;prepare(seed,mode);mutations=0;run();observe();++cases;}
