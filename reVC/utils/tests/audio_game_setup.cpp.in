    seedValue=seed;mutations=1;operation=mode;memset(owners,0,sizeof(owners));memset(peds,0,sizeof(peds));active=&owners[seed&1];gFireManager=seed*17;static const uint32_t times[]={0,1,3000,INT32_MAX,UINT32_MAX-5,UINT32_MAX};now=times[(seed/7)%6];for(unsigned i=0;i<MAX_SFX_BANKS;++i)BankStartOffset[i]=0xabc00000u+i;
    for(unsigned i=0;i<4;++i){peds[i].index=i;peds[i].isPed=(seed+i)&1;peds[i].lastStart=seed;peds[i].soundStart=~seed;}
    active->m_bIsInitialised=(seed>>1)&1;static const unsigned counts[]={0,1,NUM_AUDIOENTITIES-10,NUM_AUDIOENTITIES-1,NUM_AUDIOENTITIES};unsigned count=counts[(seed/4)%5];active->m_nAudioEntitiesCount=count;
    for(unsigned i=0;i<NUM_AUDIOENTITIES;++i){tAudioEntity *entity=&active->m_asAudioEntities[i];entity->m_bIsUsed=i<count;entity->m_bStatus=(seed+i)&1;entity->m_nType=i%3==0?AUDIOTYPE_PHYSICAL:AUDIOTYPE_FRONTEND;entity->m_pEntity=i%3==0?&peds[i%4]:NULL;active->m_aAudioEntityOrderList[i]=i<count?i:NUM_AUDIOENTITIES;entity->m_afVolume[0]=(float)i;}
    // Seed valid queued references to free slots so the fixed allocator must preserve their IDs
    active->m_nActiveSamples=6;for(unsigned q=0;q<NUM_SOUND_QUEUES;++q){active->m_nRequestedCount[q]=seed%7;for(unsigned i=0;i<6;++i){active->m_aRequestedOrderList[q][i]=i;active->m_aRequestedQueue[q][i].m_nEntityIndex=(seed+i+q)%NUM_AUDIOENTITIES;}}
    // Exercise each live shutdown gate with negative, valid, aliased and out-of-range handles
    static const int32_t ids[]={AEHANDLE_NONE,-1,0,1,NUM_AUDIOENTITIES-1,NUM_AUDIOENTITIES,INT32_MAX};int32_t *handles[]={&active->m_nFireAudioEntity,&active->m_nCollisionEntity,&active->m_nFrontEndEntity,&active->m_nProjectileEntity,&active->m_nWaterCannonEntity,&active->m_nPoliceChannelEntity,&active->m_nEscalatorEntity,&active->m_nExtraSoundsEntity};for(unsigned i=0;i<8;++i)*handles[i]=ids[(seed/5+i)%7];
